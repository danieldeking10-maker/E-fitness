    "var_3532e94cf557": {
      "type": "variant",
      "label": "AI Wellness Companion - Chat",
      "parentId": "var_3c185f02d859",
      "themeId": null,
      "rect": {
        "x": 36960,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n  \n  .glass {\n    background: rgba(26, 29, 36, 0.4);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .chat-bubble-ai {\n    background: rgba(39, 39, 42, 0.6);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .chat-bubble-user {\n    background: #C0FF00;\n    color: #000000;\n    font-weight: 500;\n  }\n</style>\n\n<div class=\"h-screen flex flex-col overflow-hidden\" data-kid=\"1\">\n  \n  <header class=\"p-6 border-b border-white/5 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-4\" data-kid=\"3\">\n      <div class=\"h-10 w-10 bg-[#C0FF00] rounded-full flex items-center justify-center text-black font-bold\" data-kid=\"4\">AI</div>\n      <div data-kid=\"5\">\n        <div class=\"font-heading font-bold text-sm\" data-kid=\"6\">Wellness Companion</div>\n        <div class=\"flex items-center gap-1.5\" data-kid=\"7\">\n          <span class=\"h-1.5 w-1.5 bg-[#C0FF00] rounded-full animate-pulse\" data-kid=\"8\"></span>\n          <span class=\"text-[10px] text-[#C0FF00] font-bold uppercase tracking-widest\" data-kid=\"9\">Active Intelligence</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"flex gap-4\" data-kid=\"10\">\n      <button class=\"h-10 w-10 border border-white/10 rounded-full flex items-center justify-center text-zinc-500 hover:text-white transition-colors\" data-kid=\"11\"><i class=\"ti ti-settings\" data-kid=\"12\"></i></button>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 overflow-y-auto p-8 space-y-8\" data-kid=\"13\">\n    <div class=\"max-w-3xl mx-auto space-y-8\" data-kid=\"14\">\n      <div class=\"flex flex-col items-start max-w-[85%]\" data-kid=\"15\">\n        <div class=\"chat-bubble-ai p-5 rounded-3xl rounded-tl-none text-sm leading-relaxed\" data-kid=\"16\">\n          Hello! I've analyzed your workout from earlier. Your heart rate recovery was exceptionally fast (32bpm in 60s). This suggests your cardiovascular base is improving. \n        </div>\n        <span class=\"text-[10px] text-zinc-600 mt-2 ml-1 font-bold\" data-kid=\"17\">AI COMPANION • 14:20</span>\n      </div>\n\n      <div class=\"flex flex-col items-end max-w-[85%] ml-auto\" data-kid=\"18\">\n        <div class=\"chat-bubble-user p-5 rounded-3xl rounded-tr-none text-sm\" data-kid=\"19\">\n          That's great! Should I increase the intensity of tomorrow's session?\n        </div>\n        <span class=\"text-[10px] text-zinc-600 mt-2 mr-1 font-bold\" data-kid=\"20\">YOU • 14:21</span>\n      </div>\n\n      <div class=\"flex flex-col items-start max-w-[85%]\" data-kid=\"21\">\n        <div class=\"chat-bubble-ai p-5 rounded-3xl rounded-tl-none text-sm leading-relaxed\" data-kid=\"22\">\n          Based on your current fatigue markers, I recommend holding the intensity but adding one extra set to your primary lifts. This will continue to drive volume without risking overtraining.\n        </div>\n        <span class=\"text-[10px] text-zinc-600 mt-2 ml-1 font-bold\" data-kid=\"23\">AI COMPANION • 14:21</span>\n      </div>\n    </div>\n  </main>\n\n  \n  <footer class=\"p-8\" data-kid=\"24\">\n    <div class=\"max-w-3xl mx-auto space-y-6\" data-kid=\"25\">\n      <div class=\"flex gap-2 overflow-x-auto pb-2 scrollbar-hide\" data-kid=\"26\">\n        <button class=\"glass px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap hover:border-[#C0FF00]/40 transition-colors\" data-kid=\"27\">Recovery Tips</button>\n        <button class=\"glass px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap hover:border-[#C0FF00]/40 transition-colors\" data-kid=\"28\">Log Meal</button>\n        <button class=\"glass px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap hover:border-[#C0FF00]/40 transition-colors\" data-kid=\"29\">Form Check</button>\n        <button class=\"glass px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap hover:border-[#C0FF00]/40 transition-colors\" data-kid=\"30\">Soreness Protocol</button>\n      </div>\n      \n      <div class=\"relative\" data-kid=\"31\">\n        <input type=\"text\" placeholder=\"Message your companion...\" class=\"w-full bg-zinc-900/50 border border-white/10 rounded-2xl px-6 py-5 text-sm outline-none focus:border-[#C0FF00]/50 transition-colors\" data-kid=\"32\">\n        <div class=\"absolute right-3 top-1/2 -translate-y-1/2 flex gap-2\" data-kid=\"33\">\n           <button class=\"h-10 w-10 text-zinc-500 hover:text-white transition-colors\" data-kid=\"34\"><i class=\"ti ti-microphone text-xl\" data-kid=\"35\"></i></button>\n           <button class=\"h-10 w-10 bg-[#C0FF00] text-black rounded-xl flex items-center justify-center font-bold hover:scale-105 transition-transform\" data-kid=\"36\"><i class=\"ti ti-arrow-right text-xl\" data-kid=\"37\"></i></button>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>",
