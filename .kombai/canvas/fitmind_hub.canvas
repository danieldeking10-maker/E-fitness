      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  @layer base {\n    body {\n      margin: 0;\n      background-color: #0A0A0A;\n      color: #F4F4F5;\n      font-family: 'DM Sans', sans-serif;\n      overflow-x: clip;\n    }\n    h1, h2, h3, h4 {\n      font-family: 'Sora', sans-serif;\n    }\n  }\n\n  .text-chartreuse { color: #C0FF00; }\n  .bg-chartreuse { background-color: #C0FF00; }\n  .border-chartreuse { border-color: #C0FF00; }\n  .shadow-chartreuse { shadow-color: rgba(192, 255, 0, 0.4); }\n\n  .frosted-glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .lenis-progress {\n    position: fixed;\n    top: 0;\n    left: 0;\n    height: 4px;\n    background: #C0FF00;\n    width: 0%;\n    z-index: 100;\n  }\n</style>\n\n<div class=\"lenis-progress\" id=\"progress-bar\" data-kid=\"1\"></div>\n\n\n<nav class=\"fixed top-0 z-50 w-full px-8 py-6 flex justify-between items-center mix-blend-difference\" data-kid=\"2\">\n  <div class=\"flex items-center gap-2\" data-kid=\"3\">\n    <div class=\"w-8 h-8 bg-chartreuse rounded-full flex items-center justify-center\" data-kid=\"4\">\n      <i class=\"ti ti-activity text-black text-xl\" data-kid=\"5\"></i>\n    </div>\n    <span class=\"text-xl font-bold tracking-tighter text-white font-sora\" data-kid=\"6\">FITMIND</span>\n  </div>\n  <div class=\"hidden md:flex gap-8 text-sm font-medium text-white/80\" data-kid=\"7\">\n    <a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"8\">Features</a>\n    <a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"9\">Classes</a>\n    <a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"10\">Pricing</a>\n  </div>\n  <button class=\"px-6 py-2 bg-chartreuse text-black font-bold text-sm rounded-full hover:scale-105 transition-transform\" data-kid=\"11\">\n    GET STARTED\n  </button>\n</nav>\n\n\n<section class=\"relative min-h-screen flex overflow-hidden\" data-kid=\"12\">\n  \n  <div class=\"relative w-1/2 h-screen grayscale hover:grayscale-0 transition-all duration-700 overflow-hidden group border-r border-white/10\" data-kid=\"13\">\n    <img src=\"https://images.unsplash.com/photo-1552196527-bffef41ef674?auto=format&w=1200&q=80&fit=crop\" alt=\"Woman stretching by Dane Wetton on Unsplash\" class=\"absolute inset-0 w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-1000\" decoding=\"async\" loading=\"lazy\" data-kid=\"14\">\n    <div class=\"absolute inset-0 bg-black/60 flex flex-col justify-center px-12 lg:px-24\" data-kid=\"15\">\n      <span class=\"text-white/50 text-sm font-bold tracking-[0.3em] uppercase mb-4\" data-kid=\"16\">Without AI</span>\n      <h2 class=\"text-5xl lg:text-7xl font-bold text-white mb-6\" data-kid=\"17\">GUESSWORK & PLATEAUS.</h2>\n      <ul class=\"space-y-4 text-white/60\" data-kid=\"18\">\n        <li class=\"flex items-center gap-3\" data-kid=\"19\"><i class=\"ti ti-x text-red-500\" data-kid=\"20\"></i> Manual tracking overhead</li>\n        <li class=\"flex items-center gap-3\" data-kid=\"21\"><i class=\"ti ti-x text-red-500\" data-kid=\"22\"></i> Vague progress metrics</li>\n        <li class=\"flex items-center gap-3\" data-kid=\"23\"><i class=\"ti ti-x text-red-500\" data-kid=\"24\"></i> Generic workout plans</li>\n      </ul>\n    </div>\n  </div>\n\n  \n  <div class=\"relative w-1/2 h-screen overflow-hidden group\" data-kid=\"25\">\n    <img src=\"https://images.unsplash.com/photo-1517130038641-a774d04afb3c?auto=format&w=1200&q=80&fit=crop\" alt=\"Group training by Geert Pieters on Unsplash\" class=\"absolute inset-0 w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-1000\" decoding=\"async\" loading=\"lazy\" data-kid=\"26\">\n    <div class=\"absolute inset-0 bg-[#C0FF00]/10 backdrop-blur-[2px] pointer-events-none\" data-kid=\"27\"></div>\n    <div class=\"absolute inset-0 bg-black/40 flex flex-col justify-center px-12 lg:px-24\" data-kid=\"28\">\n      <span class=\"text-chartreuse text-sm font-bold tracking-[0.3em] uppercase mb-4\" data-kid=\"29\">With FitMind Hub</span>\n      <h2 class=\"text-5xl lg:text-7xl font-bold text-white mb-6\" data-kid=\"30\">DATA-DRIVEN PRECISION.</h2>\n      <ul class=\"space-y-4 text-white\" data-kid=\"31\">\n        <li class=\"flex items-center gap-3\" data-kid=\"32\"><i class=\"ti ti-check text-chartreuse\" data-kid=\"33\"></i> Real-time AI adjustments</li>\n        <li class=\"flex items-center gap-3\" data-kid=\"34\"><i class=\"ti ti-check text-chartreuse\" data-kid=\"35\"></i> 100% Personalised cycles</li>\n        <li class=\"flex items-center gap-3\" data-kid=\"36\"><i class=\"ti ti-check text-chartreuse\" data-kid=\"37\"></i> predictive recovery data</li>\n      </ul>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none\" data-kid=\"38\">\n    <div class=\"w-48 h-48 bg-chartreuse rounded-full flex items-center justify-center shadow-[0_0_80px_rgba(192,255,0,0.5)] animate-pulse pointer-events-auto cursor-pointer\" data-kid=\"39\">\n      <span class=\"text-black font-black text-center leading-tight\" data-kid=\"40\">THE<br data-kid=\"41\">FUTURE<br data-kid=\"42\">IS AI</span>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"relative bg-[#0A0A0A] py-24\" id=\"features\" data-kid=\"43\">\n  <div class=\"max-w-7xl mx-auto px-8 flex flex-col lg:flex-row gap-12 lg:gap-24 items-start\" data-kid=\"44\">\n    \n    <div class=\"lg:sticky lg:top-32 w-full lg:w-1/3 space-y-8\" data-kid=\"45\">\n      <span class=\"text-chartreuse font-bold tracking-widest uppercase\" data-kid=\"46\">The Core Engine</span>\n      <h2 class=\"text-5xl lg:text-6xl font-bold leading-tight\" data-kid=\"47\">HOW WE<br data-kid=\"48\">REDEFINE<br data-kid=\"49\">STRENGTH.</h2>\n      <p class=\"text-white/60 text-lg leading-relaxed\" data-kid=\"50\">\n        Our proprietary AI models analyze thousands of data points to ensure every rep brings you closer to your peak potential.\n      </p>\n      <div class=\"flex gap-4\" data-kid=\"51\">\n        <button class=\"w-12 h-12 border border-white/20 rounded-full flex items-center justify-center hover:bg-white hover:text-black transition-all\" data-kid=\"52\">\n          <i class=\"ti ti-arrow-left\" data-kid=\"53\"></i>\n        </button>\n        <button class=\"w-12 h-12 border border-white/20 rounded-full flex items-center justify-center hover:bg-white hover:text-black transition-all\" data-kid=\"54\">\n          <i class=\"ti ti-arrow-right\" data-kid=\"55\"></i>\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"w-full lg:w-2/3 space-y-24\" data-kid=\"56\">\n      \n      <div class=\"bg-[#1A1D24] p-12 rounded-[2rem] border border-white/5 reveal-card\" data-kid=\"57\">\n        <div class=\"flex items-center justify-between mb-8\" data-kid=\"58\">\n          <div class=\"w-16 h-16 bg-chartreuse/10 rounded-2xl flex items-center justify-center\" data-kid=\"59\">\n            <i class=\"ti ti-activity text-chartreuse text-3xl\" data-kid=\"60\"></i>\n          </div>\n          <span class=\"text-white/20 font-black text-6xl\" data-kid=\"61\">01</span>\n        </div>\n        <h3 class=\"text-3xl font-bold mb-6\" data-kid=\"62\">AI Wellness Assessment</h3>\n        <p class=\"text-white/60 text-lg mb-8 leading-relaxed\" data-kid=\"63\">\n          Forget generic questionnaires. Our multi-modal AI assesses posture, mobility, and metabolic indicators to build your digital twin.\n        </p>\n        <div class=\"relative rounded-2xl overflow-hidden border border-white/10 aspect-video\" data-kid=\"64\">\n           <video src=\"https://videos.pexels.com/video-files/4804847/4804847-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/4804847/pexels-photo-4804847.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" alt=\"Athlete preparing by Ketut Subiyanto on Pexels\" data-kid=\"65\"></video>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-[#1A1D24] p-12 rounded-[2rem] border border-white/5 reveal-card\" data-kid=\"66\">\n        <div class=\"flex items-center justify-between mb-8\" data-kid=\"67\">\n          <div class=\"w-16 h-16 bg-chartreuse/10 rounded-2xl flex items-center justify-center\" data-kid=\"68\">\n            <i class=\"ti ti-layout-2-filled text-chartreuse text-3xl\" data-kid=\"69\"></i>\n          </div>\n          <span class=\"text-white/20 font-black text-6xl\" data-kid=\"70\">02</span>\n        </div>\n        <h3 class=\"text-3xl font-bold mb-6\" data-kid=\"71\">Workout Generator</h3>\n        <p class=\"text-white/60 text-lg mb-8 leading-relaxed\" data-kid=\"72\">\n          Dynamic plans that adapt to your schedule, equipment access, and daily soreness levels. Real-time evolution.\n        </p>\n        <div class=\"frosted-glass p-8 rounded-2xl border border-chartreuse/20\" data-kid=\"73\">\n          <div class=\"flex justify-between items-center mb-6\" data-kid=\"74\">\n            <span class=\"font-bold\" data-kid=\"75\">YOUR MONDAY PEAK</span>\n            <span class=\"bg-chartreuse text-black text-xs font-black px-3 py-1 rounded-full uppercase\" data-kid=\"76\">Optimal</span>\n          </div>\n          <div class=\"space-y-4\" data-kid=\"77\">\n            <div class=\"flex items-center gap-4 bg-black/40 p-4 rounded-xl\" data-kid=\"78\">\n              <span class=\"w-8 h-8 rounded-full border border-chartreuse/40 flex items-center justify-center text-xs font-bold text-chartreuse\" data-kid=\"79\">1</span>\n              <div data-kid=\"80\">\n                <p class=\"text-sm font-bold\" data-kid=\"81\">Front Squats</p>\n                <p class=\"text-xs text-white/40\" data-kid=\"82\">4 Sets x 12 Reps • 60s Rest</p>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-4 bg-black/40 p-4 rounded-xl\" data-kid=\"83\">\n              <span class=\"w-8 h-8 rounded-full border border-chartreuse/40 flex items-center justify-center text-xs font-bold text-chartreuse\" data-kid=\"84\">2</span>\n              <div data-kid=\"85\">\n                <p class=\"text-sm font-bold\" data-kid=\"86\">Bulgarian Split Squats</p>\n                <p class=\"text-xs text-white/40\" data-kid=\"87\">3 Sets x 10 Reps • 45s Rest</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"relative py-24 bg-black overflow-hidden\" data-kid=\"88\">\n  \n  <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gooey-molecule.svg\" class=\"absolute top-0 right-0 w-[600px] opacity-5 -rotate-12 blur-3xl pointer-events-none\" style=\"color: #C0FF00;\" data-kid=\"89\">\n  \n  <div class=\"max-w-5xl mx-auto px-8 relative z-10\" data-kid=\"90\">\n    <div class=\"text-center mb-16\" data-kid=\"91\">\n      <h2 class=\"text-5xl font-bold mb-6\" data-kid=\"92\">YOUR COMPANION,<br data-kid=\"93\">ALWAYS ON.</h2>\n      <p class=\"text-white/60 max-w-xl mx-auto\" data-kid=\"94\">Recovery advice, habit tracking, and motivation delivered through our state-of-the-art conversational AI.</p>\n    </div>\n\n    \n    <div class=\"frosted-glass rounded-[2.5rem] overflow-hidden shadow-2xl\" data-kid=\"95\">\n      \n      <div class=\"p-6 border-b border-white/10 flex items-center gap-4 bg-white/5\" data-kid=\"96\">\n        <div class=\"w-12 h-12 bg-chartreuse rounded-full flex items-center justify-center ring-4 ring-chartreuse/20\" data-kid=\"97\">\n          <i class=\"ti ti-activity text-black text-xl\" data-kid=\"98\"></i>\n        </div>\n        <div data-kid=\"99\">\n          <p class=\"font-bold text-white\" data-kid=\"100\">AI Companion</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"101\">\n            <span class=\"w-2 h-2 bg-chartreuse rounded-full animate-pulse\" data-kid=\"102\"></span>\n            <span class=\"text-xs text-chartreuse font-bold\" data-kid=\"103\">Ready to assist</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-8 space-y-6 h-[400px] overflow-y-auto\" id=\"chat-container\" data-kid=\"104\">\n        \n        <div class=\"flex items-start gap-4\" data-kid=\"105\">\n          <div class=\"w-8 h-8 bg-chartreuse/20 rounded-full flex-shrink-0 flex items-center justify-center\" data-kid=\"106\">\n            <i class=\"ti ti-activity text-chartreuse text-sm\" data-kid=\"107\"></i>\n          </div>\n          <div class=\"bg-[#1A1D24] p-4 rounded-2xl rounded-tl-none text-sm max-w-[80%] border border-white/5\" data-kid=\"108\">\n            Hey! I noticed your sleep quality dropped last night. Should we dial down the intensity of today's leg session to favor recovery?\n          </div>\n        </div>\n        \n        <div class=\"flex items-start gap-4 flex-row-reverse\" data-kid=\"109\">\n          <div class=\"w-8 h-8 bg-white/10 rounded-full flex-shrink-0 flex items-center justify-center\" data-kid=\"110\">\n            <i class=\"ti ti-user text-white text-sm\" data-kid=\"111\"></i>\n          </div>\n          <div class=\"bg-chartreuse p-4 rounded-2xl rounded-tr-none text-sm max-w-[80%] text-black font-medium shadow-[0_4px_20px_rgba(192,255,0,0.2)]\" data-kid=\"112\">\n            Good catch. My knees are a bit sore too. Let's switch to a low-impact mobility and recovery flow instead.\n          </div>\n        </div>\n        \n        <div class=\"flex items-start gap-4 animate-pulse\" data-kid=\"113\">\n          <div class=\"w-8 h-8 bg-chartreuse/20 rounded-full flex-shrink-0 flex items-center justify-center\" data-kid=\"114\">\n            <i class=\"ti ti-activity text-chartreuse text-sm\" data-kid=\"115\"></i>\n          </div>\n          <div class=\"bg-[#1A1D24] p-4 rounded-2xl rounded-tl-none text-sm border border-white/5\" data-kid=\"116\">\n            Optimizing now. I've scheduled a 20min knee-focused mobility session. Ready when you are! ⚡️\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-6 bg-black/40 border-t border-white/10 flex gap-4\" data-kid=\"117\">\n        <input type=\"text\" placeholder=\"Ask about recovery, habits...\" class=\"flex-1 bg-[#1A1D24] border border-white/10 rounded-full px-6 py-3 text-sm focus:outline-none focus:border-chartreuse transition-colors\" data-kid=\"118\">\n        <button class=\"w-12 h-12 bg-chartreuse text-black rounded-full flex items-center justify-center hover:scale-105 transition-transform\" data-kid=\"119\">\n          <i class=\"ti ti-send\" data-kid=\"120\"></i>\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"bg-[#1A1D24] pt-24 pb-12 border-t border-white/5\" data-kid=\"121\">\n  <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"122\">\n    <div class=\"grid md:grid-cols-4 gap-12 mb-24\" data-kid=\"123\">\n      <div class=\"col-span-2 space-y-8\" data-kid=\"124\">\n        <div class=\"flex items-center gap-2\" data-kid=\"125\">\n          <div class=\"w-8 h-8 bg-chartreuse rounded-full flex items-center justify-center\" data-kid=\"126\">\n            <i class=\"ti ti-activity text-black text-xl\" data-kid=\"127\"></i>\n          </div>\n          <span class=\"text-2xl font-bold tracking-tighter text-white font-sora\" data-kid=\"128\">FITMIND</span>\n        </div>\n        <p class=\"text-white/40 max-w-sm text-lg\" data-kid=\"129\">\n          The world's most advanced AI fitness ecosystem. Motivating you to reach the impossible.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"130\">\n          <a href=\"#\" class=\"w-10 h-10 bg-white/5 rounded-full flex items-center justify-center hover:bg-chartreuse hover:text-black transition-all\" data-kid=\"131\">\n            <i class=\"ti ti-brand-instagram\" data-kid=\"132\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 bg-white/5 rounded-full flex items-center justify-center hover:bg-chartreuse hover:text-black transition-all\" data-kid=\"133\">\n            <i class=\"ti ti-brand-x\" data-kid=\"134\"></i>\n          </a>\n        </div>\n      </div>\n\n      <div data-kid=\"135\">\n        <h4 class=\"font-bold text-white mb-6 uppercase tracking-widest text-sm\" data-kid=\"136\">Platform</h4>\n        <ul class=\"space-y-4 text-white/60 text-sm\" data-kid=\"137\">\n          <li data-kid=\"138\"><a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"139\">AI Assessment</a></li>\n          <li data-kid=\"140\"><a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"141\">Workout Engine</a></li>\n          <li data-kid=\"142\"><a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"143\">Live Classes</a></li>\n          <li data-kid=\"144\"><a href=\"#\" class=\"hover:text-chartreuse transition-colors\" data-kid=\"145\">Mobile Payments</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"146\">\n        <h4 class=\"font-bold text-white mb-6 uppercase tracking-widest text-sm\" data-kid=\"147\">Payments</h4>\n        <div class=\"flex flex-wrap gap-4 items-center\" data-kid=\"148\">\n          <div class=\"flex items-center gap-2 bg-black/40 px-4 py-2 rounded-lg border border-white/5\" data-kid=\"149\">\n            <i class=\"ti ti-device-mobile-dollar text-chartreuse\" data-kid=\"150\"></i>\n            <span class=\"text-[10px] font-bold text-white/60 tracking-tighter\" data-kid=\"151\">MOBILE MONEY</span>\n          </div>\n          <div class=\"flex items-center gap-2 bg-black/40 px-4 py-2 rounded-lg border border-white/5\" data-kid=\"152\">\n            <i class=\"ti ti-transaction-rupee text-chartreuse\" data-kid=\"153\"></i>\n            <span class=\"text-[10px] font-bold text-white/60 tracking-tighter\" data-kid=\"154\">LOCAL PAY</span>\n          </div>\n        </div>\n        <p class=\"mt-4 text-xs text-white/30 leading-relaxed\" data-kid=\"155\">\n          Integrated with top local mobile wallets for seamless, secure transactions.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/20\" data-kid=\"156\">\n      <p data-kid=\"157\">© 2026 FITMIND HUB. BUILT FOR PEAK PERFORMANCE.</p>\n      <div class=\"flex gap-6\" data-kid=\"158\">\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"159\">Privacy Policy</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"160\">Terms of Service</a>\n      </div>\n    </div>\n  </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"161\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"162\"></script>\n<script type=\"module\" data-kid=\"163\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n\n  // Initialize Lenis\n  const lenis = new Lenis({\n    autoRaf: true,\n  });\n\n  lenis.on('scroll', (e) => {\n    ScrollTrigger.update();\n    const progress = (e.animatedScroll / e.limit) * 100;\n    document.getElementById('progress-bar').style.width = `${progress}%`;\n  });\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Parallax Hero\n  gsap.utils.toArray('section img').forEach((img, i) => {\n    gsap.to(img, {\n      yPercent: 10,\n      ease: 'none',\n      scrollTrigger: {\n        trigger: img.parentElement,\n        start: 'top bottom',\n        end: 'bottom top',\n        scrub: true\n      }\n    });\n  });\n\n  // Reveal Cards\n  gsap.utils.toArray('.reveal-card').forEach((card) => {\n    gsap.from(card, {\n      y: 100,\n      opacity: 0,\n      duration: 1,\n      ease: 'power4.out',\n      scrollTrigger: {\n        trigger: card,\n        start: 'top 90%',\n        toggleActions: 'play none none reverse'\n      }\n    });\n  });\n\n  // Split Comparison Reveal\n  gsap.from('h2', {\n    y: 50,\n    opacity: 0,\n    stagger: 0.1,\n    duration: 1,\n    ease: 'power3.out',\n    scrollTrigger: {\n      trigger: 'section',\n      start: 'top 80%'\n    }\n  });\n\n</script>",
