    "var_29fbc1d49cd9": {
      "type": "variant",
      "label": "AI Wellness Assessment - Multi-step",
      "parentId": "var_3c185f02d859",
      "themeId": null,
      "rect": {
        "x": 33880,
        "y": 0,
        "w": 1440,
        "h": 800
