      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --bg-ink: #0A0A0A;\n    --bg-slate: #1A1D24;\n    --accent-neon: #C0FF00;\n  }\n\n  body {\n    background-color: var(--bg-ink);\n    color: #F4F4F5;\n    font-family: 'DM Sans', sans-serif;\n    margin: 0;\n    overflow-x: clip; /* Required for sticky to work with Lenis */\n  }\n\n  h1, h2, h3, .font-sora {\n    font-family: 'Sora', sans-serif;\n  }\n\n  .text-neon { color: var(--accent-neon); }\n  .bg-neon { background-color: var(--accent-neon); }\n  .border-neon { border-color: var(--accent-neon); }\n\n  .frosted-glass {\n    background: rgba(26, 29, 36, 0.4);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .bento-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    grid-template-rows: repeat(3, 200px);\n    gap: 1.5rem;\n  }\n\n  /* Custom Scrollbar for Carousel */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .lenis.lenis-smooth {\n    height: auto;\n  }\n\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    \n    \n    <nav class=\"fixed top-0 left-0 w-full z-50 px-8 py-6 flex justify-between items-center bg-gradient-to-b from-black/80 to-transparent\" data-kid=\"3\">\n      <div class=\"flex items-center gap-2\" data-kid=\"4\">\n        <div class=\"w-8 h-8 bg-neon rounded-lg flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-activity text-black text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"font-sora font-bold text-xl tracking-tight\" data-kid=\"7\">FitMind <span class=\"text-neon\" data-kid=\"8\">Hub</span></span>\n      </div>\n      <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400\" data-kid=\"9\">\n        <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"10\">Assessment</a>\n        <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"11\">Workouts</a>\n        <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"12\">Companion</a>\n        <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"13\">Sessions</a>\n      </div>\n      <button class=\"bg-neon text-black px-6 py-2.5 rounded-full font-bold text-sm hover:scale-105 transition-transform\" data-kid=\"14\">\n        Get Started\n      </button>\n    </nav>\n\n    \n    <header class=\"pt-32 pb-20 px-8 max-w-7xl mx-auto\" data-kid=\"15\">\n      <div class=\"bento-grid\" data-kid=\"16\">\n        \n        <div class=\"bento-cell col-span-2 row-span-2 bg-slate-900 rounded-[2.5rem] p-12 flex flex-col justify-between relative overflow-hidden group border border-zinc-800/50\" data-kid=\"17\">\n          <div class=\"relative z-10\" data-kid=\"18\">\n            <span class=\"inline-block px-3 py-1 rounded-full bg-neon/10 text-neon text-xs font-bold uppercase tracking-widest mb-6\" data-kid=\"19\">AI-Powered Transformation</span>\n            <h1 class=\"text-6xl font-bold leading-[1.1] mb-6\" data-kid=\"20\">Master your body with <span class=\"text-neon\" data-kid=\"21\">Intelligent</span> Coaching.</h1>\n            <p class=\"text-zinc-400 text-lg max-w-md leading-relaxed\" data-kid=\"22\">Personalized wellness assessments and workout generation powered by next-gen AI.</p>\n          </div>\n          <div class=\"relative z-10 mt-12 flex gap-4\" data-kid=\"23\">\n            <button class=\"bg-neon text-black px-8 py-4 rounded-2xl font-bold flex items-center gap-2 group-hover:bg-lime-300 transition-colors\" data-kid=\"24\">\n              Start Assessment <i class=\"ti ti-arrow-right\" data-kid=\"25\"></i>\n            </button>\n          </div>\n          \n          <div class=\"absolute -bottom-20 -right-20 w-80 h-80 bg-neon/10 blur-[100px] rounded-full\" data-kid=\"26\"></div>\n        </div>\n\n        \n        <div class=\"bento-cell col-span-1 row-span-1 frosted-glass rounded-[2rem] p-6 flex flex-col justify-between border border-zinc-800/50\" data-kid=\"27\">\n          <div class=\"flex justify-between items-start\" data-kid=\"28\">\n            <i class=\"ti ti-activity text-neon text-2xl\" data-kid=\"29\"></i>\n            <span class=\"text-xs text-zinc-500 font-bold uppercase\" data-kid=\"30\">Live Stats</span>\n          </div>\n          <div data-kid=\"31\">\n            <div class=\"text-3xl font-bold\" data-kid=\"32\">142<span class=\"text-sm text-neon ml-1\" data-kid=\"33\">bpm</span></div>\n            <p class=\"text-xs text-zinc-400 mt-1\" data-kid=\"34\">Peak Intensity Reached</p>\n          </div>\n        </div>\n\n        \n        <div class=\"bento-cell col-span-1 row-span-2 bg-zinc-900 rounded-[2rem] overflow-hidden relative border border-zinc-800/50\" data-kid=\"35\">\n          <video src=\"https://videos.pexels.com/video-files/4804847/4804847-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/4804847/pexels-photo-4804847.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"36\"></video>\n          <div class=\"absolute bottom-6 left-6 z-10\" data-kid=\"37\">\n            <div class=\"flex items-center gap-2 bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10\" data-kid=\"38\">\n              <div class=\"w-2 h-2 bg-red-500 rounded-full animate-pulse\" data-kid=\"39\"></div>\n              <span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"40\">Live Session</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bento-cell col-span-1 row-span-1 bg-slate rounded-[2rem] p-6 border border-zinc-800/50\" data-kid=\"41\">\n          <div class=\"text-xs text-zinc-500 font-bold uppercase mb-4 tracking-wider\" data-kid=\"42\">Upcoming</div>\n          <div class=\"space-y-3\" data-kid=\"43\">\n            <div class=\"flex items-center gap-3\" data-kid=\"44\">\n              <div class=\"w-1 h-8 bg-neon rounded-full\" data-kid=\"45\"></div>\n              <div data-kid=\"46\">\n                <div class=\"text-sm font-bold\" data-kid=\"47\">HIIT Blast</div>\n                <div class=\"text-[10px] text-zinc-500\" data-kid=\"48\">10:00 AM • Coach Alex</div>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 opacity-50\" data-kid=\"49\">\n              <div class=\"w-1 h-8 bg-zinc-700 rounded-full\" data-kid=\"50\"></div>\n              <div data-kid=\"51\">\n                <div class=\"text-sm font-bold\" data-kid=\"52\">Zen Flow</div>\n                <div class=\"text-[10px] text-zinc-500\" data-kid=\"53\">12:30 PM • Coach Sarah</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bento-cell col-span-2 row-span-1 bg-zinc-900 rounded-[2rem] p-8 flex items-center justify-between border border-zinc-800/50\" data-kid=\"54\">\n          <div class=\"flex gap-8\" data-kid=\"55\">\n            <div class=\"text-center\" data-kid=\"56\">\n              <div class=\"text-2xl font-bold\" data-kid=\"57\">98%</div>\n              <div class=\"text-[10px] text-zinc-500 uppercase font-bold mt-1\" data-kid=\"58\">AI Accuracy</div>\n            </div>\n            <div class=\"text-center\" data-kid=\"59\">\n              <div class=\"text-2xl font-bold\" data-kid=\"60\">2.4k</div>\n              <div class=\"text-[10px] text-zinc-500 uppercase font-bold mt-1\" data-kid=\"61\">Workouts Gen</div>\n            </div>\n          </div>\n          <div class=\"flex -space-x-3\" data-kid=\"62\">\n            <img src=\"https://i.pravatar.cc/100?u=1\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-zinc-900\" decoding=\"async\" loading=\"lazy\" data-kid=\"63\">\n            <img src=\"https://i.pravatar.cc/100?u=2\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-zinc-900\" decoding=\"async\" loading=\"lazy\" data-kid=\"64\">\n            <img src=\"https://i.pravatar.cc/100?u=3\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-zinc-900\" decoding=\"async\" loading=\"lazy\" data-kid=\"65\">\n            <div class=\"w-10 h-10 rounded-full bg-zinc-800 border-2 border-zinc-900 flex items-center justify-center text-[10px] font-bold text-zinc-400\" data-kid=\"66\">+12k</div>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    \n    <section class=\"max-w-7xl mx-auto px-8 py-40 grid grid-cols-1 lg:grid-cols-2 gap-20\" data-kid=\"67\">\n      <div class=\"lg:sticky lg:top-40 h-fit\" data-kid=\"68\">\n        <span class=\"text-neon text-sm font-bold uppercase tracking-[0.3em]\" data-kid=\"69\">Core Technology</span>\n        <h2 class=\"text-5xl font-bold mt-6 mb-8 leading-tight\" data-kid=\"70\">Your Personal <br data-kid=\"71\"><span class=\"text-neon\" data-kid=\"72\">AI Wellness</span> Engine.</h2>\n        <p class=\"text-zinc-400 text-lg max-w-md leading-relaxed mb-10\" data-kid=\"73\">\n          We combine behavioral science with advanced LLMs to create a fitness ecosystem that actually adapts to your life.\n        </p>\n        <div class=\"flex items-center gap-4 py-4 border-t border-zinc-800\" data-kid=\"74\">\n          <div class=\"w-12 h-12 rounded-2xl bg-zinc-900 flex items-center justify-center border border-zinc-800\" data-kid=\"75\">\n            <i class=\"ti ti-brain text-neon text-xl\" data-kid=\"76\"></i>\n          </div>\n          <div data-kid=\"77\">\n            <h4 class=\"font-bold text-sm\" data-kid=\"78\">Context-Aware Generation</h4>\n            <p class=\"text-xs text-zinc-500\" data-kid=\"79\">Adapts to injuries, gear, and time.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"space-y-12\" data-kid=\"80\">\n        \n        <div class=\"feature-card reveal-up p-10 bg-zinc-900/50 rounded-[3rem] border border-zinc-800/50 group hover:border-neon/30 transition-all duration-500\" data-kid=\"81\">\n          <div class=\"w-14 h-14 bg-neon/10 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-neon transition-colors duration-500\" data-kid=\"82\">\n            <i class=\"ti ti-clipboard-check text-neon text-2xl group-hover:text-black transition-colors duration-500\" data-kid=\"83\"></i>\n          </div>\n          <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"84\">Wellness Assessment</h3>\n          <p class=\"text-zinc-400 leading-relaxed mb-8\" data-kid=\"85\">Comprehensive analysis of your physical state, mental load, and recovery needs. We don't just ask about your goals; we map your constraints.</p>\n          <div class=\"p-6 bg-black/40 rounded-2xl border border-white/5 font-mono text-xs text-zinc-500\" data-kid=\"86\">\n            <div class=\"flex justify-between mb-2\" data-kid=\"87\"><span data-kid=\"88\">Mobility Score</span> <span class=\"text-neon\" data-kid=\"89\">84/100</span></div>\n            <div class=\"w-full bg-zinc-800 h-1.5 rounded-full overflow-hidden\" data-kid=\"90\">\n              <div class=\"bg-neon h-full w-[84%]\" data-kid=\"91\"></div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"feature-card reveal-up p-10 bg-zinc-900/50 rounded-[3rem] border border-zinc-800/50 group hover:border-neon/30 transition-all duration-500\" data-kid=\"92\">\n          <div class=\"w-14 h-14 bg-neon/10 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-neon transition-colors duration-500\" data-kid=\"93\">\n            <i class=\"ti ti-swords text-neon text-2xl group-hover:text-black transition-colors duration-500\" data-kid=\"94\"></i>\n          </div>\n          <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"95\">AI Workout Generator</h3>\n          <p class=\"text-zinc-400 leading-relaxed mb-8\" data-kid=\"96\">Instant, tailored workout plans based on your current location, available equipment, and time window. Fresh routines every single day.</p>\n          <div class=\"grid grid-cols-3 gap-2\" data-kid=\"97\">\n            <div class=\"aspect-square bg-zinc-800/50 rounded-xl flex flex-col items-center justify-center p-2 text-center\" data-kid=\"98\">\n              <div class=\"text-neon font-bold text-lg\" data-kid=\"99\">20</div>\n              <div class=\"text-[8px] uppercase font-bold text-zinc-500\" data-kid=\"100\">Mins</div>\n            </div>\n            <div class=\"aspect-square bg-zinc-800/50 rounded-xl flex flex-col items-center justify-center p-2 text-center\" data-kid=\"101\">\n              <div class=\"text-neon font-bold text-lg\" data-kid=\"102\">HIIT</div>\n              <div class=\"text-[8px] uppercase font-bold text-zinc-500\" data-kid=\"103\">Style</div>\n            </div>\n            <div class=\"aspect-square bg-neon rounded-xl flex flex-col items-center justify-center p-2 text-center text-black\" data-kid=\"104\">\n              <i class=\"ti ti-player-play-filled\" data-kid=\"105\"></i>\n              <div class=\"text-[8px] uppercase font-bold\" data-kid=\"106\">Go</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-zinc-950 relative overflow-hidden\" data-kid=\"107\">\n      \n      <div class=\"absolute top-0 left-0 w-full h-full opacity-30 pointer-events-none\" data-kid=\"108\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gooey-molecule.svg\" style=\"color: #C0FF00;\" class=\"absolute -top-20 -left-20 w-[40rem] blur-3xl opacity-20\" data-kid=\"109\">\n      </div>\n\n      <div class=\"max-w-4xl mx-auto px-8 relative z-10 text-center mb-16\" data-kid=\"110\">\n        <h2 class=\"text-4xl font-bold mb-6\" data-kid=\"111\">Meet your <span class=\"text-neon\" data-kid=\"112\">Wellness Companion</span>.</h2>\n        <p class=\"text-zinc-400 text-lg\" data-kid=\"113\">24/7 support for recovery, nutrition, and habit building.</p>\n      </div>\n\n      <div class=\"max-w-3xl mx-auto px-8 relative z-10\" data-kid=\"114\">\n        <div class=\"frosted-glass rounded-[3rem] p-8 border border-white/10 shadow-2xl\" data-kid=\"115\">\n          \n          <div class=\"space-y-6 mb-8 max-h-[400px] overflow-y-auto pr-4 hide-scrollbar\" id=\"chat-container\" data-kid=\"116\">\n            \n            <div class=\"flex justify-end reveal-chat\" data-kid=\"117\">\n              <div class=\"bg-neon text-black px-6 py-4 rounded-[2rem] rounded-tr-none max-w-[80%] font-medium shadow-lg shadow-neon/10\" data-kid=\"118\">\n                I'm feeling some knee soreness after yesterday's leg day. Should I skip today?\n              </div>\n            </div>\n            \n            <div class=\"flex justify-start reveal-chat\" data-kid=\"119\">\n              <div class=\"bg-zinc-800/80 text-white px-6 py-4 rounded-[2rem] rounded-tl-none max-w-[80%] border border-white/5\" data-kid=\"120\">\n                <div class=\"flex items-center gap-2 mb-2\" data-kid=\"121\">\n                  <div class=\"w-5 h-5 bg-neon rounded-full flex items-center justify-center\" data-kid=\"122\"><i class=\"ti ti-activity text-[10px] text-black\" data-kid=\"123\"></i></div>\n                  <span class=\"text-[10px] uppercase font-bold text-neon tracking-wider\" data-kid=\"124\">FitMind AI</span>\n                </div>\n                Don't skip! Let's pivot to a low-impact mobility flow. Avoid squats and focus on hip flexor release. I've updated your daily plan with a 15-minute restorative session. How does that sound?\n              </div>\n            </div>\n            \n            <div class=\"flex justify-end reveal-chat\" data-kid=\"125\">\n              <div class=\"bg-neon text-black px-6 py-4 rounded-[2rem] rounded-tr-none max-w-[80%] font-medium shadow-lg shadow-neon/10\" data-kid=\"126\">\n                That sounds perfect. Let's do it!\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"relative\" data-kid=\"127\">\n            <div class=\"w-full bg-black/40 border border-white/10 rounded-2xl py-4 px-6 text-zinc-500 text-sm flex justify-between items-center italic\" data-kid=\"128\">\n              Type your question here...\n              <div class=\"flex gap-2\" data-kid=\"129\">\n                <i class=\"ti ti-microphone text-lg\" data-kid=\"130\"></i>\n                <i class=\"ti ti-send text-neon text-lg\" data-kid=\"131\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-40 bg-ink overflow-hidden\" data-kid=\"132\">\n      <div class=\"max-w-7xl mx-auto px-8 mb-12 flex justify-between items-end\" data-kid=\"133\">\n        <div data-kid=\"134\">\n          <span class=\"text-neon text-xs font-bold uppercase tracking-[0.3em]\" data-kid=\"135\">Live & Recorded</span>\n          <h2 class=\"text-4xl font-bold mt-4\" data-kid=\"136\">Masterclass Library</h2>\n        </div>\n        <div class=\"flex gap-3\" data-kid=\"137\">\n          <button id=\"prev-btn\" class=\"w-12 h-12 rounded-full border border-zinc-800 flex items-center justify-center hover:bg-zinc-900 transition-colors\" data-kid=\"138\"><i class=\"ti ti-chevron-left\" data-kid=\"139\"></i></button>\n          <button id=\"next-btn\" class=\"w-12 h-12 rounded-full border border-zinc-800 flex items-center justify-center hover:bg-zinc-900 transition-colors\" data-kid=\"140\"><i class=\"ti ti-chevron-right\" data-kid=\"141\"></i></button>\n        </div>\n      </div>\n\n      <div class=\"flex gap-8 overflow-x-auto px-[10%] hide-scrollbar snap-x snap-mandatory\" id=\"carousel\" data-kid=\"142\">\n        \n        <div class=\"min-w-[400px] snap-center group\" data-kid=\"143\">\n          <div class=\"aspect-[16/10] bg-zinc-900 rounded-[2rem] overflow-hidden relative border border-white/5 mb-6\" data-kid=\"144\">\n            <img src=\"https://images.unsplash.com/photo-1599447332412-6bc6830c815a?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"Stretching session\" decoding=\"async\" loading=\"lazy\" data-kid=\"145\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"146\"></div>\n            <div class=\"absolute top-6 right-6\" data-kid=\"147\">\n              <span class=\"bg-red-500 text-[10px] font-bold uppercase px-2 py-1 rounded\" data-kid=\"148\">Live</span>\n            </div>\n          </div>\n          <h4 class=\"text-xl font-bold\" data-kid=\"149\">Advanced Mobility Flow</h4>\n          <p class=\"text-zinc-500 text-sm mt-2\" data-kid=\"150\">Coach Emily • 45 Minutes</p>\n        </div>\n        \n        <div class=\"min-w-[400px] snap-center group\" data-kid=\"151\">\n          <div class=\"aspect-[16/10] bg-zinc-900 rounded-[2rem] overflow-hidden relative border border-white/5 mb-6\" data-kid=\"152\">\n            <img src=\"https://images.unsplash.com/photo-1517130038641-a774d04afb3c?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"HIIT session\" decoding=\"async\" loading=\"lazy\" data-kid=\"153\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"154\"></div>\n            <div class=\"absolute top-6 right-6\" data-kid=\"155\">\n              <span class=\"bg-zinc-800 text-[10px] font-bold uppercase px-2 py-1 rounded\" data-kid=\"156\">Recorded</span>\n            </div>\n          </div>\n          <h4 class=\"text-xl font-bold\" data-kid=\"157\">High Intensity Strength</h4>\n          <p class=\"text-zinc-500 text-sm mt-2\" data-kid=\"158\">Coach Marcus • 30 Minutes</p>\n        </div>\n        \n        <div class=\"min-w-[400px] snap-center group\" data-kid=\"159\">\n          <div class=\"aspect-[16/10] bg-zinc-900 rounded-[2rem] overflow-hidden relative border border-white/5 mb-6\" data-kid=\"160\">\n            <img src=\"https://images.unsplash.com/photo-1552196527-bffef41ef674?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"Yoga session\" decoding=\"async\" loading=\"lazy\" data-kid=\"161\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"162\"></div>\n          </div>\n          <h4 class=\"text-xl font-bold\" data-kid=\"163\">Morning Breathwork</h4>\n          <p class=\"text-zinc-500 text-sm mt-2\" data-kid=\"164\">Coach Li • 20 Minutes</p>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-40 max-w-7xl mx-auto px-8\" data-kid=\"165\">\n      <div class=\"text-center mb-20\" data-kid=\"166\">\n        <h2 class=\"text-5xl font-bold mb-6\" data-kid=\"167\">Ready to <span class=\"text-neon\" data-kid=\"168\">Commit</span>?</h2>\n        <p class=\"text-zinc-400\" data-kid=\"169\">Simple pricing for life-changing habits.</p>\n      </div>\n\n      <div class=\"flex flex-col lg:flex-row items-end justify-center gap-6\" data-kid=\"170\">\n        \n        <div class=\"w-full lg:w-72 bg-zinc-900 border border-zinc-800 p-8 rounded-[2.5rem] h-[400px] flex flex-col justify-between reveal-up\" style=\"transition-delay: 0.1s\" data-kid=\"171\">\n          <div data-kid=\"172\">\n            <div class=\"text-zinc-500 text-xs font-bold uppercase mb-4 tracking-widest\" data-kid=\"173\">Base</div>\n            <div class=\"text-3xl font-bold\" data-kid=\"174\">$0<span class=\"text-sm font-normal text-zinc-500\" data-kid=\"175\">/mo</span></div>\n            <ul class=\"mt-8 space-y-4 text-sm text-zinc-400\" data-kid=\"176\">\n              <li class=\"flex items-center gap-2\" data-kid=\"177\"><i class=\"ti ti-check text-neon\" data-kid=\"178\"></i> Daily AI Assessment</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"179\"><i class=\"ti ti-check text-neon\" data-kid=\"180\"></i> 3 Gen Workouts/mo</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-3 rounded-2xl border border-zinc-700 text-sm font-bold hover:bg-zinc-800 transition-colors\" data-kid=\"181\">Free Forever</button>\n        </div>\n\n        \n        <div class=\"w-full lg:w-80 bg-zinc-900 border border-zinc-800 p-8 rounded-[2.5rem] h-[480px] flex flex-col justify-between reveal-up\" style=\"transition-delay: 0.2s\" data-kid=\"182\">\n          <div data-kid=\"183\">\n            <div class=\"text-zinc-500 text-xs font-bold uppercase mb-4 tracking-widest\" data-kid=\"184\">Standard</div>\n            <div class=\"text-3xl font-bold\" data-kid=\"185\">$12<span class=\"text-sm font-normal text-zinc-500\" data-kid=\"186\">/mo</span></div>\n            <ul class=\"mt-8 space-y-4 text-sm text-zinc-400\" data-kid=\"187\">\n              <li class=\"flex items-center gap-2\" data-kid=\"188\"><i class=\"ti ti-check text-neon\" data-kid=\"189\"></i> Unlimited Gen Workouts</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"190\"><i class=\"ti ti-check text-neon\" data-kid=\"191\"></i> AI Companion Chat</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"192\"><i class=\"ti ti-check text-neon\" data-kid=\"193\"></i> Weekly Progress Analytics</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-3 rounded-2xl border border-zinc-700 text-sm font-bold hover:bg-zinc-800 transition-colors\" data-kid=\"194\">Start Trial</button>\n        </div>\n\n        \n        <div class=\"w-full lg:w-96 bg-neon border border-neon p-10 rounded-[2.5rem] h-[580px] flex flex-col justify-between relative shadow-2xl shadow-neon/20 reveal-up\" style=\"transition-delay: 0.3s\" data-kid=\"195\">\n          <div class=\"absolute -top-4 right-10 bg-black text-white px-4 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest\" data-kid=\"196\">Elite Choice</div>\n          <div class=\"text-black\" data-kid=\"197\">\n            <div class=\"text-black/50 text-xs font-bold uppercase mb-4 tracking-widest\" data-kid=\"198\">Ultimate</div>\n            <div class=\"text-5xl font-bold\" data-kid=\"199\">$29<span class=\"text-lg font-normal text-black/50\" data-kid=\"200\">/mo</span></div>\n            <ul class=\"mt-12 space-y-6 text-sm font-medium text-black/80\" data-kid=\"201\">\n              <li class=\"flex items-center gap-3\" data-kid=\"202\"><i class=\"ti ti-check-double text-lg\" data-kid=\"203\"></i> All AI Generator Features</li>\n              <li class=\"flex items-center gap-3\" data-kid=\"204\"><i class=\"ti ti-check-double text-lg\" data-kid=\"205\"></i> Unlimited Live Sessions</li>\n              <li class=\"flex items-center gap-3\" data-kid=\"206\"><i class=\"ti ti-check-double text-lg\" data-kid=\"207\"></i> 1-on-1 AI Strategy Calls</li>\n              <li class=\"flex items-center gap-3\" data-kid=\"208\"><i class=\"ti ti-check-double text-lg\" data-kid=\"209\"></i> Personalized Nutrition AI</li>\n            </ul>\n          </div>\n          <div class=\"mt-auto\" data-kid=\"210\">\n            <p class=\"text-[10px] text-black/60 font-bold uppercase mb-4 tracking-widest flex items-center gap-2\" data-kid=\"211\">\n              <i class=\"ti ti-smartphone-payment text-lg\" data-kid=\"212\"></i> Pay with Mobile Money\n            </p>\n            <button class=\"w-full py-4 rounded-2xl bg-black text-white font-bold hover:scale-[1.02] transition-transform\" data-kid=\"213\">Unlock Elite Access</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-20 px-8 border-t border-zinc-900 bg-black\" data-kid=\"214\">\n      <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12\" data-kid=\"215\">\n        <div data-kid=\"216\">\n          <div class=\"flex items-center gap-2 mb-6\" data-kid=\"217\">\n            <div class=\"w-6 h-6 bg-neon rounded flex items-center justify-center\" data-kid=\"218\">\n              <i class=\"ti ti-activity text-black text-xs\" data-kid=\"219\"></i>\n            </div>\n            <span class=\"font-sora font-bold text-lg tracking-tight\" data-kid=\"220\">FitMind <span class=\"text-neon\" data-kid=\"221\">Hub</span></span>\n          </div>\n          <p class=\"text-zinc-500 text-sm max-w-xs mb-8 italic\" data-kid=\"222\">\"The only way to predict the future is to generate it.\" — FitMind AI</p>\n          <div class=\"flex gap-4\" data-kid=\"223\">\n            <a href=\"#\" class=\"w-8 h-8 bg-zinc-900 rounded-full flex items-center justify-center text-zinc-400 hover:text-neon transition-colors\" data-kid=\"224\"><i class=\"ti ti-brand-x\" data-kid=\"225\"></i></a>\n            <a href=\"#\" class=\"w-8 h-8 bg-zinc-900 rounded-full flex items-center justify-center text-zinc-400 hover:text-neon transition-colors\" data-kid=\"226\"><i class=\"ti ti-brand-instagram\" data-kid=\"227\"></i></a>\n            <a href=\"#\" class=\"w-8 h-8 bg-zinc-900 rounded-full flex items-center justify-center text-zinc-400 hover:text-neon transition-colors\" data-kid=\"228\"><i class=\"ti ti-brand-youtube\" data-kid=\"229\"></i></a>\n          </div>\n        </div>\n        \n        <div class=\"grid grid-cols-2 md:grid-cols-3 gap-16\" data-kid=\"230\">\n          <div data-kid=\"231\">\n            <h5 class=\"text-white font-bold text-sm mb-6\" data-kid=\"232\">Platform</h5>\n            <ul class=\"space-y-4 text-zinc-500 text-xs font-medium\" data-kid=\"233\">\n              <li data-kid=\"234\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"235\">AI Generator</a></li>\n              <li data-kid=\"236\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"237\">Assessments</a></li>\n              <li data-kid=\"238\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"239\">Live Classes</a></li>\n            </ul>\n          </div>\n          <div data-kid=\"240\">\n            <h5 class=\"text-white font-bold text-sm mb-6\" data-kid=\"241\">Support</h5>\n            <ul class=\"space-y-4 text-zinc-500 text-xs font-medium\" data-kid=\"242\">\n              <li data-kid=\"243\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"244\">Help Center</a></li>\n              <li data-kid=\"245\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"246\">Privacy Policy</a></li>\n              <li data-kid=\"247\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"248\">Contact</a></li>\n            </ul>\n          </div>\n          <div class=\"col-span-2 md:col-span-1\" data-kid=\"249\">\n            <h5 class=\"text-white font-bold text-sm mb-6\" data-kid=\"250\">Newsletter</h5>\n            <div class=\"flex gap-2\" data-kid=\"251\">\n              <input type=\"email\" placeholder=\"Email address\" class=\"bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2 text-xs w-full focus:outline-none focus:border-neon\" data-kid=\"252\">\n              <button class=\"bg-zinc-800 px-4 py-2 rounded-xl text-white hover:bg-zinc-700 transition-colors\" data-kid=\"253\"><i class=\"ti ti-mail\" data-kid=\"254\"></i></button>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-zinc-900 flex justify-between items-center text-[10px] text-zinc-600 font-bold uppercase tracking-widest\" data-kid=\"255\">\n        <span data-kid=\"256\">&copy; 2026 FitMind Hub • All rights reserved</span>\n        <div class=\"flex items-center gap-4\" data-kid=\"257\">\n          <i class=\"ti ti-device-mobile-dollar text-lg\" data-kid=\"258\"></i>\n          <span data-kid=\"259\">Secure Mobile Payments</span>\n        </div>\n      </div>\n    </footer>\n\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"260\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"261\"></script>\n<script type=\"module\" data-kid=\"262\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Initialize Lenis\n  const lenis = new Lenis({\n    autoRaf: true,\n  });\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Sync ScrollTrigger with Lenis\n  lenis.on('scroll', ScrollTrigger.update);\n  gsap.ticker.add((time) => {\n    lenis.raf(time * 1000);\n  });\n  gsap.ticker.lagSmoothing(0);\n\n  // Bento Entrance Animation\n  gsap.from(\".bento-cell\", {\n    duration: 1.2,\n    y: 60,\n    opacity: 0,\n    stagger: 0.1,\n    ease: \"power4.out\",\n    delay: 0.2\n  });\n\n  // Reveal animations on scroll\n  const revealElements = document.querySelectorAll(\".reveal-up\");\n  revealElements.forEach(el => {\n    gsap.from(el, {\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 90%\",\n      },\n      duration: 1,\n      y: 40,\n      opacity: 0,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Chat bubbles stagger\n  gsap.from(\".reveal-chat\", {\n    scrollTrigger: {\n      trigger: \"#chat-container\",\n      start: \"top 80%\",\n    },\n    duration: 0.8,\n    scale: 0.8,\n    opacity: 0,\n    stagger: 0.3,\n    ease: \"back.out(1.7)\"\n  });\n\n  // Feature cards entrance\n  gsap.from(\".feature-card\", {\n    scrollTrigger: {\n      trigger: \".feature-card\",\n      start: \"top 85%\",\n    },\n    duration: 1,\n    x: 100,\n    opacity: 0,\n    stagger: 0.2,\n    ease: \"power3.out\"\n  });\n\n  // Carousel Navigation\n  const carousel = document.getElementById('carousel');\n  const prevBtn = document.getElementById('prev-btn');\n  const nextBtn = document.getElementById('next-btn');\n\n  nextBtn.addEventListener('click', () => {\n    carousel.scrollBy({ left: 400, behavior: 'smooth' });\n  });\n\n  prevBtn.addEventListener('click', () => {\n    carousel.scrollBy({ left: -400, behavior: 'smooth' });\n  });\n\n</script>",
