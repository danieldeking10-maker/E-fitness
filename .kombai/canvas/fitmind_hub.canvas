      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-neon: #C0FF00;\n    --color-bg: #0A0A0A;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--color-bg);\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n    overflow-x: clip;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n\n  .hero-video {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100vh;\n    object-fit: cover;\n    filter: brightness(0.4) grayscale(0.5);\n  }\n\n  .glass-panel {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .peek-carousel {\n    display: flex;\n    gap: 1.5rem;\n    overflow-x: auto;\n    padding: 0 10%;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n  }\n\n  .peek-carousel::-webkit-scrollbar { display: none; }\n\n  .session-card {\n    min-width: 80%;\n    scroll-snap-align: center;\n    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  @media (min-width: 1024px) {\n    .session-card { min-width: 45%; }\n  }\n\n  .value-ramp-card {\n    transition: all 0.4s ease;\n    align-self: flex-end;\n  }\n\n  .value-ramp-card:hover {\n    border-color: var(--color-neon);\n    background: rgba(192, 255, 0, 0.05);\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    \n    <section class=\"relative h-screen flex items-center justify-center overflow-hidden\" data-kid=\"3\">\n      <video class=\"hero-video\" src=\"https://videos.pexels.com/video-files/4804847/4804847-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/4804847/pexels-photo-4804847.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" data-kid=\"4\"></video>\n      \n      <div class=\"relative z-10 text-center px-8\" data-kid=\"5\">\n        <div class=\"glass-panel inline-block px-6 py-2 rounded-full mb-8 reveal\" data-kid=\"6\">\n          <span class=\"text-[var(--color-neon)] text-xs font-bold tracking-[0.3em] uppercase\" data-kid=\"7\">The Future of Movement</span>\n        </div>\n        <h1 class=\"font-heading text-6xl md:text-8xl font-extrabold tracking-tighter mb-8 reveal\" data-kid=\"8\">\n          E-fitness <br data-kid=\"9\"><span class=\"text-zinc-400\" data-kid=\"10\">Hub.</span>\n        </h1>\n        <div class=\"flex flex-wrap justify-center gap-4 reveal\" data-kid=\"11\">\n          <a href=\"/login\" class=\"bg-[var(--color-neon)] text-black px-10 py-5 rounded-full font-bold text-lg hover:scale-105 transition-transform\" data-kid=\"12\">Access Live Portal</a>\n          <button class=\"glass-panel px-10 py-5 rounded-full font-bold text-lg hover:bg-white/5 transition-all\" data-kid=\"13\">Explore Classes</button>\n        </div>\n      </div>\n      \n      <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce\" data-kid=\"14\">\n        <i class=\"ti ti-chevron-down text-2xl text-zinc-500\" data-kid=\"15\"></i>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-zinc-950\" data-kid=\"16\">\n      <div class=\"max-w-7xl mx-auto px-8 mb-20 text-center\" data-kid=\"17\">\n        <h2 class=\"font-heading text-4xl md:text-5xl font-bold mb-6\" data-kid=\"18\">Live & Synchronized.</h2>\n        <p class=\"text-zinc-500 text-lg max-w-2xl mx-auto\" data-kid=\"19\">Train with world-class instructors in high-fidelity live streams, or access our curated library of elite recorded content.</p>\n      </div>\n\n      <div class=\"peek-carousel\" data-kid=\"20\">\n        <div class=\"session-card glass-panel rounded-[3rem] overflow-hidden\" data-kid=\"21\">\n          <div class=\"aspect-[16/10] relative\" data-kid=\"22\">\n            <img src=\"https://images.unsplash.com/photo-1517130038641-a774d04afb3c?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover\" alt=\"Geert Pieters on Unsplash\" data-kid=\"23\">\n            <div class=\"absolute top-8 left-8 bg-red-600 text-white text-[10px] font-bold px-3 py-1.5 rounded-full flex items-center gap-2\" data-kid=\"24\">\n              <span class=\"h-1.5 w-1.5 bg-white rounded-full animate-ping\" data-kid=\"25\"></span> LIVE NOW\n            </div>\n          </div>\n          <div class=\"p-12\" data-kid=\"26\">\n            <div class=\"flex justify-between items-start mb-4\" data-kid=\"27\">\n              <h3 class=\"font-heading text-3xl font-bold\" data-kid=\"28\">Morning Power</h3>\n              <div class=\"text-[var(--color-neon)] font-bold text-sm\" data-kid=\"29\">45 MINS</div>\n            </div>\n            <p class=\"text-zinc-500 mb-8 leading-relaxed\" data-kid=\"30\">Push your limits with Sarah Chen in this high-intensity metabolic spike session.</p>\n            <button class=\"w-full bg-white/5 border border-white/10 py-4 rounded-full font-bold hover:bg-[var(--color-neon)] hover:text-black transition-all\" data-kid=\"31\">Join Session</button>\n          </div>\n        </div>\n\n        <div class=\"session-card glass-panel rounded-[3rem] overflow-hidden\" data-kid=\"32\">\n          <div class=\"aspect-[16/10] relative\" data-kid=\"33\">\n            <img src=\"https://images.unsplash.com/photo-1554284126-aa88f22d8b74?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover\" alt=\"Sven Mieke on Unsplash\" data-kid=\"34\">\n            <div class=\"absolute top-8 left-8 bg-zinc-800 text-white text-[10px] font-bold px-3 py-1.5 rounded-full\" data-kid=\"35\">RECORDED</div>\n          </div>\n          <div class=\"p-12\" data-kid=\"36\">\n            <div class=\"flex justify-between items-start mb-4\" data-kid=\"37\">\n              <h3 class=\"font-heading text-3xl font-bold\" data-kid=\"38\">Base Hypertrophy</h3>\n              <div class=\"text-[var(--color-neon)] font-bold text-sm\" data-kid=\"39\">60 MINS</div>\n            </div>\n            <p class=\"text-zinc-500 mb-8 leading-relaxed\" data-kid=\"40\">Master the fundamentals of muscle growth with Marcus Thorne's scientific lifting series.</p>\n            <button class=\"w-full bg-white/5 border border-white/10 py-4 rounded-full font-bold hover:bg-[var(--color-neon)] hover:text-black transition-all\" data-kid=\"41\">Start Training</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 px-8\" data-kid=\"42\">\n      <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 items-end justify-center\" data-kid=\"43\">\n        <div class=\"value-ramp-card glass-panel p-10 rounded-[2.5rem] w-full lg:w-72 h-64 flex flex-col justify-between reveal-ramp\" data-kid=\"44\">\n          <div data-kid=\"45\">\n            <div class=\"font-bold text-lg mb-2\" data-kid=\"46\">Guest</div>\n            <div class=\"text-zinc-500 text-xs\" data-kid=\"47\">Access AI Assessments</div>\n          </div>\n          <div class=\"text-3xl font-heading font-bold\" data-kid=\"48\">Free</div>\n        </div>\n        \n        <div class=\"value-ramp-card glass-panel p-10 rounded-[2.5rem] w-full lg:w-80 h-96 flex flex-col justify-between reveal-ramp\" data-kid=\"49\">\n          <div data-kid=\"50\">\n            <div class=\"font-bold text-xl mb-2\" data-kid=\"51\">Core</div>\n            <div class=\"text-zinc-500 text-xs mb-4\" data-kid=\"52\">Daily AI Generations</div>\n            <ul class=\"text-xs text-zinc-400 space-y-2\" data-kid=\"53\">\n              <li class=\"flex items-center gap-2\" data-kid=\"54\"><i class=\"ti ti-check text-[var(--color-neon)]\" data-kid=\"55\"></i> Unlimited AI Workouts</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"56\"><i class=\"ti ti-check text-[var(--color-neon)]\" data-kid=\"57\"></i> Companion Chat Access</li>\n            </ul>\n          </div>\n          <div data-kid=\"58\">\n            <div class=\"text-4xl font-heading font-bold mb-4\" data-kid=\"59\">$12<span class=\"text-sm font-normal text-zinc-600\" data-kid=\"60\">/mo</span></div>\n            <button class=\"w-full bg-[var(--color-neon)] text-black py-4 rounded-full font-bold text-sm\" data-kid=\"61\">Start Core</button>\n          </div>\n        </div>\n\n        <div class=\"value-ramp-card glass-panel border-[var(--color-neon)]/30 p-10 rounded-[2.5rem] w-full lg:w-96 h-[32rem] flex flex-col justify-between relative reveal-ramp\" data-kid=\"62\">\n          <div class=\"absolute -top-4 right-8 bg-[var(--color-neon)] text-black px-4 py-1.5 rounded-full text-[10px] font-bold\" data-kid=\"63\">ELITE ACCESS</div>\n          <div data-kid=\"64\">\n            <div class=\"font-bold text-2xl mb-2\" data-kid=\"65\">Infinite</div>\n            <div class=\"text-zinc-500 text-xs mb-6\" data-kid=\"66\">The Complete Experience</div>\n            <ul class=\"text-xs text-zinc-400 space-y-3\" data-kid=\"67\">\n              <li class=\"flex items-center gap-2\" data-kid=\"68\"><i class=\"ti ti-check text-[var(--color-neon)]\" data-kid=\"69\"></i> Everything in Core</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"70\"><i class=\"ti ti-check text-[var(--color-neon)]\" data-kid=\"71\"></i> All Live Session Keys</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"72\"><i class=\"ti ti-check text-[var(--color-neon)]\" data-kid=\"73\"></i> Biometric Hardware Sync</li>\n            </ul>\n          </div>\n          <div data-kid=\"74\">\n            <div class=\"text-5xl font-heading font-bold mb-6\" data-kid=\"75\">$29<span class=\"text-sm font-normal text-zinc-600\" data-kid=\"76\">/mo</span></div>\n            <button class=\"w-full bg-white text-black py-4 rounded-full font-bold text-sm hover:bg-[var(--color-neon)] transition-colors\" data-kid=\"77\">Go Infinite</button>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"mt-16 text-center reveal\" data-kid=\"78\">\n        <span class=\"text-[10px] font-bold tracking-[0.4em] text-zinc-600 uppercase mb-4 block\" data-kid=\"79\">Secure Local Payments</span>\n        <div class=\"flex justify-center gap-8 text-zinc-700\" data-kid=\"80\">\n          <i class=\"ti ti-device-mobile-dollar text-3xl\" data-kid=\"81\"></i>\n          <i class=\"ti ti-phone text-3xl\" data-kid=\"82\"></i>\n          <i class=\"ti ti-credit-card text-3xl\" data-kid=\"83\"></i>\n        </div>\n      </div>\n    </section>\n  </div>\n</div>\n\n\n<div class=\"fixed bottom-8 right-8 z-50\" data-kid=\"84\">\n  <div class=\"glass-panel h-16 w-16 rounded-2xl flex items-center justify-center cursor-pointer hover:scale-110 transition-transform shadow-2xl shadow-[var(--color-neon)]/20\" data-kid=\"85\">\n    <div class=\"h-8 w-8 bg-[var(--color-neon)] rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"86\">AI</div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"87\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"88\"></script>\n<script type=\"module\" data-kid=\"89\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis({ autoRaf: true });\n  gsap.registerPlugin(ScrollTrigger);\n  lenis.on('scroll', ScrollTrigger.update);\n\n  gsap.from('.reveal', {\n    y: 30,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.15,\n    ease: \"power3.out\"\n  });\n\n  gsap.from('.reveal-ramp', {\n    y: 60,\n    opacity: 0,\n    duration: 0.8,\n    stagger: 0.1,\n    ease: \"power2.out\",\n    scrollTrigger: {\n      trigger: '.reveal-ramp',\n      start: 'top 85%'\n    }\n  });\n</script>",
      "comments": [],
      "created": "2026-07-04T17:37:25.774751+00:00",
      "modified": "2026-07-04T17:37:45.180655+00:00",
