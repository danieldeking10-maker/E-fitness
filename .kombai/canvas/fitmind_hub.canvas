    "var_0a4b4e15981f": {
      "type": "variant",
      "label": "Recorded Library",
      "parentId": "var_c725e131d9a9",
      "themeId": null,
      "rect": {
        "x": 26180,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@700&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n\n  .hero-mask {\n    mask-image: linear-gradient(to bottom, black 50%, transparent);\n  }\n\n  .video-card {\n    min-width: 320px;\n    flex-shrink: 0;\n    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  .video-card:hover {\n    transform: scale(1.05) translateY(-5px);\n    z-index: 10;\n  }\n\n  .badge-load {\n    background: rgba(192, 255, 0, 0.1);\n    color: #C0FF00;\n    border: 1px solid rgba(192, 255, 0, 0.2);\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 z-50 w-full px-12 py-8 flex items-center justify-between bg-gradient-to-b from-black/80 to-transparent backdrop-blur-sm\" data-kid=\"2\">\n    <div class=\"flex items-center gap-12\" data-kid=\"3\">\n      <div class=\"text-2xl font-heading font-bold\" data-kid=\"4\">E-fitness</div>\n      <div class=\"hidden md:flex gap-8 text-sm font-medium text-zinc-400\" data-kid=\"5\">\n        <a href=\"#\" class=\"text-white\" data-kid=\"6\">Home</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"7\">Live</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"8\">Training Library</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"9\">My Progress</a>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-6\" data-kid=\"10\">\n      <i class=\"ti ti-search text-xl text-zinc-400\" data-kid=\"11\"></i>\n      <i class=\"ti ti-bell text-xl text-zinc-400\" data-kid=\"12\"></i>\n      <div class=\"h-8 w-8 rounded-full bg-zinc-800\" data-kid=\"13\"></div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative h-[80vh] flex items-center px-12 overflow-hidden\" data-kid=\"14\">\n    <div class=\"absolute inset-0 hero-mask\" data-kid=\"15\">\n      <img src=\"https://images.unsplash.com/photo-1593431763017-c689a61b729a?auto=format&w=1600&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-40\" data-kid=\"16\">\n      <div class=\"absolute inset-0 bg-gradient-to-r from-black via-black/40 to-transparent\" data-kid=\"17\"></div>\n    </div>\n    \n    <div class=\"relative z-10 max-w-2xl\" data-kid=\"18\">\n      <div class=\"flex items-center gap-2 mb-6\" data-kid=\"19\">\n        <span class=\"text-[#C0FF00] font-bold text-xs tracking-widest uppercase\" data-kid=\"20\">AI Recommended</span>\n        <div class=\"h-1 w-12 bg-[#C0FF00]\" data-kid=\"21\"></div>\n      </div>\n      <h1 class=\"font-heading text-6xl font-bold mb-6\" data-kid=\"22\">Foundation <br data-kid=\"23\">Strength II.</h1>\n      <p class=\"text-lg text-zinc-400 mb-8 leading-relaxed\" data-kid=\"24\">A specialized program for intermediate athletes looking to break plateaus through controlled progressive overload.</p>\n      <div class=\"flex gap-4\" data-kid=\"25\">\n        <button class=\"bg-white text-black px-8 py-4 rounded-full font-bold flex items-center gap-2 hover:bg-[#C0FF00] transition-colors\" data-kid=\"26\">\n          <i class=\"ti ti-player-play-filled\" data-kid=\"27\"></i> Start Training\n        </button>\n        <button class=\"bg-white/10 backdrop-blur-md px-8 py-4 rounded-full font-bold border border-white/5\" data-kid=\"28\">\n          Program Details\n        </button>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"-mt-20 relative z-20 pb-32\" data-kid=\"29\">\n    \n    <section class=\"px-12 mb-16\" data-kid=\"30\">\n      <h2 class=\"font-heading text-xl font-bold mb-6\" data-kid=\"31\">Continue Training</h2>\n      <div class=\"flex gap-6 overflow-x-auto pb-8 scrollbar-hide\" data-kid=\"32\">\n        <div class=\"video-card group\" data-kid=\"33\">\n          <div class=\"aspect-video bg-zinc-900 rounded-[2rem] overflow-hidden border border-white/5 relative mb-4\" data-kid=\"34\">\n             <img src=\"https://images.unsplash.com/photo-1552196527-bffef41ef674?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"35\">\n             <div class=\"absolute bottom-0 left-0 h-1 bg-[#C0FF00] w-[65%]\" data-kid=\"36\"></div>\n          </div>\n          <div class=\"flex justify-between items-start\" data-kid=\"37\">\n            <div data-kid=\"38\">\n              <div class=\"font-bold text-sm\" data-kid=\"39\">Full Body Mobility</div>\n              <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"40\">12 MINS REMAINING</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"px-12 mb-16\" data-kid=\"41\">\n      <h2 class=\"font-heading text-xl font-bold mb-6\" data-kid=\"42\">Metabolic Conditioning</h2>\n      <div class=\"flex gap-6 overflow-x-auto pb-8 scrollbar-hide\" data-kid=\"43\">\n        <div class=\"video-card\" data-kid=\"44\">\n          <div class=\"aspect-video bg-zinc-900 rounded-[2rem] overflow-hidden border border-white/5 relative mb-4\" data-kid=\"45\">\n             <img src=\"https://images.unsplash.com/photo-1616279969856-759f316a5ac1?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover\" data-kid=\"46\">\n             <div class=\"absolute top-4 left-4 badge-load px-2 py-1 rounded text-[8px] font-bold\" data-kid=\"47\">LOAD: HIGH</div>\n          </div>\n          <div class=\"font-bold text-sm\" data-kid=\"48\">HIIT Shred: Level 4</div>\n          <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"49\">45 MINS • ADVANCED</div>\n        </div>\n        <div class=\"video-card\" data-kid=\"50\">\n          <div class=\"aspect-video bg-zinc-900 rounded-[2rem] overflow-hidden border border-white/5 relative mb-4\" data-kid=\"51\">\n             <img src=\"https://images.unsplash.com/photo-1591258370814-01609b341790?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover\" data-kid=\"52\">\n             <div class=\"absolute top-4 left-4 badge-load px-2 py-1 rounded text-[8px] font-bold\" data-kid=\"53\">LOAD: MED</div>\n          </div>\n          <div class=\"font-bold text-sm\" data-kid=\"54\">Tabata Sprint Core</div>\n          <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"55\">20 MINS • ALL LEVELS</div>\n        </div>\n        <div class=\"video-card\" data-kid=\"56\">\n          <div class=\"aspect-video bg-zinc-900 rounded-[2rem] overflow-hidden border border-white/5 relative mb-4\" data-kid=\"57\">\n             <img src=\"https://images.unsplash.com/photo-1549995546-87cb41aa98a4?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover\" data-kid=\"58\">\n             <div class=\"absolute top-4 left-4 badge-load px-2 py-1 rounded text-[8px] font-bold\" data-kid=\"59\">LOAD: LOW</div>\n          </div>\n          <div class=\"font-bold text-sm\" data-kid=\"60\">Active Recovery Flow</div>\n          <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"61\">30 MINS • BEGINNER</div>\n        </div>\n      </div>\n    </section>\n  </div>\n</div>",
