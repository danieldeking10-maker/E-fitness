      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Sora:wght@100..800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-ink-black: #0A0A0A;\n    --color-dark-slate: #1A1D24;\n    --color-neon-chartreuse: #C0FF00;\n  }\n\n  body {\n    background-color: var(--color-ink-black);\n    color: white;\n    font-family: 'DM Sans', sans-serif;\n    margin: 0;\n    overflow-x: clip;\n  }\n\n  h1, h2, h3, h4 {\n    font-family: 'Sora', sans-serif;\n    letter-spacing: -0.02em;\n  }\n\n  .text-neon { color: var(--color-neon-chartreuse); }\n  .bg-neon { background-color: var(--color-neon-chartreuse); }\n  .border-neon { border-color: var(--color-neon-chartreuse); }\n  .text-ink-black { color: var(--color-ink-black); }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.4);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Custom utility for pricing ramp heights */\n  .ramp-card { transition: transform 0.3s ease; }\n  .ramp-1 { height: 420px; }\n  .ramp-2 { height: 460px; }\n  .ramp-3 { height: 520px; }\n  .ramp-4 { height: 580px; }\n\n  .chat-bubble {\n    max-width: 80%;\n    padding: 12px 16px;\n    border-radius: 20px;\n    font-size: 14px;\n    line-height: 1.5;\n    margin-bottom: 12px;\n  }\n  .chat-bubble.ai {\n    background: rgba(192, 255, 0, 0.1);\n    border: 1px solid rgba(192, 255, 0, 0.2);\n    color: var(--color-neon-chartreuse);\n    align-self: flex-start;\n    border-bottom-left-radius: 4px;\n  }\n  .chat-bubble.user {\n    background: rgba(255, 255, 255, 0.05);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    color: white;\n    align-self: flex-end;\n    border-bottom-right-radius: 4px;\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    \n    \n    <section id=\"hero\" class=\"relative h-screen w-full flex items-center justify-center overflow-hidden\" data-kid=\"3\">\n      <video src=\"https://videos.pexels.com/video-files/4804847/4804847-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/4804847/pexels-photo-4804847.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1280\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 h-full w-full object-cover grayscale brightness-50\" data-kid=\"4\"></video>\n      <div class=\"relative z-10 flex flex-col items-center px-6 text-center\" data-kid=\"5\">\n        <div class=\"glass max-w-4xl rounded-[40px] p-12 md:p-20\" data-kid=\"6\">\n          <span class=\"mb-4 inline-block rounded-full bg-neon/10 px-4 py-1 text-xs font-bold uppercase tracking-widest text-neon\" data-kid=\"7\">Community Powered AI</span>\n          <h1 class=\"text-6xl font-bold leading-[0.95] md:text-9xl\" data-kid=\"8\">FitMind <span class=\"text-neon italic\" data-kid=\"9\">Hub</span></h1>\n          <p class=\"mt-8 text-lg text-zinc-300 md:text-2xl max-w-2xl mx-auto\" data-kid=\"10\">Elite wellness for the modern athlete. Transform your community with AI-driven training and live sessions.</p>\n          <div class=\"mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row\" data-kid=\"11\">\n            <button class=\"bg-neon text-ink-black rounded-full px-10 py-5 text-lg font-black transition-transform hover:scale-105 active:scale-95 shadow-[0_0_40px_rgba(192,255,0,0.3)]\" data-kid=\"12\">START LIVE ASSESSMENT</button>\n            <button class=\"rounded-full border border-white/20 bg-white/5 px-10 py-5 text-lg font-bold backdrop-blur-md transition-all hover:bg-white/10\" data-kid=\"13\">EXPLORE SESSIONS</button>\n          </div>\