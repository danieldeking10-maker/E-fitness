    "var_c24f9a537433": {
      "type": "variant",
      "label": "AI Workout Generator - Matrix",
      "parentId": "var_3c185f02d859",
      "themeId": null,
      "rect": {
        "x": 35420,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@700&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n  \n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .accent-glow {\n    box-shadow: inset 0 0 20px rgba(192, 255, 0, 0.05);\n  }\n</style>\n\n<div class=\"min-h-screen p-12\" data-kid=\"1\">\n  <div class=\"max-w-7xl mx-auto\" data-kid=\"2\">\n    <div class=\"flex items-center justify-between mb-12\" data-kid=\"3\">\n      <div data-kid=\"4\">\n        <h1 class=\"font-heading text-4xl font-bold mb-2\" data-kid=\"5\">Generated <span class=\"text-[#C0FF00]\" data-kid=\"6\">Plan</span></h1>\n        <p class=\"text-zinc-500\" data-kid=\"7\">Based on Hypertrophy focus • 45 Min Session</p>\n      </div>\n      <button class=\"bg-[#C0FF00] text-black px-6 py-3 rounded-full font-bold text-sm\" data-kid=\"8\">Save to Calendar</button>\n    </div>\n\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\" data-kid=\"9\">\n      \n      <div class=\"lg:col-span-2 space-y-4\" data-kid=\"10\">\n        <div class=\"glass p-8 rounded-[2rem] flex items-center gap-8 accent-glow\" data-kid=\"11\">\n          <div class=\"h-20 w-20 rounded-2xl bg-zinc-900 border border-white/5 flex items-center justify-center overflow-hidden\" data-kid=\"12\">\n            <img src=\"https://images.unsplash.com/photo-1599447332412-6bc6830c815a?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-50\" data-kid=\"13\">\n          </div>\n          <div class=\"flex-1\" data-kid=\"14\">\n            <h3 class=\"font-heading text-xl font-bold mb-1\" data-kid=\"15\">Barbell Back Squat</h3>\n            <p class=\"text-xs text-zinc-500 uppercase tracking-widest\" data-kid=\"16\">Focus: Quads & Glutes</p>\n          </div>\n          <div class=\"text-right\" data-kid=\"17\">\n            <div class=\"text-2xl font-heading font-bold\" data-kid=\"18\">4 <span class=\"text-sm font-normal text-zinc-500\" data-kid=\"19\">x</span> 8</div>\n            <div class=\"text-[10px] text-[#C0FF00] font-bold\" data-kid=\"20\">75% 1RM</div>\n          </div>\n        </div>\n\n        <div class=\"glass p-8 rounded-[2rem] flex items-center gap-8\" data-kid=\"21\">\n          <div class=\"h-20 w-20 rounded-2xl bg-zinc-900 border border-white/5 flex items-center justify-center overflow-hidden\" data-kid=\"22\">\n            <img src=\"https://images.unsplash.com/photo-1534258936925-c58bed479fcb?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-50\" data-kid=\"23\">\n          </div>\n          <div class=\"flex-1\" data-kid=\"24\">\n            <h3 class=\"font-heading text-xl font-bold mb-1\" data-kid=\"25\">Bulgarian Split Squat</h3>\n            <p class=\"text-xs text-zinc-500 uppercase tracking-widest\" data-kid=\"26\">Focus: Unilateral Strength</p>\n          </div>\n          <div class=\"text-right\" data-kid=\"27\">\n            <div class=\"text-2xl font-heading font-bold\" data-kid=\"28\">3 <span class=\"text-sm font-normal text-zinc-500\" data-kid=\"29\">x</span> 12</div>\n            <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"30\">RPE 8</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"space-y-8\" data-kid=\"31\">\n        <div class=\"glass p-10 rounded-[2.5rem] border-[#C0FF00]/30 bg-[#C0FF00]/5\" data-kid=\"32\">\n          <div class=\"flex items-center gap-3 mb-6\" data-kid=\"33\">\n            <i class=\"ti ti-brain text-[#C0FF00] text-2xl\" data-kid=\"34\"></i>\n            <h4 class=\"font-heading font-bold\" data-kid=\"35\">AI Coach Notes</h4>\n          </div>\n          <p class=\"text-sm text-zinc-400 leading-relaxed mb-6\" data-kid=\"36\">\n            \"Your CNS score is slightly lower today. Keep the eccentric portion of the squats controlled (3 seconds) to maximize mechanical tension without excessive fatigue.\"\n          </p>\n          <div class=\"pt-6 border-t border-white/5 flex items-center justify-between\" data-kid=\"37\">\n            <span class=\"text-[10px] font-bold text-zinc-500 uppercase\" data-kid=\"38\">Recovery Rec</span>\n            <span class=\"text-[10px] font-bold text-[#C0FF00] uppercase\" data-kid=\"39\">High Protein</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
      "comments": [],
      "created": "2026-07-04T17:46:25.273387+00:00",
      "modified": "2026-07-04T17:46:28.968338+00:00",
