        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-bg: #0A0A0A;\n    --color-surface: #1A1D24;\n    --color-accent: #C0FF00;\n    --font-heading: 'Sora', sans-serif;\n    --font-body: 'DM Sans', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--color-bg);\n    color: #FFFFFF;\n    font-family: var(--font-body);\n    overflow-x: clip;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  \n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .step-card {\n    display: none;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  .step-card.active {\n    display: block;\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .progress-dot.active {\n    background-color: var(--color-accent);\n    box-shadow: 0 0 10px var(--color-accent);\n  }\n\n  input[type=\"text\"], textarea {\n    background: rgba(0, 0, 0, 0.4);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    color: white;\n    width: 100%;\n    padding: 1rem 1.5rem;\n    border-radius: 1rem;\n    outline: none;\n    transition: border-color 0.3s ease;\n  }\n\n  input[type=\"text\"]:focus, textarea:focus {\n    border-color: var(--color-accent);\n  }\n\n  .bg-neon { background-color: var(--color-accent); }\n  .text-neon { color: var(--color-accent); }\n  .border-neon { border-color: var(--color-accent); }\n\n  /* Custom Checkbox */\n  .checkbox-group label {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    padding: 1rem;\n    background: rgba(255, 255, 255, 0.03);\n    border-radius: 1rem;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    border: 1px solid transparent;\n  }\n\n  .checkbox-group label:hover {\n    background: rgba(255, 255, 255, 0.05);\n  }\n\n  .checkbox-group input:checked + div {\n    background: var(--color-accent);\n    border-color: var(--color-accent);\n    color: black;\n  }\n\n  .response-area {\n    font-family: 'DM Sans', monospace;\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    \n    <nav class=\"fixed top-0 z-50 w-full px-8 py-6\" data-kid=\"3\">\n      <div class=\"mx-auto flex max-w-7xl items-center justify-between glass rounded-full px-8 py-4\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2\" data-kid=\"5\">\n          <a href=\"/\" class=\"flex items-center gap-2\" data-kid=\"6\">\n            <div class=\"h-8 w-8 bg-neon rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"7\">E</div>\n            <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"8\">E-fitness</span>\n          </a>\n        </div>\n        <div class=\"flex items-center gap-4\" data-kid=\"9\">\n          <span class=\"text-xs text-zinc-500 font-bold uppercase tracking-widest mr-4\" data-kid=\"10\">AI Diagnostic Unit</span>\n          <div class=\"h-2 w-2 bg-neon rounded-full animate-pulse\" data-kid=\"11\"></div>\n        </div>\n      </div>\n    </nav>\n\n    <main class=\"pt-40 pb-20 px-8\" data-kid=\"12\">\n      <div class=\"mx-auto max-w-4xl\" data-kid=\"13\">\n        \n        \n        <div class=\"text-center mb-16 reveal\" data-kid=\"14\">\n          <h1 class=\"font-heading text-4xl md:text-5xl font-bold mb-4\" data-kid=\"15\">Wellness <span class=\"text-neon\" data-kid=\"16\">Assessment</span></h1>\n          <p class=\"text-zinc-400 text-lg\" data-kid=\"17\">Initialize your biometric profile to generate a precision health roadmap.</p>\n        </div>\n\n        \n        <div class=\"glass rounded-[3rem] p-1 lg:p-2 mb-20 reveal\" data-kid=\"18\">\n          <div class=\"bg-zinc-900/40 backdrop-blur-2xl rounded-[2.8rem] p-8 lg:p-12 relative overflow-hidden\" data-kid=\"19\">\n            \n            \n            <div class=\"flex items-center justify-between mb-12 relative\" data-kid=\"20\">\n              <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-zinc-800 -z-10\" data-kid=\"21\"></div>\n              <div class=\"flex items-center gap-12 mx-auto\" data-kid=\"22\">\n                <div class=\"flex flex-col items-center gap-3\" data-kid=\"23\">\n                  <div class=\"progress-dot h-3 w-3 rounded-full bg-zinc-700 active transition-all duration-500\" data-step=\"1\" data-kid=\"24\"></div>\n                  <span class=\"text-[10px] font-bold tracking-widest text-zinc-500 uppercase\" data-kid=\"25\">Goals</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-3\" data-kid=\"26\">\n                  <div class=\"progress-dot h-3 w-3 rounded-full bg-zinc-700 transition-all duration-500\" data-step=\"2\" data-kid=\"27\"></div>\n                  <span class=\"text-[10px] font-bold tracking-widest text-zinc-500 uppercase\" data-kid=\"28\">Body</span>\n                </div>\n                <div class=\"flex flex-col items-center gap-3\" data-kid=\"29\">\n                  <div class=\"progress-dot h-3 w-3 rounded-full bg-zinc-700 transition-all duration-500\" data-step=\"3\" data-kid=\"30\"></div>\n                  <span class=\"text-[10px] font-bold tracking-widest text-zinc-500 uppercase\" data-kid=\"31\">Recovery</span>\n                </div>\n              </div>\n            </div>\n\n            \n            <div id=\"steps-container\" data-kid=\"32\">\n              \n              \n              <div class=\"step-card active\" data-step=\"1\" data-kid=\"33\">\n                <div class=\"mb-8\" data-kid=\"34\">\n                  <h2 class=\"font-heading text-2xl font-bold mb-2\" data-kid=\"35\">What is your primary objective?</h2>\n                  <p class=\"text-sm text-zinc-500\" data-kid=\"36\">AI will prioritize these parameters in your generation.</p>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 checkbox-group mb-8\" data-kid=\"37\">\n                  <label data-kid=\"38\">\n                    <input type=\"checkbox\" class=\"hidden\" checked data-kid=\"39\">\n                    <div class=\"h-6 w-6 rounded border border-zinc-700 flex items-center justify-center transition-all\" data-kid=\"40\"><i class=\"ti ti-check text-xs\" data-kid=\"41\"></i></div>\n                    <span class=\"text-sm font-medium\" data-kid=\"42\">Strength & Hypertrophy</span>\n                  </label>\n                  <label data-kid=\"43\">\n                    <input type=\"checkbox\" class=\"hidden\" data-kid=\"44\">\n                    <div class=\"h-6 w-6 rounded border border-zinc-700 flex items-center justify-center transition-all\" data-kid=\"45\"><i class=\"ti ti-check text-xs\" data-kid=\"46\"></i></div>\n                    <span class=\"text-sm font-medium\" data-kid=\"47\">Metabolic Conditioning</span>\n                  </label>\n                  <label data-kid=\"48\">\n                    <input type=\"checkbox\" class=\"hidden\" data-kid=\"49\">\n                    <div class=\"h-6 w-6 rounded border border-zinc-700 flex items-center justify-center transition-all\" data-kid=\"50\"><i class=\"ti ti-check text-xs\" data-kid=\"51\"></i></div>\n                    <span class=\"text-sm font-medium\" data-kid=\"52\">Longevity & Mobility</span>\n                  </label>\n                  <label data-kid=\"53\">\n                    <input type=\"checkbox\" class=\"hidden\" data-kid=\"54\">\n                    <div class=\"h-6 w-6 rounded border border-zinc-700 flex items-center justify-center transition-all\" data-kid=\"55\"><i class=\"ti ti-check text-xs\" data-kid=\"56\"></i></div>\n                    <span class=\"text-sm font-medium\" data-kid=\"57\">Fat Loss Optimization</span>\n                  </label>\n                </div>\n                <div class=\"space-y-4\" data-kid=\"58\">\n                  <label class=\"block\" data-kid=\"59\">\n                    <span class=\"text-xs font-bold text-zinc-500 uppercase tracking-widest mb-2 block\" data-kid=\"60\">Specific Goals</span>\n                    <input type=\"text\" placeholder=\"e.g., increase bench press by 10kg, run a 5k under 25 mins\" data-kid=\"61\">\n                  </label>\n                </div>\n              </div>\n\n              \n              <div class=\"step-card\" data-step=\"2\" data-kid=\"62\">\n                <div class=\"mb-8\" data-kid=\"63\">\n                  <h2 class=\"font-heading text-2xl font-bold mb-2\" data-kid=\"64\">Body & Constraints</h2>\n                  <p class=\"text-sm text-zinc-500\" data-kid=\"65\">List any injuries or mobility limitations for safer programming.</p>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"66\">\n                  <label class=\"block\" data-kid=\"67\">\n                    <span class=\"text-xs font-bold text-zinc-500 uppercase tracking-widest mb-2 block\" data-kid=\"68\">Injuries / Chronic Pain</span>\n                    <textarea rows=\"3\" placeholder=\"e.g., lower back tightness, historical ACL surgery\" data-kid=\"69\"></textarea>\n                  </label>\n                  <label class=\"block\" data-kid=\"70\">\n                    <span class=\"text-xs font-bold text-zinc-500 uppercase tracking-widest mb-2 block\" data-kid=\"71\">Experience Level</span>\n                    <select class=\"w-full bg-black/40 border border-white/10 rounded-2xl p-4 text-white outline-none\" data-kid=\"72\">\n                      <option data-kid=\"73\">Beginner (0-1 years)</option>\n                      <option selected data-kid=\"74\">Intermediate (1-3 years)</option>\n                      <option data-kid=\"75\">Advanced (3+ years)</option>\n                      <option data-kid=\"76\">Elite Athlete</option>\n                    </select>\n                  </label>\n                </div>\n              </div>\n\n              \n              <div class=\"step-card\" data-step=\"3\" data-kid=\"77\">\n                <div class=\"mb-8\" data-kid=\"78\">\n                  <h2 class=\"font-heading text-2xl font-bold mb-2\" data-kid=\"79\">Lifestyle & Recovery</h2>\n                  <p class=\"text-sm text-zinc-500\" data-kid=\"80\">Recovery is 50% of the result. Be honest.</p>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"81\">\n                  <div data-kid=\"82\">\n                    <span class=\"text-xs font-bold text-zinc-500 uppercase tracking-widest mb-4 block\" data-kid=\"83\">Sleep Quality</span>\n                    <div class=\"flex gap-2\" data-kid=\"84\">\n                      <button class=\"h-10 w-10 rounded-lg border border-zinc-800 hover:border-neon transition-colors\" data-kid=\"85\">1</button>\n                      <button class=\"h-10 w-10 rounded-lg border border-zinc-800 hover:border-neon transition-colors\" data-kid=\"86\">2</button>\n                      <button class=\"h-10 w-10 rounded-lg border border-zinc-800 hover:border-neon transition-colors\" data-kid=\"87\">3</button>\n                      <button class=\"h-10 w-10 rounded-lg border border-neon bg-neon/10 text-neon\" data-kid=\"88\">4</button>\n                      <button class=\"h-10 w-10 rounded-lg border border-zinc-800 hover:border-neon transition-colors\" data-kid=\"89\">5</button>\n                    </div>\n                  </div>\n                  <div data-kid=\"90\">\n                    <span class=\"text-xs font-bold text-zinc-500 uppercase tracking-widest mb-4 block\" data-kid=\"91\">Weekly Stress (1-10)</span>\n                    <input type=\"range\" class=\"w-full accent-neon\" data-kid=\"92\">\n                  </div>\n                </div>\n              </div>\n\n            </div>\n\n            \n            <div class=\"flex justify-between mt-12 pt-8 border-t border-white/5\" data-kid=\"93\">\n              <button id=\"prev-btn\" class=\"px-8 py-3 rounded-full font-bold text-zinc-500 hover:text-white transition-colors opacity-0 pointer-events-none\" data-kid=\"94\">Back</button>\n              <button id=\"next-btn\" class=\"bg-neon text-black px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform\" data-kid=\"95\">Continue</button>\n            </div>\n\n            \n            <div id=\"loading-overlay\" class=\"absolute inset-0 bg-black/80 backdrop-blur-md flex flex-col items-center justify-center z-20 opacity-0 pointer-events-none transition-opacity duration-500\" data-kid=\"96\">\n              <div class=\"h-16 w-16 border-4 border-zinc-800 border-t-neon rounded-full animate-spin mb-6\" data-kid=\"97\"></div>\n              <p class=\"font-heading font-bold text-xl text-neon animate-pulse\" data-kid=\"98\">Analyzing Biometrics...</p>\n              <p class=\"text-xs text-zinc-500 mt-4 uppercase tracking-[0.3em]\" data-kid=\"99\">Neural Engine v4.2 Active</p>\n            </div>\n\n          </div>\n        </div>\n\n        \n        <div id=\"ai-response\" class=\"opacity-0 translate-y-10 transition-all duration-1000\" data-kid=\"100\">\n          <div class=\"flex items-center gap-4 mb-8\" data-kid=\"101\">\n            <div class=\"h-10 w-10 bg-neon/10 rounded-xl flex items-center justify-center text-neon\" data-kid=\"102\">\n              <i class=\"ti ti-brain text-2xl\" data-kid=\"103\"></i>\n            </div>\n            <h2 class=\"font-heading text-3xl font-bold\" data-kid=\"104\">Diagnostic <span class=\"text-zinc-500\" data-kid=\"105\">Result</span></h2>\n          </div>\n          \n          <div class=\"glass rounded-[3rem] overflow-hidden\" data-kid=\"106\">\n            <div class=\"bg-neon/5 border-b border-white/5 p-8 flex justify-between items-center\" data-kid=\"107\">\n              <div data-kid=\"108\">\n                <div class=\"text-xs font-bold text-neon uppercase tracking-widest mb-1\" data-kid=\"109\">Status</div>\n                <div class=\"text-xl font-bold\" data-kid=\"110\">OPTIMAL PROGRAM GENERATED</div>\n              </div>\n              <button class=\"bg-neon text-black h-12 w-12 rounded-full flex items-center justify-center hover:rotate-90 transition-transform\" data-kid=\"111\">\n                <i class=\"ti ti-download\" data-kid=\"112\"></i>\n              </button>\n            </div>\n            \n            <div class=\"p-8 lg:p-12 space-y-12\" data-kid=\"113\">\n              <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"114\">\n                <div class=\"p-6 bg-white/5 rounded-[2rem] border border-white/5\" data-kid=\"115\">\n                  <i class=\"ti ti-flame text-neon mb-4 block text-2xl\" data-kid=\"116\"></i>\n                  <div class=\"text-zinc-500 text-xs font-bold uppercase mb-2\" data-kid=\"117\">Metabolic Index</div>\n                  <div class=\"text-3xl font-heading font-bold\" data-kid=\"118\">High <span class=\"text-sm font-normal text-zinc-600\" data-kid=\"119\">8.2</span></div>\n                </div>\n                <div class=\"p-6 bg-white/5 rounded-[2rem] border border-white/5\" data-kid=\"120\">\n                  <i class=\"ti ti-activity text-neon mb-4 block text-2xl\" data-kid=\"121\"></i>\n                  <div class=\"text-zinc-500 text-xs font-bold uppercase mb-2\" data-kid=\"122\">Recovery Score</div>\n                  <div class=\"text-3xl font-heading font-bold\" data-kid=\"123\">74% <span class=\"text-sm font-normal text-zinc-600\" data-kid=\"124\">Fair</span></div>\n                </div>\n                <div class=\"p-6 bg-white/5 rounded-[2rem] border border-white/5\" data-kid=\"125\">\n                  <i class=\"ti ti-shield-check text-neon mb-4 block text-2xl\" data-kid=\"126\"></i>\n                  <div class=\"text-zinc-500 text-xs font-bold uppercase mb-2\" data-kid=\"127\">Risk Factor</div>\n                  <div class=\"text-3xl font-heading font-bold\" data-kid=\"128\">Low <span class=\"text-sm font-normal text-zinc-600\" data-kid=\"129\">1.4</span></div>\n                </div>\n              </div>\n\n              <div class=\"space-y-6\" data-kid=\"130\">\n                <h3 class=\"font-heading text-xl font-bold\" data-kid=\"131\">AI Recommendations</h3>\n                <div class=\"space-y-4\" data-kid=\"132\">\n                  <div class=\"flex gap-6 p-6 glass rounded-2xl border-l-4 border-l-neon\" data-kid=\"133\">\n                    <div class=\"h-10 w-10 shrink-0 bg-neon/10 rounded-full flex items-center justify-center text-neon\" data-kid=\"134\">1</div>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed\" data-kid=\"135\">Prioritize eccentric loading in compound movements to address lower back stability. AI suggests a 4-0-1-0 tempo for all primary lifts.</p>\n                  </div>\n                  <div class=\"flex gap-6 p-6 glass rounded-2xl border-l-4 border-l-zinc-700\" data-kid=\"136\">\n                    <div class=\"h-10 w-10 shrink-0 bg-zinc-800 rounded-full flex items-center justify-center text-zinc-400\" data-kid=\"137\">2</div>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed\" data-kid=\"138\">Increase sleep duration by 45 minutes on training days. Biometric markers indicate elevated cortisol in current recovery cycle.</p>\n                  </div>\n                  <div class=\"flex gap-6 p-6 glass rounded-2xl border-l-4 border-l-zinc-700\" data-kid=\"139\">\n                    <div class=\"h-10 w-10 shrink-0 bg-zinc-800 rounded-full flex items-center justify-center text-zinc-400\" data-kid=\"140\">3</div>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed\" data-kid=\"141\">Incorporate 5 minutes of unilateral mobility work (right side focus) prior to lower body sessions.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"flex flex-col md:flex-row gap-4 pt-8 border-t border-white/5\" data-kid=\"142\">\n                <a href=\"/ai/workout-generator\" class=\"flex-1 bg-neon text-black py-4 rounded-full font-bold text-center hover:scale-105 transition-transform\" data-kid=\"143\">Generate Workout Plan</a>\n                <button class=\"flex-1 glass py-4 rounded-full font-bold hover:bg-white/5 transition-all\" data-kid=\"144\">Save Profile</button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </main>\n\n    \n    <footer class=\"py-20 px-8 border-t border-white/5\" data-kid=\"145\">\n      <div class=\"mx-auto max-w-7xl flex flex-col md:flex-row justify-between items-center text-[10px] text-zinc-600 font-bold tracking-widest uppercase\" data-kid=\"146\">\n        <div data-kid=\"147\">© 2026 E-FITNESS. POWERED BY NEURAL ENGINE V4.</div>\n        <div class=\"flex gap-8 mt-4 md:mt-0\" data-kid=\"148\">\n          <a href=\"/\" class=\"hover:text-neon\" data-kid=\"149\">Main Menu</a>\n          <a href=\"#\" class=\"hover:text-neon\" data-kid=\"150\">Security Protocol</a>\n        </div>\n      </div>\n    </footer>\n\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"151\"></script>\n<script type=\"module\" data-kid=\"152\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis({ autoRaf: true });\n\n  let currentStep = 1;\n  const totalSteps = 3;\n  const steps = document.querySelectorAll('.step-card');\n  const dots = document.querySelectorAll('.progress-dot');\n  const nextBtn = document.getElementById('next-btn');\n  const prevBtn = document.getElementById('prev-btn');\n  const loadingOverlay = document.getElementById('loading-overlay');\n  const responseArea = document.getElementById('ai-response');\n\n  function updateStep() {\n    steps.forEach(s => s.classList.remove('active'));\n    dots.forEach(d => d.classList.remove('active'));\n    \n    const activeStep = document.querySelector(`.step-card[data-step=\"${currentStep}\"]`);\n    activeStep.classList.add('active');\n    \n    // Update dots up to current step\n    for(let i=1; i<=currentStep; i++) {\n      document.querySelector(`.progress-dot[data-step=\"${i}\"]`).classList.add('active');\n    }\n\n    // Animation for new step\n    gsap.fromTo(activeStep, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: \"power3.out\" });\n\n    // Update buttons\n    if(currentStep === 1) {\n      prevBtn.style.opacity = '0';\n      prevBtn.style.pointerEvents = 'none';\n    } else {\n      prevBtn.style.opacity = '1';\n      prevBtn.style.pointerEvents = 'auto';\n    }\n\n    if(currentStep === totalSteps) {\n      nextBtn.textContent = 'Generate Assessment';\n    } else {\n      nextBtn.textContent = 'Continue';\n    }\n  }\n\n  nextBtn.addEventListener('click', () => {\n    if(currentStep < totalSteps) {\n      currentStep++;\n      updateStep();\n    } else {\n      // Trigger Loading and Results\n      loadingOverlay.style.opacity = '1';\n      loadingOverlay.style.pointerEvents = 'auto';\n      \n      setTimeout(() => {\n        loadingOverlay.style.opacity = '0';\n        loadingOverlay.style.pointerEvents = 'none';\n        \n        responseArea.style.opacity = '1';\n        responseArea.style.transform = 'translateY(0)';\n        \n        // Scroll to response\n        lenis.scrollTo(responseArea, { offset: -100, duration: 1.5 });\n      }, 2500);\n    }\n  });\n\n  prevBtn.addEventListener('click', () => {\n    if(currentStep > 1) {\n      currentStep--;\n      updateStep();\n    }\n  });\n\n  // Entrance\n  gsap.from('.reveal', {\n    y: 30,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.2,\n    ease: \"power3.out\",\n    delay: 0.3\n  });\n</script>",
      "comments": [],
      "created": "2026-07-04T17:44:11.265250+00:00",
      "modified": "2026-07-04T17:44:42.698599+00:00",
      "id": "var_1254485b2f9a"
    },
    "var_df1e8f36100c": {
      "type": "variant",
      "label": "AI Workout Generator",
      "parentId": "var_3c185f02d859",
      "themeId": null,
      "rect": {
        "x": 32340,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-bg: #0A0A0A;\n    --color-surface: #1A1D24;\n    --color-accent: #C0FF00;\n    --font-heading: 'Sora', sans-serif;\n    --font-body: 'DM Sans', sans-serif;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: #FFFFFF;\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: clip;\n  }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .neon-glow {\n    box-shadow: 0 0 20px rgba(192, 255, 0, 0.2);\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n\n  /* Custom Range Style */\n  input[type=range] {\n    -webkit-appearance: none;\n    background: transparent;\n  }\n  input[type=range]::-webkit-slider-runnable-track {\n    width: 100%;\n    height: 4px;\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 2px;\n  }\n  input[type=range]::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    height: 16px;\n    width: 16px;\n    border-radius: 50%;\n    background: var(--color-accent);\n    cursor: pointer;\n    margin-top: -6px;\n    box-shadow: 0 0 10px rgba(192, 255, 0, 0.5);\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    <nav class=\"p-8\" data-kid=\"3\">\n       <div class=\"mx-auto flex max-w-7xl items-center justify-between glass rounded-full px-8 py-4\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2\" data-kid=\"5\">\n          <div class=\"h-8 w-8 bg-[#C0FF00] rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"6\">E</div>\n          <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"7\">E-fitness</span>\n        </div>\n        <a href=\"#\" class=\"text-sm font-medium text-zinc-400 hover:text-[#C0FF00] transition-colors\" data-kid=\"8\">← Dashboard</a>\n      </div>\n    </nav>\n\n    <main class=\"max-w-7xl mx-auto px-8 py-12\" data-kid=\"9\">\n      <div class=\"grid lg:grid-cols-[400px_1fr] gap-12\" data-kid=\"10\">\n        \n        <aside class=\"space-y-8\" data-kid=\"11\">\n          <div class=\"glass p-10 rounded-[2.5rem] reveal-left\" data-kid=\"12\">\n            <h1 class=\"font-heading text-4xl font-bold mb-6 leading-tight\" data-kid=\"13\">AI Workout <br data-kid=\"14\"><span class=\"text-[#C0FF00]\" data-kid=\"15\">Generator</span></h1>\n            <p class=\"text-zinc-500 text-sm mb-8 leading-relaxed\" data-kid=\"16\">Define your parameters and let our neural engine compute the optimal routine for your current state.</p>\n            \n            <form class=\"space-y-8\" data-kid=\"17\">\n              <div data-kid=\"18\">\n                <label class=\"block text-[10px] font-bold tracking-[0.2em] text-zinc-500 uppercase mb-3\" data-kid=\"19\">Fitness Level</label>\n                <div class=\"grid grid-cols-3 gap-2\" data-kid=\"20\">\n                  <button type=\"button\" class=\"px-3 py-3 rounded-xl border border-white/10 text-[10px] font-bold hover:border-[#C0FF00] transition-colors uppercase\" data-kid=\"21\">Beginner</button>\n                  <button type=\"button\" class=\"px-3 py-3 rounded-xl border-[#C0FF00] bg-[#C0FF00]/10 text-[#C0FF00] text-[10px] font-bold uppercase\" data-kid=\"22\">Pro</button>\n                  <button type=\"button\" class=\"px-3 py-3 rounded-xl border border-white/10 text-[10px] font-bold hover:border-[#C0FF00] transition-colors uppercase\" data-kid=\"23\">Elite</button>\n                </div>\n              </div>\n\n              <div data-kid=\"24\">\n                <label class=\"block text-[10px] font-bold tracking-[0.2em] text-zinc-500 uppercase mb-3\" data-kid=\"25\">Training Focus</label>\n                <div class=\"relative\" data-kid=\"26\">\n                  <select class=\"w-full bg-black/40 border border-white/10 rounded-2xl px-5 py-4 outline-none focus:border-[#C0FF00] appearance-none text-sm transition-colors\" data-kid=\"27\">\n                    <option data-kid=\"28\">Hypertrophy (Muscle Growth)</option>\n                    <option data-kid=\"29\">Metabolic Conditioning</option>\n                    <option data-kid=\"30\">Pure Strength</option>\n                    <option data-kid=\"31\">Endurance</option>\n                  </select>\n                  <i class=\"ti ti-chevron-down absolute right-5 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none\" data-kid=\"32\"></i>\n                </div>\n              </div>\n\n              <div data-kid=\"33\">\n                <label class=\"block text-[10px] font-bold tracking-[0.2em] text-zinc-500 uppercase mb-3\" data-kid=\"34\">Duration (Minutes)</label>\n                <div class=\"flex items-center gap-6 glass bg-black/20 p-5 rounded-2xl border border-white/5\" data-kid=\"35\">\n                  <input type=\"range\" class=\"flex-1\" min=\"15\" max=\"120\" step=\"15\" value=\"45\" data-kid=\"36\">\n                  <span class=\"font-heading font-bold text-2xl text-[#C0FF00] w-12 text-right\" data-kid=\"37\">45</span>\n                </div>\n              </div>\n\n              <button class=\"w-full bg-[#C0FF00] text-black py-5 rounded-full font-bold hover:shadow-[0_0_30px_rgba(192,255,0,0.3)] transition-all flex items-center justify-center gap-2\" data-kid=\"38\">\n                <i class=\"ti ti-stars\" data-kid=\"39\"></i> Generate Plan\n              </button>\n            </form>\n          </div>\n          \n          <div class=\"glass p-8 rounded-[2.5rem] flex items-center gap-5 reveal-left\" style=\"transition-delay: 0.2s\" data-kid=\"40\">\n            <div class=\"h-14 w-14 bg-[#C0FF00]/10 rounded-2xl flex items-center justify-center text-[#C0FF00]\" data-kid=\"41\">\n              <i class=\"ti ti-brain text-3xl\" data-kid=\"42\"></i>\n            </div>\n            <div data-kid=\"43\">\n              <div class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em]\" data-kid=\"44\">Neural Precision</div>\n              <div class=\"text-xl font-heading font-bold\" data-kid=\"45\">98.4% Confidence</div>\n            </div>\n          </div>\n        </aside>\n\n        \n        <section class=\"space-y-10\" data-kid=\"46\">\n          <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-4\" data-kid=\"47\">\n            <div data-kid=\"48\">\n              <span class=\"text-[#C0FF00] font-bold text-[10px] tracking-[0.3em] uppercase mb-2 block\" data-kid=\"49\">Protocol Computed</span>\n              <h2 class=\"font-heading text-5xl font-bold tracking-tight\" data-kid=\"50\">Hypertrophy <span class=\"text-zinc-500\" data-kid=\"51\">B</span></h2>\n            </div>\n            <div class=\"flex gap-3\" data-kid=\"52\">\n              <button class=\"glass px-6 py-3 rounded-full text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 hover:bg-white/5 transition-colors\" data-kid=\"53\">\n                <i class=\"ti ti-share text-sm\" data-kid=\"54\"></i> Share\n              </button>\n              <button class=\"glass px-6 py-3 rounded-full text-[10px] font-bold uppercase tracking-widest flex items-center gap-2 hover:bg-white/5 transition-colors border-[#C0FF00]/30 text-[#C0FF00]\" data-kid=\"55\">\n                <i class=\"ti ti-download text-sm\" data-kid=\"56\"></i> Save Plan\n              </button>\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"57\">\n            \n            <div class=\"glass p-10 rounded-[3rem] reveal-up relative overflow-hidden group\" data-kid=\"58\">\n              <div class=\"absolute top-0 right-0 w-32 h-32 bg-[#C0FF00]/5 blur-3xl rounded-full translate-x-16 -translate-y-16 group-hover:bg-[#C0FF00]/10 transition-colors\" data-kid=\"59\"></div>\n              <div class=\"flex justify-between items-start mb-8 relative\" data-kid=\"60\">\n                <div class=\"h-12 w-12 bg-zinc-800/80 rounded-2xl flex items-center justify-center font-heading font-bold text-lg\" data-kid=\"61\">01</div>\n                <div class=\"text-right\" data-kid=\"62\">\n                  <div class=\"text-[10px] font-bold text-zinc-500 uppercase mb-1 tracking-[0.2em]\" data-kid=\"63\">Primary Compound</div>\n                  <div class=\"text-2xl font-heading font-bold\" data-kid=\"64\">Barbell Squats</div>\n                </div>\n              </div>\n              <div class=\"flex gap-4 mb-10\" data-kid=\"65\">\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"66\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"67\">Sets</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"68\">4</div>\n                </div>\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"69\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"70\">Reps</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"71\">8-10</div>\n                </div>\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"72\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"73\">Rest</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"74\">90s</div>\n                </div>\n              </div>\n              <div class=\"text-sm text-zinc-400 bg-black/30 p-5 rounded-2xl border border-white/5 leading-relaxed relative\" data-kid=\"75\">\n                <i class=\"ti ti-bulb text-[#C0FF00] mr-2 text-lg align-middle\" data-kid=\"76\"></i>\n                Focus on depth. Keep your core braced and eyes forward throughout the entire movement.\n              </div>\n            </div>\n\n            \n             <div class=\"glass p-10 rounded-[3rem] reveal-up relative overflow-hidden group\" style=\"transition-delay: 0.1s\" data-kid=\"77\">\n              <div class=\"absolute top-0 right-0 w-32 h-32 bg-[#C0FF00]/5 blur-3xl rounded-full translate-x-16 -translate-y-16 group-hover:bg-[#C0FF00]/10 transition-colors\" data-kid=\"78\"></div>\n              <div class=\"flex justify-between items-start mb-8 relative\" data-kid=\"79\">\n                <div class=\"h-12 w-12 bg-zinc-800/80 rounded-2xl flex items-center justify-center font-heading font-bold text-lg\" data-kid=\"80\">02</div>\n                <div class=\"text-right\" data-kid=\"81\">\n                  <div class=\"text-[10px] font-bold text-zinc-500 uppercase mb-1 tracking-[0.2em]\" data-kid=\"82\">Posterior Chain</div>\n                  <div class=\"text-2xl font-heading font-bold\" data-kid=\"83\">Romanian Deadlift</div>\n                </div>\n              </div>\n              <div class=\"flex gap-4 mb-10\" data-kid=\"84\">\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"85\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"86\">Sets</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"87\">3</div>\n                </div>\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"88\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"89\">Reps</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"90\">12</div>\n                </div>\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"91\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"92\">Rest</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"93\">60s</div>\n                </div>\n              </div>\n              <div class=\"text-sm text-zinc-400 bg-black/30 p-5 rounded-2xl border border-white/5 leading-relaxed relative\" data-kid=\"94\">\n                <i class=\"ti ti-bulb text-[#C0FF00] mr-2 text-lg align-middle\" data-kid=\"95\"></i>\n                Hinge at the hips. Maintain a slight bend in knees. Feel the deep stretch in hamstrings.\n              </div>\n            </div>\n\n            \n             <div class=\"glass p-10 rounded-[3rem] reveal-up relative overflow-hidden group\" style=\"transition-delay: 0.2s\" data-kid=\"96\">\n              <div class=\"absolute top-0 right-0 w-32 h-32 bg-[#C0FF00]/5 blur-3xl rounded-full translate-x-16 -translate-y-16 group-hover:bg-[#C0FF00]/10 transition-colors\" data-kid=\"97\"></div>\n              <div class=\"flex justify-between items-start mb-8 relative\" data-kid=\"98\">\n                <div class=\"h-12 w-12 bg-zinc-800/80 rounded-2xl flex items-center justify-center font-heading font-bold text-lg\" data-kid=\"99\">03</div>\n                <div class=\"text-right\" data-kid=\"100\">\n                  <div class=\"text-[10px] font-bold text-zinc-500 uppercase mb-1 tracking-[0.2em]\" data-kid=\"101\">Accessory Isolation</div>\n                  <div class=\"text-2xl font-heading font-bold\" data-kid=\"102\">Leg Press</div>\n                </div>\n              </div>\n              <div class=\"flex gap-4 mb-10\" data-kid=\"103\">\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"104\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"105\">Sets</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"106\">3</div>\n                </div>\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"107\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"108\">Reps</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"109\">15</div>\n                </div>\n                <div class=\"flex-1 bg-black/40 p-5 rounded-2xl border border-white/5 text-center transition-transform hover:scale-[1.02]\" data-kid=\"110\">\n                  <div class=\"text-[10px] text-zinc-500 font-bold mb-1 tracking-widest uppercase\" data-kid=\"111\">Rest</div>\n                  <div class=\"text-2xl font-heading font-bold text-[#C0FF00]\" data-kid=\"112\">45s</div>\n                </div>\n              </div>\n              <div class=\"text-sm text-zinc-400 bg-black/30 p-5 rounded-2xl border border-white/5 leading-relaxed relative\" data-kid=\"113\">\n                <i class=\"ti ti-bulb text-[#C0FF00] mr-2 text-lg align-middle\" data-kid=\"114\"></i>\n                Control the eccentric phase. Do not lock out your knees at the top of the movement.\n              </div>\n            </div>\n\n             \n             <div class=\"glass p-10 rounded-[3rem] reveal-up bg-[#C0FF00]/5 border-[#C0FF00]/20 relative overflow-hidden\" style=\"transition-delay: 0.3s\" data-kid=\"115\">\n                <div class=\"absolute inset-0 bg-gradient-to-br from-[#C0FF00]/5 to-transparent pointer-events-none\" data-kid=\"116\"></div>\n                <div class=\"flex items-center gap-5 mb-8 relative\" data-kid=\"117\">\n                   <div class=\"h-14 w-14 bg-[#C0FF00] rounded-2xl flex items-center justify-center text-black shadow-[0_0_20px_rgba(192,255,0,0.3)]\" data-kid=\"118\">\n                     <i class=\"ti ti-stars text-3xl\" data-kid=\"119\"></i>\n                   </div>\n                   <h3 class=\"font-heading text-3xl font-bold\" data-kid=\"120\">Neural Insights</h3>\n                </div>\n                <p class=\"text-zinc-400 text-base leading-relaxed mb-10 relative\" data-kid=\"121\">\n                  Based on your \"Pro\" level and \"Hypertrophy\" focus, I've increased the volume on compound movements while shortening rest periods for accessory work. This configuration maximizes metabolic stress and motor unit recruitment.\n                </p>\n                <div class=\"flex items-center justify-between text-[10px] font-bold text-zinc-600 uppercase tracking-[0.3em] border-t border-white/10 pt-8 relative\" data-kid=\"122\">\n                  <div class=\"flex items-center gap-2\" data-kid=\"123\">\n                    <span class=\"h-1.5 w-1.5 bg-[#C0FF00] rounded-full animate-pulse\" data-kid=\"124\"></span>\n                    Verified Safety\n                  </div>\n                  <span data-kid=\"125\">Neural Hash: EF-94X2</span>\n                </div>\n             </div>\n          </div>\n        </section>\n      </div>\n    </main>\n\n    <footer class=\"py-16 border-t border-white/5 mt-20\" data-kid=\"126\">\n      <div class=\"max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8 text-[10px] text-zinc-700 font-bold tracking-[0.4em] uppercase\" data-kid=\"127\">\n        <div data-kid=\"128\">© 2026 E-fitness Neural Engine • v4.2.0</div>\n        <div class=\"flex gap-12\" data-kid=\"129\">\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"130\">Usage Logs</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"131\">Privacy Shield</a>\n        </div>\n      </div>\n    </footer>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"132\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"133\"></script>\n<script type=\"module\" data-kid=\"134\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  const lenis = new Lenis({ autoRaf: true });\n  gsap.registerPlugin(ScrollTrigger);\n  lenis.on('scroll', ScrollTrigger.update);\n\n  // Entrance Animations\n  gsap.from('.reveal-left', {\n    x: -60,\n    opacity: 0,\n    duration: 1.2,\n    stagger: 0.2,\n    ease: \"power4.out\"\n  });\n\n  gsap.from('.reveal-up', {\n    y: 60,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.15,\n    ease: \"power3.out\",\n    scrollTrigger: {\n      trigger: '.reveal-up',\n      start: \"top 90%\"\n    }\n  });\n\n  // Interactive Elements\n  const range = document.querySelector('input[type=range]');\n  const rangeVal = document.querySelector('span.text-2xl');\n  range.addEventListener('input', (e) => {\n    rangeVal.textContent = e.target.value;\n  });\n</script>",
