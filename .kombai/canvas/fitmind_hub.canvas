      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-bg: #0A0A0A;\n    --color-surface: #1A1D24;\n    --color-accent: #C0FF00;\n    --font-heading: 'Sora', sans-serif;\n    --font-body: 'DM Sans', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--color-bg);\n    color: #FFFFFF;\n    font-family: var(--font-body);\n    overflow-x: clip;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  .text-neon { color: var(--color-accent); }\n  .bg-neon { background-color: var(--color-accent); }\n  .border-neon { border-color: var(--color-accent); }\n\n  .bento-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    grid-template-rows: repeat(3, minmax(180px, auto));\n    gap: 1.5rem;\n  }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .carousel-container {\n    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    \n    <nav class=\"fixed top-0 z-50 w-full px-8 py-6\" data-kid=\"3\">\n      <div class=\"mx-auto flex max-w-7xl items-center justify-between glass rounded-full px-8 py-4\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2\" data-kid=\"5\">\n          <div class=\"h-8 w-8 bg-neon rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"6\">F</div>\n          <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"7\">FitMind <span class=\"text-neon\" data-kid=\"8\">Hub</span></span>\n        </div>\n        <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400\" data-kid=\"9\">\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"10\">Assessment</a>\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"11\">Generator</a>\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"12\">Companion</a>\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"13\">Live</a>\n        </div>\n        <a href=\"/login\" class=\"bg-neon text-black px-6 py-2.5 rounded-full text-sm font-bold hover:scale-105 transition-transform\" data-kid=\"14\">Get Started</a>\n      </div>\n    </nav>\n\n    \n    <section class=\"relative pt-32 pb-20 px-8\" data-kid=\"15\">\n      <div class=\"mx-auto max-w-7xl\" data-kid=\"16\">\n        <div class=\"bento-grid\" data-kid=\"17\">\n          \n          <div class=\"col-span-4 lg:col-span-3 row-span-2 glass rounded-[2.5rem] p-12 flex flex-col justify-end relative overflow-hidden\" data-kid=\"18\">\n            <div class=\"absolute top-0 right-0 w-96 h-96 bg-neon/10 blur-[120px] rounded-full\" data-kid=\"19\"></div>\n            <h1 class=\"font-heading text-5xl md:text-7xl font-bold leading-[1.1] mb-6 reveal-y\" data-kid=\"20\">\n              The Fusion of <span class=\"text-neon\" data-kid=\"21\">AI</span> and <br data-kid=\"22\">Human Wellness.\n            </h1>\n            <p class=\"text-lg text-zinc-400 max-w-xl mb-8 reveal-y\" data-kid=\"23\">\n              Transform your fitness journey with real-time AI assessments, personalized workout generation, and our intelligent wellness companion.\n            </p>\n            <div class=\"flex gap-4 reveal-y\" data-kid=\"24\">\n              <a href=\"/ai/wellness-assessment\" class=\"bg-neon text-black px-8 py-4 rounded-full font-bold hover:shadow-[0_0_20px_rgba(192,255,0,0.4)] transition-all\" data-kid=\"25\">Start Assessment</a>\n              <a href=\"/ai/wellness-companion\" class=\"glass px-8 py-4 rounded-full font-bold hover:bg-white/5 transition-all\" data-kid=\"26\">Chat with AI</a>\n            </div>\n          </div>\n\n          \n          <div class=\"col-span-2 lg:col-span-1 glass rounded-[2.5rem] p-8 flex flex-col justify-between reveal-x\" data-kid=\"27\">\n            <div class=\"flex justify-between items-start\" data-kid=\"28\">\n              <i class=\"ti ti-activity text-neon text-3xl\" data-kid=\"29\"></i>\n              <span class=\"text-neon text-xs font-bold px-2 py-1 border border-neon/30 rounded-full animate-pulse\" data-kid=\"30\">LIVE</span>\n            </div>\n            <div data-kid=\"31\">\n              <div class=\"text-3xl font-heading font-bold mb-1\" data-kid=\"32\">142<span class=\"text-lg font-normal text-zinc-500\" data-kid=\"33\">bpm</span></div>\n              <div class=\"text-sm text-zinc-400\" data-kid=\"34\">Heart Rate Stability</div>\n            </div>\n          </div>\n\n          \n          <div class=\"col-span-2 lg:col-span-1 glass rounded-[2.5rem] overflow-hidden relative reveal-x\" data-kid=\"35\">\n            <video src=\"https://videos.pexels.com/video-files/4804847/4804847-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/4804847/pexels-photo-4804847.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"36\"></video>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none\" data-kid=\"37\"></div>\n            <div class=\"absolute bottom-6 left-6 text-sm font-bold\" data-kid=\"38\">PREPARING FOR PEAK</div>\n          </div>\n\n          \n          <div class=\"col-span-4 lg:col-span-1 glass rounded-[2.5rem] p-8 flex items-center gap-6 reveal-y\" data-kid=\"39\">\n            <div class=\"h-16 w-16 rounded-2xl bg-neon/10 flex items-center justify-center\" data-kid=\"40\">\n              <i class=\"ti ti-stretching text-neon text-3xl\" data-kid=\"41\"></i>\n            </div>\n            <div data-kid=\"42\">\n              <div class=\"text-sm text-zinc-400 uppercase tracking-widest\" data-kid=\"43\">Recovery</div>\n              <div class=\"text-xl font-heading font-bold\" data-kid=\"44\">Optimal (94%)</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-20 px-8 bg-zinc-950\" data-kid=\"45\">\n      <div class=\"mx-auto max-w-7xl flex flex-col lg:flex-row gap-20\" data-kid=\"46\">\n        <div class=\"lg:w-1/2 lg:sticky lg:top-32 h-fit\" data-kid=\"47\">\n          <span class=\"text-neon font-bold tracking-widest uppercase text-sm mb-4 block\" data-kid=\"48\">Intelligent Core</span>\n          <h2 class=\"font-heading text-4xl md:text-5xl font-bold mb-8\" data-kid=\"49\">AI-Powered <br data-kid=\"50\">Evolution.</h2>\n          <div class=\"h-1 w-20 bg-neon mb-8\" data-kid=\"51\"></div>\n          <p class=\"text-zinc-400 text-lg mb-8 leading-relaxed\" data-kid=\"52\">\n            Our neural engines analyze your biometric data and goals to build the most efficient path to your peak performance.\n          </p>\n          <div class=\"space-y-4\" data-kid=\"53\">\n            <div class=\"flex items-center gap-4 text-neon\" data-kid=\"54\">\n              <i class=\"ti ti-check text-xl\" data-kid=\"55\"></i>\n              <span class=\"text-white font-medium\" data-kid=\"56\">Real-time Form Correction</span>\n            </div>\n            <div class=\"flex items-center gap-4 text-neon\" data-kid=\"57\">\n              <i class=\"ti ti-check text-xl\" data-kid=\"58\"></i>\n              <span class=\"text-white font-medium\" data-kid=\"59\">Dynamic Goal Adjustment</span>\n            </div>\n          </div>\n        </div>\n        <div class=\"lg:w-1/2 space-y-12\" data-kid=\"60\">\n          <div class=\"glass rounded-[2.5rem] p-10 reveal-up\" data-kid=\"61\">\n            <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"62\">Wellness Assessment</h3>\n            <p class=\"text-zinc-400 mb-6\" data-kid=\"63\">Deep dive into your current state. We analyze constraints, metabolic markers, and sleep patterns.</p>\n            <div class=\"bg-black/40 rounded-2xl p-6 border border-white/5\" data-kid=\"64\">\n              <div class=\"flex justify-between text-xs font-bold text-zinc-500 mb-2\" data-kid=\"65\">\n                <span data-kid=\"66\">ANALYZING METRICS</span>\n                <span data-kid=\"67\">87%</span>\n              </div>\n              <div class=\"w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden\" data-kid=\"68\">\n                <div class=\"h-full bg-neon w-[87%]\" data-kid=\"69\"></div>\n              </div>\n            </div>\n          </div>\n          <div class=\"glass rounded-[2.5rem] p-10 reveal-up\" data-kid=\"70\">\n            <h3 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"71\">Workout Generator</h3>\n            <p class=\"text-zinc-400 mb-6\" data-kid=\"72\">No generic plans. Every rep, set, and rest interval is computed for your specific physiological load.</p>\n            <div class=\"grid grid-cols-2 gap-4\" data-kid=\"73\">\n              <div class=\"bg-black/40 p-4 rounded-xl border border-white/5\" data-kid=\"74\">\n                <div class=\"text-neon text-xs font-bold mb-1\" data-kid=\"75\">STRENGTH</div>\n                <div class=\"text-lg font-bold\" data-kid=\"76\">Hypertrophy B</div>\n              </div>\n              <div class=\"bg-black/40 p-4 rounded-xl border border-white/5\" data-kid=\"77\">\n                <div class=\"text-neon text-xs font-bold mb-1\" data-kid=\"78\">DURATION</div>\n                <div class=\"text-lg font-bold\" data-kid=\"79\">45 Mins</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-20 px-8 relative overflow-hidden\" data-kid=\"80\">\n      <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full opacity-20 pointer-events-none\" data-kid=\"81\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gooey-molecule.svg\" class=\"w-full h-full animate-[spin_60s_linear_infinite] blur-3xl opacity-10\" style=\"filter: brightness(0) saturate(100%) invert(84%) sepia(85%) saturate(1514%) hue-rotate(24deg) brightness(108%) contrast(106%);\" data-kid=\"82\">\n      </div>\n      <div class=\"mx-auto max-w-4xl glass rounded-[3rem] p-1 lg:p-2 overflow-hidden reveal-up\" data-kid=\"83\">\n        <div class=\"bg-zinc-900/40 backdrop-blur-2xl rounded-[2.8rem] p-8 lg:p-12\" data-kid=\"84\">\n          <div class=\"flex items-center gap-4 mb-12\" data-kid=\"85\">\n            <div class=\"h-12 w-12 bg-neon rounded-full flex items-center justify-center text-black font-bold\" data-kid=\"86\">AI</div>\n            <div data-kid=\"87\">\n              <div class=\"font-heading font-bold\" data-kid=\"88\">FitMind Companion</div>\n              <div class=\"text-xs text-neon font-bold flex items-center gap-1\" data-kid=\"89\">\n                <span class=\"h-1.5 w-1.5 bg-neon rounded-full animate-pulse\" data-kid=\"90\"></span>\n                Always Ready\n              </div>\n            </div>\n          </div>\n          <div class=\"space-y-6 mb-12 chat-container\" data-kid=\"91\">\n            <div class=\"flex flex-col items-start max-w-[80%]\" data-kid=\"92\">\n              <div class=\"bg-zinc-800/50 rounded-2xl rounded-tl-none p-4 text-sm leading-relaxed\" data-kid=\"93\">\n                Good morning! I noticed your HRV was slightly lower last night. Would you like to adjust today's high-intensity session to active recovery?\n              </div>\n              <span class=\"text-[10px] text-zinc-500 mt-2 ml-1\" data-kid=\"94\">AI COMPANION • 8:32 AM</span>\n            </div>\n            <div class=\"flex flex-col items-end ml-auto max-w-[80%]\" data-kid=\"95\">\n              <div class=\"bg-neon text-black rounded-2xl rounded-tr-none p-4 text-sm font-medium\" data-kid=\"96\">\n                Yes, that sounds smart. What do you suggest for recovery?\n              </div>\n              <span class=\"text-[10px] text-zinc-500 mt-2 mr-1\" data-kid=\"97\">YOU • 8:33 AM</span>\n            </div>\n            <div class=\"flex flex-col items-start max-w-[80%]\" data-kid=\"98\">\n              <div class=\"bg-zinc-800/50 rounded-2xl rounded-tl-none p-4 text-sm leading-relaxed\" data-kid=\"99\">\n                I've queued a 20-minute restorative yoga flow and a 10-minute breathwork session. This will optimize your sympathetic nervous system for better sleep tonight.\n              </div>\n              <span class=\"text-[10px] text-zinc-500 mt-2 ml-1\" data-kid=\"100\">AI COMPANION • 8:33 AM</span>\n            </div>\n          </div>\n          <div class=\"relative\" data-kid=\"101\">\n            <input type=\"text\" placeholder=\"Ask your companion anything...\" class=\"w-full bg-black/40 border border-white/10 rounded-full px-8 py-5 outline-none focus:border-neon transition-colors text-sm\" data-kid=\"102\">\n            <button class=\"absolute right-3 top-1/2 -translate-y-1/2 h-10 w-10 bg-neon text-black rounded-full flex items-center justify-center\" data-kid=\"103\">\n              <i class=\"ti ti-arrow-right\" data-kid=\"104\"></i>\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-20 bg-zinc-950 overflow-hidden\" data-kid=\"105\">\n      <div class=\"mx-auto max-w-7xl px-8 mb-12 flex justify-between items-end\" data-kid=\"106\">\n        <div data-kid=\"107\">\n          <span class=\"text-neon font-bold tracking-widest uppercase text-sm mb-4 block\" data-kid=\"108\">Community</span>\n          <h2 class=\"font-heading text-4xl md:text-5xl font-bold\" data-kid=\"109\">Live Experiences.</h2>\n        </div>\n        <div class=\"flex gap-4\" data-kid=\"110\">\n          <button id=\"prevBtn\" class=\"h-12 w-12 border border-white/10 rounded-full flex items-center justify-center hover:bg-neon hover:text-black transition-all\" data-kid=\"111\"><i class=\"ti ti-chevron-left\" data-kid=\"112\"></i></button>\n          <button id=\"nextBtn\" class=\"h-12 w-12 border border-white/10 rounded-full flex items-center justify-center hover:bg-neon hover:text-black transition-all\" data-kid=\"113\"><i class=\"ti ti-chevron-right\" data-kid=\"114\"></i></button>\n        </div>\n      </div>\n      \n      <div id=\"carousel\" class=\"flex gap-8 overflow-x-auto snap-x snap-mandatory px-8 scrollbar-hide carousel-container pb-10\" data-kid=\"115\">\n        <div class=\"min-w-[400px] snap-start glass rounded-[2.5rem] overflow-hidden group\" data-kid=\"116\">\n          <div class=\"aspect-video relative overflow-hidden\" data-kid=\"117\">\n            <img src=\"https://images.unsplash.com/photo-1517130038641-a774d04afb3c?auto=format&w=800&q=80&fit=crop\" alt=\"Geert Pieters on Unsplash\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" data-kid=\"118\">\n            <div class=\"absolute top-6 left-6 bg-red-600 text-[10px] font-bold px-2 py-1 rounded\" data-kid=\"119\">LIVE</div>\n          </div>\n          <div class=\"p-8\" data-kid=\"120\">\n            <h3 class=\"font-heading font-bold text-xl mb-2\" data-kid=\"121\">Morning Power HIIT</h3>\n            <p class=\"text-sm text-zinc-400 mb-6\" data-kid=\"122\">High-intensity interval training designed to spike your metabolism for 24 hours.</p>\n            <div class=\"flex justify-between items-center\" data-kid=\"123\">\n              <span class=\"text-xs text-zinc-500 font-bold uppercase\" data-kid=\"124\">45 Mins • Intermediate</span>\n              <button class=\"text-neon text-sm font-bold flex items-center gap-2\" data-kid=\"125\">Join Now <i class=\"ti ti-arrow-right\" data-kid=\"126\"></i></button>\n            </div>\n          </div>\n        </div>\n        <div class=\"min-w-[400px] snap-start glass rounded-[2.5rem] overflow-hidden group\" data-kid=\"127\">\n          <div class=\"aspect-video relative overflow-hidden\" data-kid=\"128\">\n            <img src=\"https://images.unsplash.com/photo-1607909599990-e2c4778e546b?auto=format&w=800&q=80&fit=crop\" alt=\"Luemen Rutkowski on Unsplash\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" data-kid=\"129\">\n            <div class=\"absolute top-6 left-6 bg-neon text-black text-[10px] font-bold px-2 py-1 rounded\" data-kid=\"130\">RECORDED</div>\n          </div>\n          <div class=\"p-8\" data-kid=\"131\">\n            <h3 class=\"font-heading font-bold text-xl mb-2\" data-kid=\"132\">Restorative Flow</h3>\n            <p class=\"text-sm text-zinc-400 mb-6\" data-kid=\"133\">A meditative session focused on deepening your range of motion and calming the mind.</p>\n            <div class=\"flex justify-between items-center\" data-kid=\"134\">\n              <span class=\"text-xs text-zinc-500 font-bold uppercase\" data-kid=\"135\">30 Mins • All Levels</span>\n              <button class=\"text-neon text-sm font-bold flex items-center gap-2\" data-kid=\"136\">Watch Class <i class=\"ti ti-arrow-right\" data-kid=\"137\"></i></button>\n            </div>\n          </div>\n        </div>\n        <div class=\"min-w-[400px] snap-start glass rounded-[2.5rem] overflow-hidden group\" data-kid=\"138\">\n          <div class=\"aspect-video relative overflow-hidden\" data-kid=\"139\">\n            <img src=\"https://images.unsplash.com/photo-1554284126-aa88f22d8b74?auto=format&w=800&q=80&fit=crop\" alt=\"Sven Mieke on Unsplash\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" data-kid=\"140\">\n            <div class=\"absolute top-6 left-6 bg-neon text-black text-[10px] font-bold px-2 py-1 rounded\" data-kid=\"141\">RECORDED</div>\n          </div>\n          <div class=\"p-8\" data-kid=\"142\">\n            <h3 class=\"font-heading font-bold text-xl mb-2\" data-kid=\"143\">Hypertrophy Base</h3>\n            <p class=\"text-sm text-zinc-400 mb-6\" data-kid=\"144\">Scientific weight lifting targeting core muscle groups for sustained muscle growth.</p>\n            <div class=\"flex justify-between items-center\" data-kid=\"145\">\n              <span class=\"text-xs text-zinc-500 font-bold uppercase\" data-kid=\"146\">60 Mins • Advanced</span>\n              <button class=\"text-neon text-sm font-bold flex items-center gap-2\" data-kid=\"147\">Watch Class <i class=\"ti ti-arrow-right\" data-kid=\"148\"></i></button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 px-8\" data-kid=\"149\">\n      <div class=\"mx-auto max-w-7xl\" data-kid=\"150\">\n        <div class=\"text-center mb-20\" data-kid=\"151\">\n          <h2 class=\"font-heading text-4xl md:text-5xl font-bold mb-6\" data-kid=\"152\">Unlock Your Peak.</h2>\n          <p class=\"text-zinc-400 max-w-2xl mx-auto\" data-kid=\"153\">Choose the plan that fits your ambition. Seamless local payments with Mobile Money.</p>\n        </div>\n        \n        <div class=\"flex flex-col lg:flex-row items-end gap-6\" data-kid=\"154\">\n          <div class=\"flex-1 glass rounded-t-[2.5rem] p-10 h-80 flex flex-col justify-between reveal-up\" style=\"--d: 0.1s\" data-kid=\"155\">\n            <div data-kid=\"156\">\n              <div class=\"font-heading font-bold text-xl mb-2\" data-kid=\"157\">Starter</div>\n              <div class=\"text-zinc-400 text-sm\" data-kid=\"158\">AI Wellness Assessments <br data-kid=\"159\">Basic Workout Generation</div>\n            </div>\n            <div class=\"text-3xl font-heading font-bold\" data-kid=\"160\">Free</div>\n          </div>\n          <div class=\"flex-1 glass border-neon/50 bg-neon/5 rounded-t-[2.5rem] p-10 h-[28rem] flex flex-col justify-between relative reveal-up\" style=\"--d: 0.2s\" data-kid=\"161\">\n            <div class=\"absolute -top-4 left-1/2 -translate-x-1/2 bg-neon text-black px-4 py-1 rounded-full text-[10px] font-bold\" data-kid=\"162\">MOST POPULAR</div>\n            <div data-kid=\"163\">\n              <div class=\"font-heading font-bold text-2xl mb-2\" data-kid=\"164\">Pro</div>\n              <div class=\"text-zinc-400 text-sm leading-relaxed mb-6\" data-kid=\"165\">\n                Unlimited AI Workout Generation<br data-kid=\"166\">\n                Full Wellness Companion Access<br data-kid=\"167\">\n                All Recorded Sessions\n              </div>\n              <ul class=\"space-y-3 text-sm\" data-kid=\"168\">\n                <li class=\"flex items-center gap-2\" data-kid=\"169\"><i class=\"ti ti-check text-neon\" data-kid=\"170\"></i> Neural Biometric Sync</li>\n                <li class=\"flex items-center gap-2\" data-kid=\"171\"><i class=\"ti ti-check text-neon\" data-kid=\"172\"></i> Priority Chat Support</li>\n              </ul>\n            </div>\n            <div data-kid=\"173\">\n              <div class=\"text-4xl font-heading font-bold mb-6\" data-kid=\"174\">$12<span class=\"text-sm font-normal text-zinc-500\" data-kid=\"175\">/mo</span></div>\n              <button class=\"w-full bg-neon text-black py-4 rounded-full font-bold hover:scale-[1.02] transition-transform\" data-kid=\"176\">Choose Pro</button>\n            </div>\n          </div>\n          <div class=\"flex-1 glass rounded-t-[2.5rem] p-10 h-[32rem] flex flex-col justify-between reveal-up\" style=\"--d: 0.3s\" data-kid=\"177\">\n            <div data-kid=\"178\">\n              <div class=\"font-heading font-bold text-2xl mb-2\" data-kid=\"179\">Elite</div>\n              <div class=\"text-zinc-400 text-sm leading-relaxed mb-6\" data-kid=\"180\">\n                Everything in Pro<br data-kid=\"181\">\n                All Live Interactive Sessions<br data-kid=\"182\">\n                1-on-1 Human Coach Sync\n              </div>\n              <ul class=\"space-y-3 text-sm\" data-kid=\"183\">\n                <li class=\"flex items-center gap-2\" data-kid=\"184\"><i class=\"ti ti-check text-neon\" data-kid=\"185\"></i> Daily Metabolic Analysis</li>\n                <li class=\"flex items-center gap-2\" data-kid=\"186\"><i class=\"ti ti-check text-neon\" data-kid=\"187\"></i> Custom Supplement Plans</li>\n              </ul>\n            </div>\n            <div data-kid=\"188\">\n              <div class=\"text-4xl font-heading font-bold mb-6\" data-kid=\"189\">$29<span class=\"text-sm font-normal text-zinc-500\" data-kid=\"190\">/mo</span></div>\n              <button class=\"w-full glass py-4 rounded-full font-bold hover:bg-white/5 transition-all\" data-kid=\"191\">Choose Elite</button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"mt-12 flex flex-col items-center gap-4 reveal-up\" data-kid=\"192\">\n          <div class=\"text-xs text-zinc-500 font-bold tracking-widest uppercase\" data-kid=\"193\">Pay securely with Mobile Money</div>\n          <div class=\"flex gap-6 opacity-40 grayscale hover:grayscale-0 transition-all\" data-kid=\"194\">\n             <i class=\"ti ti-device-mobile-dollar text-3xl\" data-kid=\"195\"></i>\n             <i class=\"ti ti-phone text-3xl\" data-kid=\"196\"></i>\n             <i class=\"ti ti-swipe text-3xl\" data-kid=\"197\"></i>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-20 px-8 border-t border-white/5\" data-kid=\"198\">\n      <div class=\"mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"199\">\n        <div class=\"col-span-1 md:col-span-2\" data-kid=\"200\">\n          <div class=\"flex items-center gap-2 mb-6\" data-kid=\"201\">\n            <div class=\"h-8 w-8 bg-neon rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"202\">F</div>\n            <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"203\">FitMind <span class=\"text-neon\" data-kid=\"204\">Hub</span></span>\n          </div>\n          <p class=\"text-zinc-500 max-w-sm leading-relaxed\" data-kid=\"205\">\n            The world's first truly intelligent fitness ecosystem. We believe data-driven wellness is a right, not a luxury.\n          </p>\n        </div>\n        <div data-kid=\"206\">\n          <h4 class=\"font-bold mb-6\" data-kid=\"207\">Experience</h4>\n          <ul class=\"space-y-4 text-zinc-500 text-sm\" data-kid=\"208\">\n            <li data-kid=\"209\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"210\">AI Assessment</a></li>\n            <li data-kid=\"211\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"212\">Workout Generator</a></li>\n            <li data-kid=\"213\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"214\">Live Classes</a></li>\n            <li data-kid=\"215\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"216\">Companion Chat</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"217\">\n          <h4 class=\"font-bold mb-6\" data-kid=\"218\">Connect</h4>\n          <ul class=\"space-y-4 text-zinc-500 text-sm\" data-kid=\"219\">\n            <li data-kid=\"220\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"221\">Instagram</a></li>\n            <li data-kid=\"222\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"223\">Twitter</a></li>\n            <li data-kid=\"224\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"225\">Discord Community</a></li>\n            <li data-kid=\"226\"><a href=\"#\" class=\"hover:text-neon\" data-kid=\"227\">Contact Support</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"mx-auto max-w-7xl mt-20 pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between text-[10px] text-zinc-600 font-bold tracking-widest uppercase\" data-kid=\"228\">\n        <div data-kid=\"229\">© 2026 FITMIND HUB. ALL RIGHTS RESERVED.</div>\n        <div class=\"flex gap-8 mt-4 md:mt-0\" data-kid=\"230\">\n          <a href=\"#\" data-kid=\"231\">Privacy Policy</a>\n          <a href=\"#\" data-kid=\"232\">Terms of Service</a>\n        </div>\n      </div>\n    </footer>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"233\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"234\"></script>\n<script type=\"module\" data-kid=\"235\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Initialize Lenis\n  const lenis = new Lenis({\n    autoRaf: true,\n  });\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Sync ScrollTrigger with Lenis\n  lenis.on('scroll', ScrollTrigger.update);\n\n  // Entrance Animations\n  const revealY = document.querySelectorAll('.reveal-y');\n  const revealX = document.querySelectorAll('.reveal-x');\n  const revealUp = document.querySelectorAll('.reveal-up');\n\n  gsap.from(revealY, {\n    y: 40,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.2,\n    ease: \"power4.out\",\n    delay: 0.5\n  });\n\n  gsap.from(revealX, {\n    x: 40,\n    opacity: 0,\n    duration: 1.2,\n    stagger: 0.15,\n    ease: \"power4.out\",\n    delay: 0.8\n  });\n\n  // Scroll Animations\n  revealUp.forEach(el => {\n    gsap.from(el, {\n      y: 60,\n      opacity: 0,\n      duration: 1,\n      ease: \"power3.out\",\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 85%\",\n        toggleActions: \"play none none reverse\"\n      }\n    });\n  });\n\n  // Carousel Navigation\n  const carousel = document.getElementById('carousel');\n  const nextBtn = document.getElementById('nextBtn');\n  const prevBtn = document.getElementById('prevBtn');\n\n  nextBtn.addEventListener('click', () => {\n    carousel.scrollBy({ left: 450, behavior: 'smooth' });\n  });\n\n  prevBtn.addEventListener('click', () => {\n    carousel.scrollBy({ left: -450, behavior: 'smooth' });\n  });\n\n</script>",
