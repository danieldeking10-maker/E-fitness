    "var_8dfbecc4891c": {
      "type": "variant",
      "label": "Live Sessions Dashboard",
      "parentId": "var_c725e131d9a9",
      "themeId": null,
      "rect": {
        "x": 24640,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.4);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .instructor-card {\n    min-width: 280px;\n    transition: transform 0.4s ease;\n  }\n\n  .instructor-card:hover { transform: translateY(-8px); }\n\n  .live-indicator {\n    background: #FF3B30;\n    box-shadow: 0 0 15px rgba(255, 59, 48, 0.4);\n  }\n\n  .capacity-bar {\n    height: 4px;\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 2px;\n    overflow: hidden;\n  }\n\n  .capacity-fill {\n    height: 100%;\n    background: #C0FF00;\n  }\n</style>\n\n<div class=\"flex h-screen overflow-hidden\" data-kid=\"1\">\n  \n  <aside class=\"w-20 border-r border-white/5 flex flex-col items-center py-8 gap-10\" data-kid=\"2\">\n    <div class=\"h-10 w-10 bg-[#C0FF00] rounded-xl flex items-center justify-center text-black font-bold\" data-kid=\"3\">E</div>\n    <nav class=\"flex flex-col gap-6 text-zinc-500\" data-kid=\"4\">\n      <i class=\"ti ti-layout-dashboard text-2xl hover:text-white cursor-pointer\" data-kid=\"5\"></i>\n      <i class=\"ti ti-video text-2xl text-[#C0FF00] cursor-pointer\" data-kid=\"6\"></i>\n      <i class=\"ti ti-history text-2xl hover:text-white cursor-pointer\" data-kid=\"7\"></i>\n      <i class=\"ti ti-users text-2xl hover:text-white cursor-pointer\" data-kid=\"8\"></i>\n    </nav>\n    <div class=\"mt-auto\" data-kid=\"9\">\n      <img src=\"https://i.pravatar.cc/80?u=current_user\" class=\"h-10 w-10 rounded-full border border-white/10\" data-kid=\"10\">\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 overflow-y-auto bg-zinc-950/30\" data-kid=\"11\">\n    <header class=\"px-12 py-8 flex items-center justify-between\" data-kid=\"12\">\n      <h1 class=\"font-heading text-3xl font-bold\" data-kid=\"13\">Live <span class=\"text-[#C0FF00]\" data-kid=\"14\">Classes</span></h1>\n      <div class=\"flex gap-4\" data-kid=\"15\">\n        <div class=\"relative\" data-kid=\"16\">\n          <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500\" data-kid=\"17\"></i>\n          <input type=\"text\" placeholder=\"Search sessions...\" class=\"bg-white/5 border border-white/5 rounded-full pl-12 pr-6 py-2.5 text-sm outline-none focus:border-[#C0FF00]/30 w-64\" data-kid=\"18\">\n        </div>\n        <button class=\"bg-[#C0FF00] text-black px-6 py-2.5 rounded-full font-bold text-sm\" data-kid=\"19\">Create Session</button>\n      </div>\n    </header>\n\n    \n    <section class=\"px-12 mb-12\" data-kid=\"20\">\n      <h2 class=\"text-xs font-bold uppercase tracking-widest text-zinc-500 mb-6\" data-kid=\"21\">Instructor Spotlight</h2>\n      <div class=\"flex gap-6 overflow-x-auto pb-4 scrollbar-hide\" data-kid=\"22\">\n        <div class=\"instructor-card glass p-6 rounded-[2rem] flex flex-col items-center text-center\" data-kid=\"23\">\n          <img src=\"https://i.pravatar.cc/120?u=sarah\" class=\"h-24 w-24 rounded-full mb-4 border-2 border-[#C0FF00]\" data-kid=\"24\">\n          <div class=\"font-heading font-bold\" data-kid=\"25\">Sarah Chen</div>\n          <div class=\"text-[10px] text-zinc-500 uppercase font-bold tracking-tighter mb-4\" data-kid=\"26\">HIIT & Metabolic Spike</div>\n          <button class=\"text-[#C0FF00] text-xs font-bold flex items-center gap-1\" data-kid=\"27\">Follow <i class=\"ti ti-plus\" data-kid=\"28\"></i></button>\n        </div>\n        <div class=\"instructor-card glass p-6 rounded-[2rem] flex flex-col items-center text-center\" data-kid=\"29\">\n          <img src=\"https://i.pravatar.cc/120?u=marcus\" class=\"h-24 w-24 rounded-full mb-4 border-2 border-transparent\" data-kid=\"30\">\n          <div class=\"font-heading font-bold\" data-kid=\"31\">Marcus Thorne</div>\n          <div class=\"text-[10px] text-zinc-500 uppercase font-bold tracking-tighter mb-4\" data-kid=\"32\">Hypertrophy Base</div>\n          <button class=\"text-zinc-500 text-xs font-bold flex items-center gap-1\" data-kid=\"33\">Followed <i class=\"ti ti-check\" data-kid=\"34\"></i></button>\n        </div>\n        <div class=\"instructor-card glass p-6 rounded-[2rem] flex flex-col items-center text-center\" data-kid=\"35\">\n          <img src=\"https://i.pravatar.cc/120?u=elara\" class=\"h-24 w-24 rounded-full mb-4 border-2 border-transparent\" data-kid=\"36\">\n          <div class=\"font-heading font-bold\" data-kid=\"37\">Elara Vance</div>\n          <div class=\"text-[10px] text-zinc-500 uppercase font-bold tracking-tighter mb-4\" data-kid=\"38\">Flow & Recovery</div>\n          <button class=\"text-[#C0FF00] text-xs font-bold flex items-center gap-1\" data-kid=\"39\">Follow <i class=\"ti ti-plus\" data-kid=\"40\"></i></button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"px-12 pb-20\" data-kid=\"41\">\n      <h2 class=\"text-xs font-bold uppercase tracking-widest text-zinc-500 mb-6\" data-kid=\"42\">Upcoming in 24h</h2>\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\" data-kid=\"43\">\n        <div class=\"glass p-8 rounded-[2.5rem] flex gap-8 group\" data-kid=\"44\">\n          <div class=\"w-40 aspect-square rounded-3xl overflow-hidden relative\" data-kid=\"45\">\n            <img src=\"https://images.unsplash.com/photo-1517130038641-a774d04afb3c?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" data-kid=\"46\">\n            <div class=\"absolute inset-0 bg-black/20\" data-kid=\"47\"></div>\n          </div>\n          <div class=\"flex-1 flex flex-col justify-center\" data-kid=\"48\">\n            <div class=\"flex justify-between items-start mb-2\" data-kid=\"49\">\n              <div class=\"font-heading font-bold text-xl\" data-kid=\"50\">Power Morning</div>\n              <span class=\"live-indicator text-[10px] font-bold px-2 py-1 rounded\" data-kid=\"51\">LIVE</span>\n            </div>\n            <p class=\"text-xs text-zinc-500 mb-6\" data-kid=\"52\">Start your day with a high-intensity burn and mobility flow.</p>\n            <div class=\"space-y-4\" data-kid=\"53\">\n              <div class=\"flex justify-between text-[10px] font-bold text-zinc-600\" data-kid=\"54\">\n                <span data-kid=\"55\">CAPACITY</span>\n                <span data-kid=\"56\">42 / 50</span>\n              </div>\n              <div class=\"capacity-bar\" data-kid=\"57\">\n                <div class=\"capacity-fill w-[84%]\" data-kid=\"58\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"glass p-8 rounded-[2.5rem] flex gap-8 group opacity-80\" data-kid=\"59\">\n          <div class=\"w-40 aspect-square rounded-3xl overflow-hidden\" data-kid=\"60\">\n            <img src=\"https://images.unsplash.com/photo-1603477007113-f7385b1711a8?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" data-kid=\"61\">\n          </div>\n          <div class=\"flex-1 flex flex-col justify-center\" data-kid=\"62\">\n            <div class=\"flex justify-between items-start mb-2\" data-kid=\"63\">\n              <div class=\"font-heading font-bold text-xl\" data-kid=\"64\">Elite Strength</div>\n              <span class=\"bg-zinc-800 text-[10px] font-bold px-2 py-1 rounded\" data-kid=\"65\">16:00 PM</span>\n            </div>\n            <p class=\"text-xs text-zinc-500 mb-6\" data-kid=\"66\">Heavy lifting focus targeting primary muscle groups.</p>\n            <button class=\"w-full border border-white/10 py-3 rounded-full text-xs font-bold hover:bg-[#C0FF00] hover:text-black transition-all\" data-kid=\"67\">Book Spot</button>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  \n  <aside class=\"w-96 border-l border-white/5 bg-black/40 p-10 hidden xl:block\" data-kid=\"68\">\n    <h2 class=\"font-heading font-bold text-xl mb-8\" data-kid=\"69\">My <span class=\"text-[#C0FF00]\" data-kid=\"70\">Bookings</span></h2>\n    <div class=\"space-y-6\" data-kid=\"71\">\n      <div class=\"bg-white/5 p-6 rounded-3xl border border-white/5 relative overflow-hidden\" data-kid=\"72\">\n        <div class=\"absolute top-0 right-0 h-1 w-full bg-[#C0FF00]\" data-kid=\"73\"></div>\n        <div class=\"text-[10px] font-bold text-zinc-500 mb-2 uppercase\" data-kid=\"74\">TODAY • 08:30 AM</div>\n        <div class=\"font-bold mb-1\" data-kid=\"75\">Morning Power HIIT</div>\n        <div class=\"text-xs text-zinc-500 mb-4\" data-kid=\"76\">Instructor: Sarah Chen</div>\n        <button class=\"bg-[#C0FF00] text-black w-full py-3 rounded-full text-xs font-bold\" data-kid=\"77\">Launch Stream</button>\n      </div>\n      \n      <div class=\"p-6 rounded-3xl border border-dashed border-white/10 text-center\" data-kid=\"78\">\n        <p class=\"text-xs text-zinc-500 mb-4\" data-kid=\"79\">No other bookings found for today.</p>\n        <button class=\"text-[#C0FF00] text-xs font-bold\" data-kid=\"80\">Discover More Classes</button>\n      </div>\n    </div>\n    \n    <div class=\"mt-20\" data-kid=\"81\">\n       <div class=\"glass p-8 rounded-[2rem] bg-gradient-to-br from-[#C0FF00]/10 to-transparent\" data-kid=\"82\">\n         <i class=\"ti ti-crown text-3xl text-[#C0FF00] mb-4\" data-kid=\"83\"></i>\n         <div class=\"font-heading font-bold mb-2\" data-kid=\"84\">Go Infinite</div>\n         <p class=\"text-xs text-zinc-400 mb-6 leading-relaxed\" data-kid=\"85\">Unlock unlimited live access, 1-on-1 coach sync, and biometric hardware integration.</p>\n         <button class=\"bg-white text-black px-6 py-2.5 rounded-full text-[10px] font-bold\" data-kid=\"86\">Upgrade Now</button>\n       </div>\n    </div>\n  </aside>\n</div>",
