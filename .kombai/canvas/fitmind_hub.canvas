    "var_fd8daebc0d0c": {
      "type": "variant",
      "label": "AI Wellness Companion",
      "parentId": "var_3c185f02d859",
      "themeId": null,
      "rect": {
        "x": 29260,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-bg: #0A0A0A;\n    --color-surface: #1A1D24;\n    --color-accent: #C0FF00;\n    --font-heading: 'Sora', sans-serif;\n    --font-body: 'DM Sans', sans-serif;\n    --glass-border: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--color-bg);\n    color: #FFFFFF;\n    font-family: var(--font-body);\n    overflow: hidden; /* Immersive chat layout */\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  .text-neon { color: var(--color-accent); }\n  .bg-neon { background-color: var(--color-accent); }\n  \n  .glass-panel {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(20px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .chat-bubble-ai {\n    background: var(--color-surface);\n    border: 1px solid var(--glass-border);\n    border-radius: 1.5rem 1.5rem 1.5rem 0.25rem;\n  }\n\n  .chat-bubble-user {\n    background: var(--color-accent);\n    color: #000000;\n    border-radius: 1.5rem 1.5rem 0.25rem 1.5rem;\n    font-weight: 500;\n  }\n\n  .quick-chip {\n    background: rgba(255, 255, 255, 0.05);\n    border: 1px solid var(--glass-border);\n    transition: all 0.3s ease;\n  }\n\n  .quick-chip:hover {\n    background: rgba(192, 255, 0, 0.1);\n    border-color: var(--color-accent);\n    color: var(--color-accent);\n    transform: translateY(-2px);\n  }\n\n  .typing-dot {\n    width: 6px;\n    height: 6px;\n    background: var(--color-accent);\n    border-radius: 50%;\n    display: inline-block;\n    animation: typing 1.4s infinite both;\n  }\n\n  .typing-dot:nth-child(2) { animation-delay: 0.2s; }\n  .typing-dot:nth-child(3) { animation-delay: 0.4s; }\n\n  @keyframes typing {\n    0%, 80%, 100% { transform: scale(0); opacity: 0.3; }\n    40% { transform: scale(1); opacity: 1; }\n  }\n\n  /* Custom scrollbar for chat area */\n  .chat-history::-webkit-scrollbar {\n    width: 4px;\n  }\n  .chat-history::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .chat-history::-webkit-scrollbar-thumb {\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"flex h-screen overflow-hidden\" data-kid=\"1\">\n  \n  <aside class=\"w-20 lg:w-64 border-r border-white/5 flex flex-col items-center lg:items-stretch py-8 px-4 gap-12 bg-black/20\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3 px-2\" data-kid=\"3\">\n      <div class=\"h-10 w-10 bg-neon rounded-xl flex items-center justify-center text-black font-extrabold text-xl font-heading shadow-[0_0_15px_rgba(192,255,0,0.3)]\" data-kid=\"4\">E</div>\n      <span class=\"hidden lg:block font-heading font-bold text-xl tracking-tight\" data-kid=\"5\">E-fitness</span>\n    </div>\n\n    <nav class=\"flex flex-col gap-4\" data-kid=\"6\">\n      <a href=\"/\" class=\"flex items-center gap-4 px-4 py-3 rounded-2xl text-zinc-500 hover:text-white hover:bg-white/5 transition-all\" data-kid=\"7\">\n        <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"8\"></i>\n        <span class=\"hidden lg:block font-medium\" data-kid=\"9\">Dashboard</span>\n      </a>\n      <a href=\"/ai/wellness-assessment\" class=\"flex items-center gap-4 px-4 py-3 rounded-2xl text-zinc-500 hover:text-white hover:bg-white/5 transition-all\" data-kid=\"10\">\n        <i class=\"ti ti-heart-rate-monitor text-2xl\" data-kid=\"11\"></i>\n        <span class=\"hidden lg:block font-medium\" data-kid=\"12\">Assessment</span>\n      </a>\n      <a href=\"/ai/workout-generator\" class=\"flex items-center gap-4 px-4 py-3 rounded-2xl text-zinc-500 hover:text-white hover:bg-white/5 transition-all\" data-kid=\"13\">\n        <i class=\"ti ti-stretching text-2xl\" data-kid=\"14\"></i>\n        <span class=\"hidden lg:block font-medium\" data-kid=\"15\">Generator</span>\n      </a>\n      <a href=\"/ai/wellness-companion\" class=\"flex items-center gap-4 px-4 py-3 rounded-2xl text-neon bg-neon/10 transition-all\" data-kid=\"16\">\n        <i class=\"ti ti-messages text-2xl\" data-kid=\"17\"></i>\n        <span class=\"hidden lg:block font-bold\" data-kid=\"18\">Companion</span>\n      </a>\n    </nav>\n\n    <div class=\"mt-auto px-2\" data-kid=\"19\">\n      <div class=\"p-4 glass-panel rounded-2xl hidden lg:block\" data-kid=\"20\">\n        <div class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2\" data-kid=\"21\">Pro Status</div>\n        <div class=\"w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden mb-3\" data-kid=\"22\">\n          <div class=\"h-full bg-neon w-3/4\" data-kid=\"23\"></div>\n        </div>\n        <p class=\"text-[11px] text-zinc-400\" data-kid=\"24\">750 AI queries remaining this month.</p>\n      </div>\n      <div class=\"mt-6 flex items-center gap-3 px-2\" data-kid=\"25\">\n        <div class=\"h-10 w-10 rounded-full bg-zinc-800 overflow-hidden border border-white/10\" data-kid=\"26\">\n          <img src=\"https://i.pravatar.cc/100?u=fitness\" class=\"w-full h-full object-cover\" alt=\"User\" data-kid=\"27\">\n        </div>\n        <div class=\"hidden lg:block\" data-kid=\"28\">\n          <div class=\"text-xs font-bold\" data-kid=\"29\">Alex Thorne</div>\n          <div class=\"text-[10px] text-zinc-500 uppercase tracking-tighter\" data-kid=\"30\">Elite Member</div>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 flex flex-col relative bg-[radial-gradient(circle_at_bottom_right,_rgba(192,255,0,0.05),_transparent_40%)]\" data-kid=\"31\">\n    \n    \n    <header class=\"h-20 border-b border-white/5 flex items-center justify-between px-8 bg-black/40 backdrop-blur-md z-10\" data-kid=\"32\">\n      <div class=\"flex items-center gap-4\" data-kid=\"33\">\n        <div class=\"relative\" data-kid=\"34\">\n          <div class=\"h-12 w-12 bg-zinc-800 rounded-2xl flex items-center justify-center border border-white/10 overflow-hidden\" data-kid=\"35\">\n             <div class=\"h-8 w-8 bg-neon rounded-lg flex items-center justify-center text-black font-bold text-xs\" data-kid=\"36\">AI</div>\n          </div>\n          <div class=\"absolute -bottom-1 -right-1 h-4 w-4 bg-neon border-2 border-black rounded-full\" data-kid=\"37\"></div>\n        </div>\n        <div data-kid=\"38\">\n          <h2 class=\"font-heading font-bold text-lg\" data-kid=\"39\">FitMind AI</h2>\n          <div class=\"flex items-center gap-2 text-[10px] font-bold text-neon uppercase tracking-widest\" data-kid=\"40\">\n            <span class=\"flex gap-1\" data-kid=\"41\">\n              <span class=\"typing-dot\" data-kid=\"42\"></span>\n              <span class=\"typing-dot\" data-kid=\"43\"></span>\n              <span class=\"typing-dot\" data-kid=\"44\"></span>\n            </span>\n            Neural Analysis Active\n          </div>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-4 text-zinc-400\" data-kid=\"45\">\n        <button class=\"h-10 w-10 hover:text-white transition-colors\" data-kid=\"46\"><i class=\"ti ti-search text-xl\" data-kid=\"47\"></i></button>\n        <button class=\"h-10 w-10 hover:text-white transition-colors\" data-kid=\"48\"><i class=\"ti ti-dots-vertical text-xl\" data-kid=\"49\"></i></button>\n      </div>\n    </header>\n\n    \n    <section class=\"flex-1 overflow-y-auto px-8 py-10 space-y-8 chat-history scroll-smooth\" data-kid=\"50\">\n      \n      <div class=\"flex flex-col items-center mb-12\" data-kid=\"51\">\n        <span class=\"text-[10px] font-bold text-zinc-500 uppercase tracking-[0.3em] bg-zinc-900/50 px-4 py-1 rounded-full border border-white/5\" data-kid=\"52\">Today • 08:30 AM</span>\n      </div>\n\n      \n      <div class=\"flex gap-4 max-w-2xl animate-fade-in\" data-kid=\"53\">\n        <div class=\"h-10 w-10 rounded-xl bg-zinc-900 flex-shrink-0 flex items-center justify-center border border-white/5 font-heading font-bold text-xs\" data-kid=\"54\">AI</div>\n        <div class=\"space-y-2\" data-kid=\"55\">\n          <div class=\"chat-bubble-ai p-5 text-sm leading-relaxed text-zinc-200\" data-kid=\"56\">\n            Welcome back, Alex. I've finished reviewing your sleep metrics and yesterday's activity data. Your HRV is 12% above your 7-day average, indicating peak recovery. \n            <br data-kid=\"57\"><br data-kid=\"58\">\n            Ready for today's workout, or would you like to discuss a specific habit adjustment?\n          </div>\n          <span class=\"text-[10px] text-zinc-600 font-bold ml-1\" data-kid=\"59\">AI COMPANION • 08:31 AM</span>\n        </div>\n      </div>\n\n      \n      <div class=\"flex gap-4 flex-row-reverse ml-auto max-w-2xl animate-fade-in\" data-kid=\"60\">\n        <div class=\"h-10 w-10 rounded-xl bg-neon flex-shrink-0 flex items-center justify-center text-black font-extrabold text-xs\" data-kid=\"61\">AT</div>\n        <div class=\"space-y-2 text-right\" data-kid=\"62\">\n          <div class=\"chat-bubble-user p-5 text-sm leading-relaxed\" data-kid=\"63\">\n            That's great news. My right shoulder feels a bit tight after yesterday's overhead presses. Should we swap today's push day for something else?\n          </div>\n          <span class=\"text-[10px] text-zinc-600 font-bold mr-1\" data-kid=\"64\">YOU • 08:33 AM</span>\n        </div>\n      </div>\n\n      \n      <div class=\"flex gap-4 max-w-2xl animate-fade-in\" data-kid=\"65\">\n        <div class=\"h-10 w-10 rounded-xl bg-zinc-900 flex-shrink-0 flex items-center justify-center border border-white/5 font-heading font-bold text-xs\" data-kid=\"66\">AI</div>\n        <div class=\"space-y-2\" data-kid=\"67\">\n          <div class=\"chat-bubble-ai p-5 text-sm leading-relaxed text-zinc-200\" data-kid=\"68\">\n            Understood. Tightness in the deltoid after overhead work often suggests minor impingement or fatigue. Let's adjust:\n            <ul class=\"mt-4 space-y-2 list-disc pl-4 text-zinc-400\" data-kid=\"69\">\n              <li data-kid=\"70\">Swap <span class=\"text-neon font-medium\" data-kid=\"71\">Incline Bench</span> for <span class=\"text-white\" data-kid=\"72\">Dumbbell Floor Press</span> (reduces range of motion/stress).</li>\n              <li data-kid=\"73\">Include 3 sets of <span class=\"text-neon font-medium\" data-kid=\"74\">Face Pulls</span> for posterior chain stability.</li>\n              <li data-kid=\"75\">Perform a 5-minute <span class=\"text-neon font-medium\" data-kid=\"76\">Shoulder Mobility Flow</span> before starting.</li>\n            </ul>\n          </div>\n          <span class=\"text-[10px] text-zinc-600 font-bold ml-1\" data-kid=\"77\">AI COMPANION • 08:34 AM</span>\n        </div>\n      </div>\n\n      \n      <div class=\"flex gap-4 max-w-2xl typing-container\" data-kid=\"78\">\n        <div class=\"h-10 w-10 rounded-xl bg-zinc-900 flex-shrink-0 flex items-center justify-center border border-white/5 font-heading font-bold text-xs\" data-kid=\"79\">AI</div>\n        <div class=\"chat-bubble-ai px-6 py-4 flex items-center gap-1\" data-kid=\"80\">\n          <span class=\"typing-dot\" data-kid=\"81\"></span>\n          <span class=\"typing-dot\" data-kid=\"82\"></span>\n          <span class=\"typing-dot\" data-kid=\"83\"></span>\n        </div>\n      </div>\n\n    </section>\n\n    \n    <footer class=\"p-8 z-10 bg-gradient-to-t from-black to-transparent\" data-kid=\"84\">\n      \n      \n      <div class=\"flex flex-wrap gap-3 mb-6 justify-center\" data-kid=\"85\">\n        <button class=\"quick-chip px-5 py-2.5 rounded-full text-xs font-bold flex items-center gap-2\" data-kid=\"86\">\n          <i class=\"ti ti-refresh-dot\" data-kid=\"87\"></i> Shoulder Recovery Tips\n        </button>\n        <button class=\"quick-chip px-5 py-2.5 rounded-full text-xs font-bold flex items-center gap-2\" data-kid=\"88\">\n          <i class=\"ti ti-flame\" data-kid=\"89\"></i> Metabolic Analysis\n        </button>\n        <button class=\"quick-chip px-5 py-2.5 rounded-full text-xs font-bold flex items-center gap-2\" data-kid=\"90\">\n          <i class=\"ti ti-moon\" data-kid=\"91\"></i> Improve Sleep Quality\n        </button>\n        <button class=\"quick-chip px-5 py-2.5 rounded-full text-xs font-bold flex items-center gap-2\" data-kid=\"92\">\n          <i class=\"ti ti-chart-bar\" data-kid=\"93\"></i> Weekly Habit Summary\n        </button>\n      </div>\n\n      <div class=\"max-w-4xl mx-auto relative group\" data-kid=\"94\">\n        <div class=\"absolute -inset-1 bg-neon/10 rounded-[2.5rem] blur opacity-0 group-focus-within:opacity-100 transition-opacity\" data-kid=\"95\"></div>\n        <div class=\"relative glass-panel rounded-[2.5rem] p-2 flex items-center gap-2\" data-kid=\"96\">\n          <button class=\"h-12 w-12 rounded-full text-zinc-500 hover:text-white transition-colors flex items-center justify-center\" data-kid=\"97\">\n            <i class=\"ti ti-plus text-2xl\" data-kid=\"98\"></i>\n          </button>\n          <input type=\"text\" placeholder=\"Ask your FitMind Companion...\" class=\"flex-1 bg-transparent border-none outline-none text-sm px-4 text-white placeholder-zinc-600\" data-kid=\"99\">\n          <div class=\"flex items-center gap-1 pr-2\" data-kid=\"100\">\n            <button class=\"h-10 w-10 rounded-full text-zinc-500 hover:text-white transition-colors flex items-center justify-center\" data-kid=\"101\">\n              <i class=\"ti ti-microphone text-xl\" data-kid=\"102\"></i>\n            </button>\n            <button class=\"h-12 w-12 bg-neon rounded-full flex items-center justify-center text-black hover:scale-105 transition-transform active:scale-95 shadow-[0_0_20px_rgba(192,255,0,0.4)]\" data-kid=\"103\">\n              <i class=\"ti ti-send-2 text-xl\" data-kid=\"104\"></i>\n            </button>\n          </div>\n        </div>\n      </div>\n      \n      <p class=\"text-center text-[10px] text-zinc-600 font-bold uppercase tracking-widest mt-6\" data-kid=\"105\">\n        E-fitness Intelligence Engine • Powered by GPT-4o\n      </p>\n    </footer>\n\n  </main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"106\"></script>\n<script type=\"module\" data-kid=\"107\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Initialize Lenis for the chat history specifically\n  const chatHistory = document.querySelector('.chat-history');\n  const lenis = new Lenis({\n    wrapper: chatHistory,\n    content: chatHistory,\n    autoRaf: true,\n  });\n\n  // Entrance animations\n  gsap.from('.animate-fade-in', {\n    opacity: 0,\n    y: 20,\n    duration: 0.8,\n    stagger: 0.2,\n    ease: \"power3.out\"\n  });\n\n  gsap.from('aside > *', {\n    opacity: 0,\n    x: -20,\n    duration: 1,\n    stagger: 0.1,\n    ease: \"power4.out\"\n  });\n\n  // Simple typing loop for the header\n  const typingDots = document.querySelectorAll('.typing-dot');\n  gsap.to(typingDots, {\n    scale: 1.2,\n    opacity: 1,\n    duration: 0.4,\n    stagger: 0.1,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Scroll to bottom on load\n  chatHistory.scrollTop = chatHistory.scrollHeight;\n\n</script>",
      "comments": [],
      "created": "2026-07-04T17:44:05.835869+00:00",
      "modified": "2026-07-04T17:44:31.735966+00:00",
      "id": "var_fd8daebc0d0c"
    },
    "var_1254485b2f9a": {
      "type": "variant",
      "label": "AI Wellness Assessment",
      "parentId": "var_3c185f02d859",
      "themeId": null,
