      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .payment-method.active {\n    border-color: #C0FF00;\n    background: rgba(192, 255, 0, 0.05);\n  }\n</style>\n\n<div class=\"min-h-screen p-8 lg:p-20 flex flex-col items-center justify-center relative overflow-hidden\" data-kid=\"1\">\n  <div class=\"absolute top-0 right-0 w-[600px] h-[600px] bg-[#C0FF00]/5 blur-[120px] rounded-full\" data-kid=\"2\"></div>\n  \n  <div class=\"w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 gap-12 relative z-10\" data-kid=\"3\">\n    \n    <div class=\"space-y-8\" data-kid=\"4\">\n      <div data-kid=\"5\">\n        <h1 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"6\">Complete <br data-kid=\"7\"><span class=\"text-[#C0FF00]\" data-kid=\"8\">Subscription.</span></h1>\n        <p class=\"text-zinc-500\" data-kid=\"9\">Unlock the full E-fitness AI ecosystem.</p>\n      </div>\n\n      <div class=\"glass p-8 rounded-[2.5rem] space-y-6\" data-kid=\"10\">\n        <div class=\"flex justify-between items-center pb-6 border-b border-white/5\" data-kid=\"11\">\n          <div data-kid=\"12\">\n            <div class=\"font-bold\" data-kid=\"13\">Pro AI Annual</div>\n            <div class=\"text-xs text-zinc-500 font-bold uppercase tracking-widest mt-1\" data-kid=\"14\">Billed Yearly</div>\n          </div>\n          <div class=\"text-xl font-heading font-bold\" data-kid=\"15\">$120</div>\n        </div>\n        \n        <div class=\"space-y-4\" data-kid=\"16\">\n          <div class=\"flex justify-between text-sm\" data-kid=\"17\">\n            <span class=\"text-zinc-400\" data-kid=\"18\">Subtotal</span>\n            <span data-kid=\"19\">$120.00</span>\n          </div>\n          <div class=\"flex justify-between text-sm\" data-kid=\"20\">\n            <span class=\"text-zinc-400\" data-kid=\"21\">Processing Fee</span>\n            <span data-kid=\"22\">$0.00</span>\n          </div>\n          <div class=\"flex justify-between font-bold text-lg pt-4\" data-kid=\"23\">\n            <span data-kid=\"24\">Total</span>\n            <span class=\"text-[#C0FF00]\" data-kid=\"25\">$120.00</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4 text-xs text-zinc-500 font-bold uppercase tracking-tighter\" data-kid=\"26\">\n        <i class=\"ti ti-shield-lock text-xl text-[#C0FF00]\" data-kid=\"27\"></i>\n        256-BIT ENCRYPTED SECURE PAYMENT\n      </div>\n    </div>\n\n    \n    <div class=\"glass p-12 rounded-[3rem] shadow-2xl\" data-kid=\"28\">\n      <h2 class=\"font-heading text-xl font-bold mb-8\" data-kid=\"29\">Select Payment Method</h2>\n      \n      <div class=\"space-y-4 mb-10\" data-kid=\"30\">\n        <div class=\"payment-method active p-6 rounded-2xl border border-white/10 flex items-center justify-between cursor-pointer\" data-kid=\"31\">\n          <div class=\"flex items-center gap-4\" data-kid=\"32\">\n            <i class=\"ti ti-device-mobile text-2xl text-[#C0FF00]\" data-kid=\"33\"></i>\n            <div data-kid=\"34\">\n              <div class=\"font-bold text-sm\" data-kid=\"35\">Mobile Money</div>\n              <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"36\">MTN / Airtel / M-Pesa</div>\n            </div>\n          </div>\n          <div class=\"h-5 w-5 rounded-full border-4 border-[#C0FF00] bg-black\" data-kid=\"37\"></div>\n        </div>\n\n        <div class=\"payment-method p-6 rounded-2xl border border-white/5 flex items-center justify-between cursor-pointer opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all\" data-kid=\"38\">\n          <div class=\"flex items-center gap-4\" data-kid=\"39\">\n            <i class=\"ti ti-credit-card text-2xl\" data-kid=\"40\"></i>\n            <div data-kid=\"41\">\n              <div class=\"font-bold text-sm\" data-kid=\"42\">Credit / Debit Card</div>\n              <div class=\"text-[10px] text-zinc-500 font-bold uppercase\" data-kid=\"43\">Visa / Mastercard</div>\n            </div>\n          </div>\n          <div class=\"h-5 w-5 rounded-full border-2 border-white/10\" data-kid=\"44\"></div>\n        </div>\n      </div>\n\n      <div class=\"space-y-6\" data-kid=\"45\">\n         <div class=\"space-y-2\" data-kid=\"46\">\n            <label class=\"text-[10px] font-bold uppercase tracking-widest text-zinc-500\" data-kid=\"47\">Phone Number</label>\n            <div class=\"bg-black/40 border border-white/10 rounded-xl p-4 flex items-center gap-4\" data-kid=\"48\">\n              <span class=\"text-zinc-500 font-bold text-sm border-r border-white/10 pr-4\" data-kid=\"49\">+256</span>\n              <input type=\"tel\" placeholder=\"700 000 000\" class=\"bg-transparent border-none outline-none text-sm w-full text-white\" data-kid=\"50\">\n            </div>\n         </div>\n         \n         <button class=\"w-full bg-[#C0FF00] text-black py-4 rounded-2xl font-bold text-sm hover:scale-[1.02] transition-transform\" data-kid=\"51\">Pay $120.00 Now</button>\n         \n         <p class=\"text-[10px] text-center text-zinc-600 leading-relaxed\" data-kid=\"52\">\n           You will receive a prompt on your phone to authorize the transaction.\n         </p>\n      </div>\n    </div>\n  </div>\n</div>",
