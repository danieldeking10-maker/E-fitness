    "var_af6472ca67fa": {
      "type": "variant",
      "label": "E-fitness - Sticky Flow Variant",
      "parentId": "var_ebca31178f2f",
      "themeId": null,
      "rect": {
        "x": 18480,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n  \n  .sticky-col {\n    position: sticky;\n    top: 5rem;\n    height: calc(100vh - 10rem);\n  }\n\n  .feature-card {\n    background: #1A1D24;\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    margin-bottom: 20vh;\n  }\n\n  .accent-line {\n    width: 3px;\n    background: #C0FF00;\n  }\n</style>\n\n<div id=\"content\" data-kid=\"1\">\n  <header class=\"p-8 flex justify-between items-center\" data-kid=\"2\">\n    <div class=\"text-2xl font-heading font-bold\" data-kid=\"3\">E-fitness</div>\n    <div class=\"text-zinc-500 text-sm font-medium\" data-kid=\"4\">Scroll to explore</div>\n  </header>\n\n  <section class=\"max-w-7xl mx-auto px-8 py-20 flex gap-20\" data-kid=\"5\">\n    \n    <div class=\"w-1/2 sticky-col flex flex-col justify-center\" data-kid=\"6\">\n      <span class=\"text-[#C0FF00] font-bold tracking-widest text-xs uppercase mb-4\" data-kid=\"7\">Core Technology</span>\n      <h2 class=\"font-heading text-6xl leading-[1.1] mb-8\" data-kid=\"8\">Intelligence <br data-kid=\"9\">for your <br data-kid=\"10\"><span class=\"text-zinc-500 italic\" data-kid=\"11\">Physique.</span></h2>\n      <p class=\"text-zinc-400 text-lg max-w-md\" data-kid=\"12\">\n        E-fitness uses proprietary AI models to build, track, and optimize your entire wellness ecosystem.\n      </p>\n    </div>\n\n    \n    <div class=\"w-1/2 py-[30vh]\" data-kid=\"13\">\n      <div class=\"feature-card p-12 rounded-[2.5rem] reveal\" data-kid=\"14\">\n        <div class=\"text-[#C0FF00] text-4xl mb-6\" data-kid=\"15\">01</div>\n        <h3 class=\"font-heading text-3xl mb-4\" data-kid=\"16\">Wellness Assessment</h3>\n        <p class=\"text-zinc-400 leading-relaxed\" data-kid=\"17\">A multi-dimensional analysis of your current metabolic state, sleep quality, and physical constraints.</p>\n      </div>\n\n      <div class=\"feature-card p-12 rounded-[2.5rem] reveal\" data-kid=\"18\">\n        <div class=\"text-[#C0FF00] text-4xl mb-6\" data-kid=\"19\">02</div>\n        <h3 class=\"font-heading text-3xl mb-4\" data-kid=\"20\">Workout Generator</h3>\n        <p class=\"text-zinc-400 leading-relaxed\" data-kid=\"21\">Dynamic training plans that adapt in real-time to your recovery score and local equipment availability.</p>\n      </div>\n\n      <div class=\"feature-card p-12 rounded-[2.5rem] reveal\" data-kid=\"22\">\n        <div class=\"text-[#C0FF00] text-4xl mb-6\" data-kid=\"23\">03</div>\n        <h3 class=\"font-heading text-3xl mb-4\" data-kid=\"24\">AI Companion</h3>\n        <p class=\"text-zinc-400 leading-relaxed\" data-kid=\"25\">A 24/7 fitness intelligence at your fingertips. Ask about nutrition, form, or recovery protocols.</p>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"26\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"27\"></script>\n<script type=\"module\" data-kid=\"28\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis({ autoRaf: true });\n  gsap.registerPlugin(ScrollTrigger);\n\n  document.querySelectorAll('.reveal').forEach(el => {\n    gsap.from(el, {\n      opacity: 0,\n      y: 100,\n      duration: 1,\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 90%\",\n        end: \"top 40%\",\n        scrub: true\n      }\n    });\n  });\n</script>",
