      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n  .text-neon { color: #C0FF00; }\n  .bg-neon { background-color: #C0FF00; }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .step-dot.active { background-color: #C0FF00; box-shadow: 0 0 10px rgba(192, 255, 0, 0.5); }\n</style>\n\n<div class=\"min-h-screen p-8 flex flex-col items-center justify-center relative overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"absolute top-0 right-0 w-96 h-96 bg-[#C0FF00]/5 blur-[120px] rounded-full\" data-kid=\"2\"></div>\n  \n  <div class=\"w-full max-w-2xl relative z-10\" data-kid=\"3\">\n    <header class=\"text-center mb-12\" data-kid=\"4\">\n      <h1 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"5\">Wellness <span class=\"text-neon\" data-kid=\"6\">Assessment</span></h1>\n      <p class=\"text-zinc-500\" data-kid=\"7\">Step 2 of 4: Physical Constraints & Recovery</p>\n    </header>\n\n    <div class=\"glass rounded-[2.5rem] p-12 shadow-2xl\" data-kid=\"8\">\n      <div class=\"space-y-8\" data-kid=\"9\">\n        <div data-kid=\"10\">\n          <label class=\"block text-sm font-bold uppercase tracking-widest text-zinc-500 mb-4\" data-kid=\"11\">Current Constraints</label>\n          <div class=\"grid grid-cols-2 gap-4\" data-kid=\"12\">\n            <button class=\"p-4 rounded-2xl border border-white/5 bg-black/20 text-left hover:border-neon/50 transition-all flex items-center gap-3\" data-kid=\"13\">\n              <i class=\"ti ti-stretching text-neon\" data-kid=\"14\"></i>\n              <span class=\"text-sm font-medium\" data-kid=\"15\">Knee Sensitivity</span>\n            </button>\n            <button class=\"p-4 rounded-2xl border border-neon/50 bg-neon/5 text-left transition-all flex items-center gap-3\" data-kid=\"16\">\n              <i class=\"ti ti-bone text-neon\" data-kid=\"17\"></i>\n              <span class=\"text-sm font-medium\" data-kid=\"18\">Lower Back Pain</span>\n            </button>\n            <button class=\"p-4 rounded-2xl border border-white/5 bg-black/20 text-left hover:border-neon/50 transition-all flex items-center gap-3\" data-kid=\"19\">\n              <i class=\"ti ti-disabled text-zinc-500\" data-kid=\"20\"></i>\n              <span class=\"text-sm font-medium\" data-kid=\"21\">Limited Mobility</span>\n            </button>\n            <button class=\"p-4 rounded-2xl border border-white/5 bg-black/20 text-left hover:border-neon/50 transition-all flex items-center gap-3\" data-kid=\"22\">\n              <i class=\"ti ti-plus text-zinc-500\" data-kid=\"23\"></i>\n              <span class=\"text-sm font-medium\" data-kid=\"24\">Add Custom</span>\n            </button>\n          </div>\n        </div>\n\n        <div data-kid=\"25\">\n          <label class=\"block text-sm font-bold uppercase tracking-widest text-zinc-500 mb-4\" data-kid=\"26\">Sleep Quality (Last 7 Days)</label>\n          <input type=\"range\" class=\"w-full h-1.5 bg-zinc-800 rounded-full appearance-none accent-neon\" data-kid=\"27\">\n          <div class=\"flex justify-between mt-2 text-[10px] font-bold text-zinc-600 uppercase\" data-kid=\"28\">\n            <span data-kid=\"29\">Restless</span>\n            <span data-kid=\"30\">Deep Recovery</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"mt-12 flex items-center justify-between\" data-kid=\"31\">\n        <div class=\"flex gap-2\" data-kid=\"32\">\n          <div class=\"h-1.5 w-8 rounded-full bg-zinc-800\" data-kid=\"33\"></div>\n          <div class=\"h-1.5 w-8 rounded-full bg-neon shadow-[0_0_10px_rgba(192,255,0,0.4)]\" data-kid=\"34\"></div>\n          <div class=\"h-1.5 w-8 rounded-full bg-zinc-800\" data-kid=\"35\"></div>\n          <div class=\"h-1.5 w-8 rounded-full bg-zinc-800\" data-kid=\"36\"></div>\n        </div>\n        <button class=\"bg-neon text-black px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform\" data-kid=\"37\">Continue</button>\n      </div>\n    </div>\n  </div>\n</div>",
      "comments": [],
