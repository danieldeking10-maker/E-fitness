      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-bg: #0A0A0A;\n    --color-surface: #1A1D24;\n    --color-accent: #C0FF00;\n    --font-heading: 'Sora', sans-serif;\n    --font-body: 'DM Sans', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--color-bg);\n    color: #FFFFFF;\n    font-family: var(--font-body);\n    overflow-x: clip;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  .text-neon { color: var(--color-accent); }\n  .bg-neon { background-color: var(--color-accent); }\n  .border-neon { border-color: var(--color-accent); }\n\n  .bento-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    grid-template-rows: repeat(3, minmax(180px, auto));\n    gap: 1.5rem;\n  }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .carousel-container {\n    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);\n  }\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    <nav class=\"fixed top-0 z-50 w-full px-8 py-6\" data-kid=\"3\">\n      <div class=\"mx-auto flex max-w-7xl items-center justify-between glass rounded-full px-8 py-4\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2\" data-kid=\"5\">\n          <div class=\"h-8 w-8 bg-neon rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"6\">E</div>\n          <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"7\">E-fitness</span>\n        </div>\n        <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400\" data-kid=\"8\">\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"9\">Assessment</a>\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"10\">Generator</a>\n          <a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"11\">Companion</a>\n        </div>\n        <a href=\"/login\" class=\"bg-neon text-black px-6 py-2.5 rounded-full text-sm font-bold hover:scale-105 transition-transform\" data-kid=\"12\">Get Started</a>\n      </div>\n    </nav>\n\n    <section class=\"relative pt-32 pb-20 px-8\" data-kid=\"13\">\n      <div class=\"mx-auto max-w-7xl\" data-kid=\"14\">\n        <div class=\"bento-grid\" data-kid=\"15\">\n          <div class=\"col-span-4 lg:col-span-3 row-span-2 glass rounded-[2.5rem] p-12 flex flex-col justify-end relative overflow-hidden\" data-kid=\"16\">\n            <div class=\"absolute top-0 right-0 w-96 h-96 bg-neon/10 blur-[120px] rounded-full\" data-kid=\"17\"></div>\n            <h1 class=\"font-heading text-5xl md:text-7xl font-bold leading-[1.1] mb-6 reveal-y\" data-kid=\"18\">\n              Elite Fitness <br data-kid=\"19\"><span class=\"text-neon\" data-kid=\"20\">Powered by AI.</span>\n            </h1>\n            <p class=\"text-lg text-zinc-400 max-w-xl mb-8 reveal-y\" data-kid=\"21\">\n              E-fitness merges cutting-edge neural analysis with elite coaching to transform your physical potential.\n            </p>\n            <div class=\"flex gap-4 reveal-y\" data-kid=\"22\">\n              <a href=\"/ai/wellness-assessment\" class=\"bg-neon text-black px-8 py-4 rounded-full font-bold hover:shadow-[0_0_20px_rgba(192,255,0,0.4)] transition-all\" data-kid=\"23\">Start Assessment</a>\n              <a href=\"/ai/wellness-companion\" class=\"glass px-8 py-4 rounded-full font-bold hover:bg-white/5 transition-all\" data-kid=\"24\">Chat with AI</a>\n            </div>\n          </div>\n\n          <div class=\"col-span-2 lg:col-span-1 glass rounded-[2.5rem] p-8 flex flex-col justify-between reveal-x\" data-kid=\"25\">\n            <div class=\"flex justify-between items-start\" data-kid=\"26\">\n              <i class=\"ti ti-activity text-neon text-3xl\" data-kid=\"27\"></i>\n              <span class=\"text-neon text-xs font-bold px-2 py-1 border border-neon/30 rounded-full animate-pulse\" data-kid=\"28\">LIVE</span>\n            </div>\n            <div data-kid=\"29\">\n              <div class=\"text-3xl font-heading font-bold mb-1\" data-kid=\"30\">142<span class=\"text-lg font-normal text-zinc-500\" data-kid=\"31\">bpm</span></div>\n              <div class=\"text-sm text-zinc-400\" data-kid=\"32\">Heart Rate Stability</div>\n            </div>\n          </div>\n\n          <div class=\"col-span-2 lg:col-span-1 glass rounded-[2.5rem] overflow-hidden relative reveal-x\" data-kid=\"33\">\n            <video src=\"https://videos.pexels.com/video-files/4804847/4804847-uhd_2560_1440_25fps.mp4\" poster=\"https://images.pexels.com/videos/4804847/pexels-photo-4804847.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"34\"></video>\n            <div class=\"absolute bottom-6 left-6 text-sm font-bold uppercase tracking-widest\" data-kid=\"35\">Training Peak</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-24 px-8 bg-zinc-950\" data-kid=\"36\">\n      <div class=\"mx-auto max-w-7xl\" data-kid=\"37\">\n        <div class=\"text-center mb-16\" data-kid=\"38\">\n          <h2 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"39\">Simple Plans.</h2>\n          <p class=\"text-zinc-500\" data-kid=\"40\">Pay securely via <span class=\"text-neon\" data-kid=\"41\">Mobile Money</span></p>\n        </div>\n        <div class=\"flex flex-col md:flex-row gap-8 items-end\" data-kid=\"42\">\n          <div class=\"flex-1 glass p-10 rounded-[2rem] reveal-up\" data-kid=\"43\">\n            <div class=\"text-2xl font-bold mb-4\" data-kid=\"44\">Starter</div>\n            <div class=\"text-4xl font-bold mb-8\" data-kid=\"45\">$0<span class=\"text-sm font-normal text-zinc-500\" data-kid=\"46\">/mo</span></div>\n            <button class=\"w-full border border-white/10 py-4 rounded-full font-bold\" data-kid=\"47\">Current Plan</button>\n          </div>\n          <div class=\"flex-1 glass border-neon/50 bg-neon/5 p-10 rounded-[2.5rem] reveal-up relative\" data-kid=\"48\">\n            <div class=\"absolute -top-4 left-1/2 -translate-x-1/2 bg-neon text-black px-4 py-1 rounded-full text-[10px] font-bold\" data-kid=\"49\">RECOMENDED</div>\n            <div class=\"text-2xl font-bold mb-4\" data-kid=\"50\">Pro AI</div>\n            <div class=\"text-4xl font-bold mb-8\" data-kid=\"51\">$12<span class=\"text-sm font-normal text-zinc-500\" data-kid=\"52\">/mo</span></div>\n            <button class=\"w-full bg-neon text-black py-4 rounded-full font-bold\" data-kid=\"53\">Unlock Pro</button>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"54\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"55\"></script>\n<script type=\"module\" data-kid=\"56\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis({ autoRaf: true });\n  gsap.registerPlugin(ScrollTrigger);\n  lenis.on('scroll', ScrollTrigger.update);\n\n  gsap.from('.reveal-y', { y: 30, opacity: 0, duration: 1, stagger: 0.2, ease: \"power3.out\" });\n  gsap.from('.reveal-x', { x: 30, opacity: 0, duration: 1, stagger: 0.2, ease: \"power3.out\", delay: 0.5 });\n</script>",
      "comments": [],
      "created": "2026-07-04T17:35:15.208629+00:00",
      "modified": "2026-07-04T17:35:28.488932+00:00",
