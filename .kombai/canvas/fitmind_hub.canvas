      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@700;800&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background-color: #0A0A0A;\n    color: #FFFFFF;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading { font-family: 'Sora', sans-serif; }\n\n  .glass {\n    background: rgba(26, 29, 36, 0.6);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .input-field {\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    transition: all 0.3s ease;\n  }\n\n  .input-field:focus-within {\n    border-color: #C0FF00;\n    background: rgba(192, 255, 0, 0.02);\n  }\n</style>\n\n<div class=\"flex h-screen overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"hidden lg:flex w-1/2 relative flex-col justify-between p-20 overflow-hidden\" data-kid=\"2\">\n    <div class=\"absolute inset-0\" data-kid=\"3\">\n      <img src=\"https://images.unsplash.com/photo-1607962837359-5e7e89f86776?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-50 grayscale\" data-kid=\"4\">\n      <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent\" data-kid=\"5\"></div>\n    </div>\n    \n    <div class=\"relative z-10\" data-kid=\"6\">\n      <div class=\"flex items-center gap-2\" data-kid=\"7\">\n        <div class=\"h-8 w-8 bg-[#C0FF00] rounded-lg flex items-center justify-center text-black font-bold\" data-kid=\"8\">E</div>\n        <span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"9\">E-fitness</span>\n      </div>\n    </div>\n\n    <div class=\"relative z-10 max-w-md\" data-kid=\"10\">\n      <h2 class=\"font-heading text-5xl font-bold leading-tight mb-6\" data-kid=\"11\">Unlock Your <br data-kid=\"12\"><span class=\"text-[#C0FF00]\" data-kid=\"13\">Intelligence.</span></h2>\n      <p class=\"text-zinc-400 text-lg\" data-kid=\"14\">Join the elite community of data-driven athletes. Your AI coach is waiting.</p>\n    </div>\n\n    <div class=\"relative z-10 flex gap-4 opacity-40\" data-kid=\"15\">\n      <div class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"16\">EST. 2026</div>\n      <div class=\"h-px flex-1 bg-white/20 mt-1.5\" data-kid=\"17\"></div>\n      <div class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"18\">NEURAL FITNESS</div>\n    </div>\n  </div>\n\n  \n  <div class=\"flex-1 flex flex-col items-center justify-center p-8 lg:p-20 relative\" data-kid=\"19\">\n     \n     <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#C0FF00]/5 blur-[120px] rounded-full\" data-kid=\"20\"></div>\n\n     <div class=\"w-full max-w-md relative z-10\" data-kid=\"21\">\n        <div class=\"mb-10\" data-kid=\"22\">\n          <h1 class=\"font-heading text-3xl font-bold mb-2\" data-kid=\"23\">Welcome Back</h1>\n          <p class=\"text-zinc-500 text-sm\" data-kid=\"24\">Don't have an account? <a href=\"#\" class=\"text-[#C0FF00] font-bold\" data-kid=\"25\">Register Now</a></p>\n        </div>\n\n        <div class=\"space-y-6\" data-kid=\"26\">\n          <div class=\"space-y-2\" data-kid=\"27\">\n            <label class=\"text-[10px] font-bold uppercase tracking-widest text-zinc-500\" data-kid=\"28\">Email Address</label>\n            <div class=\"input-field rounded-2xl p-4 flex items-center gap-4\" data-kid=\"29\">\n              <i class=\"ti ti-mail text-zinc-500\" data-kid=\"30\"></i>\n              <input type=\"email\" placeholder=\"name@example.com\" class=\"bg-transparent border-none outline-none text-sm w-full text-white\" data-kid=\"31\">\n            </div>\n          </div>\n\n          <div class=\"space-y-2\" data-kid=\"32\">\n            <label class=\"text-[10px] font-bold uppercase tracking-widest text-zinc-500\" data-kid=\"33\">Password</label>\n            <div class=\"input-field rounded-2xl p-4 flex items-center gap-4\" data-kid=\"34\">\n              <i class=\"ti ti-lock text-zinc-500\" data-kid=\"35\"></i>\n              <input type=\"password\" placeholder=\"••••••••\" class=\"bg-transparent border-none outline-none text-sm w-full text-white\" data-kid=\"36\">\n              <i class=\"ti ti-eye text-zinc-500 cursor-pointer hover:text-white\" data-kid=\"37\"></i>\n            </div>\n          </div>\n\n          <div class=\"flex items-center justify-between\" data-kid=\"38\">\n            <label class=\"flex items-center gap-2 cursor-pointer group\" data-kid=\"39\">\n              <div class=\"h-4 w-4 rounded border border-white/10 bg-white/5 group-hover:border-[#C0FF00]/50\" data-kid=\"40\"></div>\n              <span class=\"text-xs text-zinc-500 group-hover:text-zinc-400\" data-kid=\"41\">Remember me</span>\n            </label>\n            <a href=\"#\" class=\"text-xs text-zinc-500 hover:text-[#C0FF00]\" data-kid=\"42\">Forgot Password?</a>\n          </div>\n\n          <button class=\"w-full bg-[#C0FF00] text-black py-4 rounded-2xl font-bold text-sm hover:scale-[1.02] transition-transform shadow-xl shadow-[#C0FF00]/10\" data-kid=\"43\">Continue to Dashboard</button>\n\n          <div class=\"flex items-center gap-4 py-4\" data-kid=\"44\">\n            <div class=\"h-px flex-1 bg-white/5\" data-kid=\"45\"></div>\n            <span class=\"text-[10px] font-bold text-zinc-600 uppercase tracking-widest\" data-kid=\"46\">OR</span>\n            <div class=\"h-px flex-1 bg-white/5\" data-kid=\"47\"></div>\n          </div>\n\n          <div class=\"grid grid-cols-2 gap-4\" data-kid=\"48\">\n             <button class=\"glass py-3 rounded-2xl flex items-center justify-center gap-2 text-xs font-bold hover:bg-white/5 transition-all\" data-kid=\"49\">\n               <i class=\"ti ti-brand-google\" data-kid=\"50\"></i> Google\n             </button>\n             <button class=\"glass py-3 rounded-2xl flex items-center justify-center gap-2 text-xs font-bold hover:bg-white/5 transition-all\" data-kid=\"51\">\n               <i class=\"ti ti-brand-apple\" data-kid=\"52\"></i> Apple\n             </button>\n          </div>\n        </div>\n\n        <footer class=\"mt-12 text-center\" data-kid=\"53\">\n          <p class=\"text-[10px] text-zinc-600 leading-relaxed uppercase tracking-tighter\" data-kid=\"54\">\n            By continuing, you agree to our <br data-kid=\"55\">\n            <span class=\"underline\" data-kid=\"56\">Terms of Service</span> and <span class=\"underline\" data-kid=\"57\">Privacy Policy</span>.\n          </p>\n        </footer>\n     </div>\n  </div>\n</div>",
