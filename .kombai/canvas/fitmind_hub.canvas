"133\">\n          <div data-kid=\"134\">\n            <div class=\"w-12 h-12 bg-white/5 rounded-2xl flex items-center justify-center mb-6\" data-kid=\"135\">\n              <i class=\"ti ti-building-community text-2xl text-zinc-400\" data-kid=\"136\"></i>\n            </div>\n            <h3 class=\"text-2xl font-bold mb-2\" data-kid=\"137\">Community</h3>\n            <div class=\"text-4xl font-black mb-6\" data-kid=\"138\">CUSTOM</div>\n            <ul class=\"space-y-4 text-zinc-400 text-sm\" data-kid=\"139\">\n              <li class=\"flex items-center gap-2\" data-kid=\"140\"><i class=\"ti ti-check text-neon\" data-kid=\"141\"></i> Bulk Licensing</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"142\"><i class=\"ti ti-check text-neon\" data-kid=\"143\"></i> Custom Branded App</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"144\"><i class=\"ti ti-check text-neon\" data-kid=\"145\"></i> Dedicated Success Manager</li>\n              <li class=\"flex items-center gap-2\" data-kid=\"146\"><i class=\"ti ti-check text-neon\" data-kid=\"147\"></i> API Access</li>\n            </ul>\n          </div>\n          <button class=\"w-full py-4 rounded-2xl border border-white/10 hover:bg-white/5 transition-colors font-bold mt-8\" data-kid=\"148\">Contact Sales</button>\n        </div>\n      </div>\n      \n      \n      <div class=\"mt-16 flex flex-wrap justify-center items-center gap-8 opacity-40 grayscale reveal\" data-kid=\"149\">\n        <div class=\"flex items-center gap-2\" data-kid=\"150\"><i class=\"ti ti-device-mobile-dollar text-2xl\" data-kid=\"151\"></i> <span class=\"text-sm font-bold\" data-kid=\"152\">M-PESA</span></div>\n        <div class=\"flex items-center gap-2\" data-kid=\"153\"><i class=\"ti ti-device-mobile-dollar text-2xl\" data-kid=\"154\"></i> <span class=\"text-sm font-bold\" data-kid=\"155\">MTN MOMO</span></div>\n        <div class=\"flex items-center gap-2\" data-kid=\"156\"><i class=\"ti ti-device-mobile-dollar text-2xl\" data-kid=\"157\"></i> <span class=\"text-sm font-bold\" data-kid=\"158\">AIRTEL MONEY</span></div>\n        <div class=\"flex items-center gap-2\" data-kid=\"159\"><i class=\"ti ti-credit-card text-2xl\" data-kid=\"160\"></i> <span class=\"text-sm font-bold\" data-kid=\"161\">VISA / MASTER</span></div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-20 bg-ink-black border-t border-white/5 text-zinc-500\" data-kid=\"162\">\n      <div class=\"container mx-auto px-6 grid md:grid-cols-4 gap-12\" data-kid=\"163\">\n        <div class=\"col-span-2\" data-kid=\"164\">\n          <h2 class=\"text-2xl font-bold text-white mb-6\" data-kid=\"165\">FitMind <span class=\"text-neon\" data-kid=\"166\">Hub</span></h2>\n          <p class=\"max-w-xs text-sm leading-relaxed\" data-kid=\"167\">The future of community wellness, powered by next-generation artificial intelligence and elite professional coaching.</p>\n        </div>\n        <div data-kid=\"168\">\n          <h4 class=\"text-white font-bold mb-6 text-sm uppercase tracking-widest\" data-kid=\"169\">Platform</h4>\n          <ul class=\"space-y-4 text-sm\" data-kid=\"170\">\n            <li data-kid=\"171\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"172\">AI Assessment</a></li>\n            <li data-kid=\"173\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"174\">Workout Gen</a></li>\n            <li data-kid=\"175\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"176\">Live Sessions</a></li>\n            <li data-kid=\"177\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"178\">Mobile Payments</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"179\">\n          <h4 class=\"text-white font-bold mb-6 text-sm uppercase tracking-widest\" data-kid=\"180\">Support</h4>\n          <ul class=\"space-y-4 text-sm\" data-kid=\"181\">\n            <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"183\">Help Center</a></li>\n            <li data-kid=\"184\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"185\">Privacy Policy</a></li>\n            <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"187\">Terms of Service</a></li>\n            <li data-kid=\"188\"><a href=\"#\" class=\"hover:text-neon transition-colors\" data-kid=\"189\">Contact Us</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"container mx-auto px-6 mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs\" data-kid=\"190\">\n        <p data-kid=\"191\">&copy; 2026 FitMind Hub AI. All rights reserved.</p>\n        <div class=\"flex gap-6\" data-kid=\"192\">\n          <a href=\"#\" class=\"hover:text-white\" data-kid=\"193\"><i class=\"ti ti-brand-instagram text-xl\" data-kid=\"194\"></i></a>\n          <a href=\"#\" class=\"hover:text-white\" data-kid=\"195\"><i class=\"ti ti-brand-x text-xl\" data-kid=\"196\"></i></a>\n          <a href=\"#\" class=\"hover:text-white\" data-kid=\"197\"><i class=\"ti ti-brand-youtube text-xl\" data-kid=\"198\"></i></a>\n        </div>\n      </div>\n    </footer>\n\n  </div>\n</div>\n\n\n<div id=\"chat-widget\" class=\"fixed bottom-8 right-8 z-50\" data-kid=\"199\">\n  <div id=\"chat-panel\" class=\"hidden glass w-[350px] rounded-3xl overflow-hidden shadow-2xl border-neon/20 mb-4 animate-in fade-in slide-in-from-bottom-4 duration-300\" data-kid=\"200\">\n    <div class=\"bg-neon/10 px-6 py-4 flex items-center justify-between border-b border-neon/20\" data-kid=\"201\">\n      <div class=\"flex items-center gap-3\" data-kid=\"202\">\n        <div class=\"w-8 h-8 rounded-full bg-neon flex items-center justify-center\" data-kid=\"203\">\n          <i class=\"ti ti-message-chatbot text-ink-black text-lg\" data-kid=\"204\"></i>\n        </div>\n        <div data-kid=\"205\">\n          <h4 class=\"text-sm font-bold text-white\" data-kid=\"206\">AI Companion</h4>\n          <p class=\"text-[10px] text-neon uppercase font-bold tracking-tighter\" data-kid=\"207\">Online & Ready</p>\n        </div>\n      </div>\n      <button id=\"closeChat\" class=\"text-zinc-500 hover:text-white\" data-kid=\"208\"><i class=\"ti ti-x\" data-kid=\"209\"></i></button>\n    </div>\n    <div class=\"h-[400px] p-6 overflow-y-auto flex flex-col no-scrollbar\" id=\"chat-messages\" data-kid=\"210\">\n      <div class=\"chat-bubble ai\" data-kid=\"211\">Hello! I'm your Wellness Companion. Ready to crush your goals today?</div>\n      <div class=\"chat-bubble user\" data-kid=\"212\">I'm feeling a bit sore from yesterday's HIIT. Any advice?</div>\n      <div class=\"chat-bubble ai\" data-kid=\"213\">Focus on active recovery today. I've scheduled a 15-minute mobility flow for you. Want to start it now?</div>\n    </div>\n    <div class=\"p-4 bg-white/5 border-t border-white/10 flex gap-2\" data-kid=\"214\">\n      <input type=\"text\" placeholder=\"Type a message...\" class=\"flex-1 bg-white/5 border border-white/10 rounded-full px-4 py-2 text-sm outline-none focus:border-neon transition-colors\" data-kid=\"215\">\n      <button class=\"w-10 h-10 rounded-full bg-neon text-ink-black flex items-center justify-center shrink-0\" data-kid=\"216\"><i class=\"ti ti-send\" data-kid=\"217\"></i></button>\n    </div>\n  </div>\n  <button id=\"toggleChat\" class=\"w-16 h-16 rounded-full bg-neon text-ink-black shadow-[0_0_30px_rgba(192,255,0,0.5)] flex items-center justify-center transition-transform hover:scale-110 active:scale-90\" data-kid=\"218\">\n    <i class=\"ti ti-message-chatbot text-3xl\" data-kid=\"219\"></i>\n  </button>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"220\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"221\"></script>\n<script type=\"module\" data-kid=\"222\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Smooth Scroll\n  const lenis = new Lenis({\n    autoRaf: true,\n  });\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Sync GSAP with Lenis\n  lenis.on('scroll', ScrollTrigger.update);\n  gsap.ticker.add((time) => {\n    lenis.raf(time * 1000);\n  });\n  gsap.ticker.lagSmoothing(0);\n\n  // Hero Video Pinning\n  ScrollTrigger.create({\n    trigger: \"#hero\",\n    start: \"top top\",\n    end: \"bottom top\",\n    pin: true,\n    pinSpacing: false\n  });\n\n  // Staggered entrance animations\n  gsap.utils.toArray(\".reveal\").forEach(el => {\n    gsap.from(el, {\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 85%\",\n        toggleActions: \"play none none reverse\"\n      },\n      y: 40,\n      autoAlpha: 0,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Carousel Navigation\n  const carousel = document.getElementById('carousel');\n  document.getElementById('nextBtn').addEventListener('click', () => {\n    carousel.scrollBy({ left: 450, behavior: 'smooth' });\n  });\n  document.getElementById('prevBtn').addEventListener('click', () => {\n    carousel.scrollBy({ left: -450, behavior: 'smooth' });\n  });\n\n  // Motion Micro-interactions\n  document.querySelectorAll('.ramp-card').forEach(el => {\n    el.addEventListener('mouseenter', () => animate(el, { scale: 1.02, y: -8 }, { duration: 0.3 }));\n    el.addEventListener('mouseleave', () => animate(el, { scale: 1, y: 0 }, { duration: 0.3 }));\n  });\n\n  // Chat Widget Simulation\n  const chatPanel = document.getElementById('chat-panel');\n  const toggleChat = document.getElementById('toggleChat');\n  const closeChat = document.getElementById('closeChat');\n\n  toggleChat.addEventListener('click', () => {\n    chatPanel.classList.toggle('hidden');\n    if (!chatPanel.classList.contains('hidden')) {\n      animate(chatPanel, { opacity: [0, 1], y: [20, 0] }, { duration: 0.4 });\n    }\n  });\n\n  closeChat.addEventListener('click', () => {\n    chatPanel.classList.add('hidden');\n  });\n\n</script>",
